---
import Glyph from '@components/ui/Glyph.astro';
import { compares } from '@data/compare';

/**
 * "Without Hyper 0X / with Hyper 0X": two lanes of an architecture, each a
 * row of nodes that a request travels through. Without, the request passes
 * every node, turns red where things go wrong and ends badly. With, Hyper 0X
 * and Pavii parts (guard nodes) stop it, or carry it to a good end, and the
 * last node lights as the record. The numbered steps under each lane light in
 * turn. Rows turn into columns in narrow boxes; motion pauses offscreen and
 * holds the final state under reduced motion.
 */
interface Props {
  slug: string;
  class?: string;
}

const { slug, class: className } = Astro.props;
const compare = compares[slug];
const lanes = compare
  ? ([
      { kind: 'without', title: 'Without Hyper 0X', lane: compare.without },
      { kind: 'with', title: 'With Hyper 0X', lane: compare.with },
    ] as const)
  : [];
---

{compare && (
  <section class:list={['cmp', className]} aria-labelledby={`cmp-${slug}`} data-compare>
    <p class="font-mono text-xs tracking-wide text-muted uppercase">How it works</p>
    <h2 id={`cmp-${slug}`} class="mt-2 text-2xl font-semibold text-balance text-ink sm:text-3xl">{compare.title}</h2>
    <div class="mt-6 grid grid-cols-1 gap-4 2xl:grid-cols-2">
      {lanes.map(({ kind, title, lane }) => (
        <div class:list={['cmp-lane rounded-[1.6rem] p-4 sm:p-6', kind === 'with' ? 'cmp-with glass-tint' : 'cmp-without glass-card']} data-lane={kind} data-break={lane.breakAt ?? -1} data-stop={lane.stopAt ?? -1}>
          <div class="flex flex-wrap items-center justify-between gap-3">
            <p class="cmp-badge">
              {kind === 'with' ? <Glyph ui="safe-shield" class="cmp-badge-icon size-[1.1rem]" /> : <Glyph ui="warning" class="cmp-badge-icon size-[1.1rem]" />}
              {title}
            </p>
            <p class="cmp-outcome" data-outcome>
              {kind === 'with' ? <Glyph ui="check-circle" class="size-4" /> : <Glyph ui="close-circle" class="size-4" />}
              {lane.outcome}
            </p>
          </div>
          <div class="cmp-track mt-5" data-track>
            <span class="cmp-packet" data-packet aria-hidden="true"><Glyph ui="send-plane" class="size-3.5" /><span>{lane.packet}</span></span>
            <ol class="cmp-nodes">
              {lane.nodes.map(node => (
                <li class:list={['cmp-node', node.guard && 'is-guard']} data-node>
                  <span class="cmp-tile">
                    {node.icon.startsWith('ph:') ? <Glyph icon={node.icon.slice(3)} class="cmp-icon" /> : <Glyph ui={node.icon} class="cmp-icon" />}
                    {node.guard && <span class="cmp-guard-dot" aria-hidden="true"></span>}
                  </span>
                  <span class="cmp-label">{node.label}</span>
                  {node.sub && <span class="cmp-sub">{node.sub}</span>}
                </li>
              ))}
            </ol>
          </div>
          <ol class="cmp-steps mt-6 grid gap-2">
            {lane.steps.map((step, i) => (
              <li class="cmp-step" data-step><span class="cmp-num">{i + 1}</span><span>{step}</span></li>
            ))}
          </ol>
        </div>
      ))}
    </div>
  </section>
)}

<style>
  .cmp-without :global(.cmp-badge-icon) { color: #dc2626; }
  .cmp-with :global(.cmp-badge-icon) { color: #059669; }
  .cmp-badge { display: inline-flex; align-items: center; gap: 0.5rem; border-radius: 999px; padding: 0.35rem 0.85rem 0.35rem 0.5rem; font-size: 0.85rem; font-weight: 650; background: var(--card); color: var(--ink); box-shadow: 0 0 0 1px var(--line); }
  .cmp-outcome { display: inline-flex; align-items: center; gap: 0.4rem; border-radius: 999px; padding: 0.3rem 0.75rem; font-size: 0.78rem; font-weight: 650; opacity: 0; transform: translateY(4px); transition: opacity 300ms ease, transform 300ms ease; }
  .cmp-without .cmp-outcome { color: #b91c1c; background: #fee2e2; }
  .cmp-with .cmp-outcome { color: #047857; background: #d1fae5; }
  :global(.dark) .cmp-without .cmp-outcome { color: #fecaca; background: rgb(248 113 113 / 0.16); }
  :global(.dark) .cmp-with .cmp-outcome { color: #a7f3d0; background: rgb(52 211 153 / 0.14); }
  .cmp-lane[data-ended] .cmp-outcome { opacity: 1; transform: none; }

  .cmp-track { position: relative; container-type: inline-size; }
  .cmp-nodes { position: relative; display: grid; grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); gap: 0.5rem; }
  .cmp-nodes::before { content: ''; position: absolute; left: 10%; right: 10%; top: 1.75rem; height: 2px; background: repeating-linear-gradient(90deg, color-mix(in oklab, var(--muted) 45%, transparent) 0 6px, transparent 6px 11px); }
  .cmp-node { position: relative; display: flex; flex-direction: column; align-items: center; text-align: center; }
  /* Clean schematic tiles: white with a thin border and a bold dark icon;
     Hyper 0X and Pavii parts (guards) get a violet ring and dot; icons stay black. */
  .cmp-tile { position: relative; display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 1.1rem; background: var(--card); color: #0b0b0c; box-shadow: 0 0 0 1px #e4e4e7, 0 8px 18px -14px rgb(0 0 0 / 0.35); transition: box-shadow 250ms ease, transform 250ms ease, background-color 250ms ease, color 250ms ease; }
  :global(.dark) .cmp-tile { color: #e6e6e6; box-shadow: 0 0 0 1px #2c2c2c; }
  .is-guard .cmp-tile { background: var(--card); color: #0b0b0c; box-shadow: 0 0 0 1.5px var(--accent-300), 0 10px 22px -14px color-mix(in oklab, var(--accent-600) 50%, transparent); }
  :global(.dark) .is-guard .cmp-tile { background: #161616; color: #f4f4f5; box-shadow: 0 0 0 1.5px color-mix(in oklab, var(--accent-500) 45%, transparent); }
  .cmp-guard-dot { position: absolute; right: -0.25rem; top: -0.25rem; width: 0.75rem; height: 0.75rem; border-radius: 999px; background: var(--accent-600); box-shadow: 0 0 0 2px var(--card); }
  :global(.dark) .cmp-guard-dot { background: var(--accent-500); }
  .cmp-tile :global(.cmp-icon) { width: 1.65rem; height: 1.65rem; }
  .cmp-label { margin-top: 0.6rem; font-size: 0.82rem; font-weight: 650; line-height: 1.2; color: var(--ink); }
  .cmp-sub { margin-top: 0.2rem; font-size: 0.72rem; line-height: 1.3; color: var(--muted); }
  .cmp-node[data-state='active'] .cmp-tile { transform: translateY(-3px) scale(1.06); box-shadow: inset 0 1px 0 #fff, 0 0 0 2px var(--accent-500), 0 14px 26px -12px color-mix(in oklab, var(--accent-500) 60%, transparent); }
  .cmp-node[data-state='visited'] .cmp-tile { box-shadow: inset 0 1px 0 #fff, 0 0 0 2px #34d399, 0 10px 22px -14px rgb(30 30 90 / 0.45); }
  .cmp-node[data-state='bad'] .cmp-tile { background: #fee2e2; color: #b91c1c; box-shadow: 0 0 0 2px #ef4444, 0 14px 26px -12px rgb(239 68 68 / 0.6); animation: cmp-shake 450ms ease; }
  .cmp-node[data-state='stop'] .cmp-tile { background: #d1fae5; color: #047857; box-shadow: 0 0 0 2.5px #10b981, 0 0 0 8px rgb(16 185 129 / 0.18), 0 14px 26px -12px rgb(16 185 129 / 0.6); }
  .cmp-node[data-state='done'] .cmp-tile { box-shadow: 0 0 0 2.5px #10b981, 0 0 0 8px rgb(16 185 129 / 0.15); }
  :global(.dark) .cmp-node[data-state='bad'] .cmp-tile { background: rgb(127 29 29 / 0.6); }
  :global(.dark) .cmp-node[data-state='stop'] .cmp-tile { background: rgb(6 78 59 / 0.6); }
  @keyframes cmp-shake { 25% { transform: translateX(-3px); } 50% { transform: translateX(3px); } 75% { transform: translateX(-2px); } }

  .cmp-packet { position: absolute; left: 0; top: 0; z-index: 2; display: inline-flex; align-items: center; gap: 0.35rem; max-width: 15rem; padding: 0.25rem 0.6rem 0.25rem 0.3rem; border-radius: 999px; background: var(--ink); color: var(--card); font: 600 0.68rem/1.2 var(--font-mono, ui-monospace, monospace); white-space: nowrap; opacity: 0; box-shadow: 0 8px 20px -8px rgb(0 0 0 / 0.5); will-change: transform, opacity; pointer-events: none; }
  .cmp-packet > :global(svg) { flex: none; padding: 0.2rem; width: 1.3rem; height: 1.3rem; border-radius: 999px; background: var(--accent-500); color: #fff; }
  .cmp-packet span { overflow: hidden; text-overflow: ellipsis; }
  .cmp-packet[data-bad] { background: #dc2626; color: #fff; }
  .cmp-packet[data-bad] > :global(svg) { background: #7f1d1d; }

  .cmp-step { display: flex; gap: 0.6rem; align-items: baseline; border-radius: 0.9rem; padding: 0.45rem 0.6rem; font-size: 0.875rem; line-height: 1.45; color: var(--muted); transition: background-color 250ms ease, color 250ms ease; }
  .cmp-num { flex: none; display: inline-grid; place-items: center; width: 1.35rem; height: 1.35rem; border-radius: 999px; font: 700 0.7rem/1 var(--font-mono, ui-monospace, monospace); color: #fff; background: #111318; }
  :global(.dark) .cmp-num { color: #111318; background: #e6e6e6; }
  .cmp-step[data-on] { background: var(--card); color: var(--ink); box-shadow: 0 0 0 1px var(--line); }
  .cmp-with .cmp-step[data-on] .cmp-num { background: #10b981; color: #fff; }
  .cmp-without .cmp-step[data-on] .cmp-num { background: #ef4444; color: #fff; }

  /* Narrow boxes: the row becomes a column. */
  @container (max-width: 34rem) {
    .cmp-nodes { grid-auto-flow: row; grid-auto-columns: auto; gap: 1.1rem; justify-items: start; }
    .cmp-nodes::before { left: 1.75rem; right: auto; top: 1.5rem; bottom: 1.5rem; width: 2px; height: auto; background: repeating-linear-gradient(180deg, color-mix(in oklab, var(--muted) 45%, transparent) 0 6px, transparent 6px 11px); }
    .cmp-node { display: grid; grid-template-columns: 3.5rem minmax(0, 1fr); column-gap: 0.85rem; align-items: center; text-align: left; width: 100%; }
    .cmp-tile { grid-row: span 2; }
    .cmp-label { margin-top: 0; align-self: end; }
    .cmp-sub { margin-top: 0; align-self: start; }
  }
  @media (prefers-reduced-motion: reduce) { .cmp-tile, .cmp-outcome, .cmp-step { transition: none; } .cmp-node[data-state='bad'] .cmp-tile { animation: none; } }
</style>

<script>
  const HOP = 0.85, DWELL = 0.45, HOLD = 2.2, START = 0.5;
  const ease = (x: number) => (x < 0.5 ? 4 * x * x * x : 1 - Math.pow(-2 * x + 2, 3) / 2);
  const clamp = (v: number, a: number, b: number) => Math.min(b, Math.max(a, v));

  function setup(lane: HTMLElement) {
    const track = lane.querySelector<HTMLElement>('[data-track]')!;
    const packet = lane.querySelector<HTMLElement>('[data-packet]')!;
    const nodes = [...lane.querySelectorAll<HTMLElement>('[data-node]')];
    const steps = [...lane.querySelectorAll<HTMLElement>('[data-step]')];
    const breakAt = Number(lane.dataset.break);
    const stopAt = Number(lane.dataset.stop);
    const last = nodes.length - 1;
    const good = lane.dataset.lane === 'with';
    // The request travels to the stop node (when it is stopped) or to the end.
    const target = stopAt >= 0 ? stopAt : last;
    const travel = START + target * (HOP + DWELL) + DWELL;
    const total = travel + HOLD;

    let centres: { x: number; y: number }[] = [];
    const measure = () => {
      const box = track.getBoundingClientRect();
      centres = nodes.map(node => {
        const tile = node.querySelector<HTMLElement>('.cmp-tile')!.getBoundingClientRect();
        return { x: tile.left - box.left + tile.width / 2, y: tile.top - box.top + tile.height / 2 };
      });
    };
    measure();
    new ResizeObserver(measure).observe(track);

    // Where the request is at time t: sitting at node `at`, or moving from
    // node `from` to node `to` (s = 0..1 along the hop).
    function where(t: number) {
      if (t < START) return { at: 0, from: 0, to: 0, s: 1 };
      const u = t - START, per = DWELL + HOP;
      const h = Math.floor(u / per);
      if (h >= target) return { at: target, from: target, to: target, s: 1 };
      const w = u - h * per;
      if (w < DWELL) return { at: h, from: h, to: h, s: 1 };
      return { at: -1, from: h, to: h + 1, s: clamp((w - DWELL) / HOP, 0, 1) };
    }

    let shown = '';
    function draw(t: number) {
      const p = where(t);
      const a = centres[p.from], b = centres[p.to];
      if (!a || !b) return;
      const e = ease(p.s);
      const x = a.x + (b.x - a.x) * e;
      const y = a.y + (b.y - a.y) * e;
      const ended = t >= travel;
      const reached = p.at >= 0 ? p.at : p.from;
      const vertical = centres.length > 1 && Math.abs(centres[1].y - centres[0].y) > Math.abs(centres[1].x - centres[0].x);
      const bad = (breakAt >= 0 && reached >= breakAt) || (stopAt >= 0 && p.at === stopAt);
      // The chip rides the line between nodes and rests just above a node it
      // reaches (in a column it fades while it passes through the node).
      const fade = ended ? clamp(1 - (t - travel) / 0.4, 0, 1) : t < START ? t / START : 1;
      const resting = p.at >= 0;
      packet.style.opacity = String(fade * (vertical && resting ? 0.25 : 1));
      packet.style.transform = `translate(${x - packet.offsetWidth / 2}px, ${y - packet.offsetHeight / 2 - (resting && !vertical ? 30 : 0)}px)`;
      packet.toggleAttribute('data-bad', bad);
      const states = nodes.map((node, i) => {
        if (i === breakAt && reached >= breakAt) return 'bad';
        if (i === stopAt && reached >= stopAt) return 'stop';
        if (ended && good && i === last && (stopAt < 0 || node.classList.contains('is-guard'))) return 'done';
        if (i === p.at && !ended) return 'active';
        if (i <= reached) return 'visited';
        return '';
      });
      const step = steps.length ? Math.min(steps.length - 1, Math.floor((Math.min(t, travel - 0.01) / travel) * steps.length)) : -1;
      const key = states.join() + '|' + step + '|' + ended;
      if (key !== shown) {
        shown = key;
        nodes.forEach((node, i) => (states[i] ? node.setAttribute('data-state', states[i]) : node.removeAttribute('data-state')));
        steps.forEach((li, i) => li.toggleAttribute('data-on', i === step));
        lane.toggleAttribute('data-ended', ended);
      }
    }

    if (matchMedia('(prefers-reduced-motion: reduce)').matches) { draw(travel + 0.01); packet.style.opacity = '0'; return; }
    let frame = 0, prev = 0, clock = 0, visible = false;
    const tick = (now: number) => {
      frame = visible ? requestAnimationFrame(tick) : 0;
      const dt = prev ? Math.min(0.05, (now - prev) / 1000) : 0;
      prev = now;
      clock = (clock + dt) % total;
      try { draw(clock); } catch { /* keep looping */ }
    };
    new IntersectionObserver(entries => {
      visible = entries[entries.length - 1].isIntersecting;
      prev = 0;
      if (visible && !frame) frame = requestAnimationFrame(tick);
    }, { rootMargin: '80px 0px' }).observe(lane);
    draw(0);
  }

  const start = () => document.querySelectorAll<HTMLElement>('[data-compare] [data-lane]').forEach(setup);
  if (document.readyState === 'complete') start();
  else window.addEventListener('load', start, { once: true });
</script>
