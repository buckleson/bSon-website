---
import '@styles/iso.css';
import * as kitModule from '../../../scripts/figures/kit/iso-kit.mjs';

/**
 * An Anatomy isometric figure (built by scripts/figures/*.mjs). The figure's
 * markup and live script are generated files. The kit itself is bundled once
 * per page (iso-kit.ts puts it on window.IsoKit); each live script runs in
 * its own block with the kit's functions in scope.
 * `tone`: `sheet` blends the card into a dark section, `hero` lays it on the
 * hero's paper, `auto` follows the theme.
 */
interface Props {
  name: 'data-vault' | 'chain-rack';
  tone?: 'sheet' | 'hero' | 'auto';
  class?: string;
}

const { name, tone = 'auto', class: className } = Astro.props;
const html = import.meta.glob('../home/figures/*.html', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const live = import.meta.glob('../home/figures/*.live.js', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const markup = html[`../home/figures/${name}.html`];
const script = live[`../home/figures/${name}.live.js`];
const names = Object.keys(kitModule).join(', ');
const code = `{
const run = () => {
const { ${names} } = window.IsoKit;
${script}
};
window.IsoKit ? run() : window.addEventListener('isokit', run, { once: true });
}`.replace(/<\/(script)/gi, '<\\/$1');
---

<div class:list={['iso', tone === 'sheet' ? 'iso-sheet' : 'iso-auto', tone === 'hero' && 'iso-hero', className]} set:html={markup} />
<script>
  import '@scripts/iso-kit';
</script>
<script type="module" is:inline set:html={code} />
