---
import Glyph from '@components/ui/Glyph.astro';
import type { CollectionEntry } from 'astro:content';
import { categoryOf, coverIcons } from '@utils/blog';

/**
 * Cover art for a blog post, drawn in code as a clean schematic: a light
 * dot grid, a soft gray halo behind a white tile with the post's main
 * icon in black (one colour, like every icon outside the navbar), three smaller tiles for related ideas joined by
 * dashed lines, and numbered callout dots. It scales with its box (container
 * units) and fills a positioned parent. `chip` adds the topic in a corner.
 */
interface Props {
  post: CollectionEntry<'blog'>;
  chip?: boolean;
  class?: string;
}

const { post, chip = false, class: className } = Astro.props;
const category = categoryOf(post);
const [main, ...satellites] = coverIcons(post);
// Tile centres (percent of the box): main, then the three related ideas.
const spots = [
  [50, 52],
  [19, 27],
  [22, 77],
  [81, 34],
];
---

<div class:list={['blog-art absolute inset-0 overflow-hidden', className]} aria-hidden="true">
  <span class="ba-grid"></span>
  <span class="ba-halo"></span>
  <svg class="ba-lines" viewBox="0 0 100 100" preserveAspectRatio="none">
    {spots.slice(1).map(([x, y]) => <line x1="50" y1="52" x2={x} y2={y} />)}
  </svg>
  <span class="ba-ring"></span>
  {satellites.map((icon, i) => (
    <span class="ba-tile ba-sat" style={`left:${spots[i + 1][0]}%;top:${spots[i + 1][1]}%`}>
      <Glyph ui={icon} class="ba-icon" />
      <span class="ba-dot">{i + 1}</span>
    </span>
  ))}
  <span class="ba-tile ba-main" style="left:50%;top:52%"><Glyph ui={main} class="ba-icon" /></span>
  {chip && <span class="ba-chip"><Glyph ui={category.icon} class="ba-chip-icon" />{category.label}</span>}
</div>

<style>
  .blog-art {
    container-type: size;
    background: #f6f6f7;
  }
  :global(.dark) .blog-art { background: #121212; }
  .ba-grid {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(#d4d4d8 1px, transparent 1.3px);
    background-size: 16px 16px;
    mask-image: radial-gradient(80% 80% at 50% 50%, #000 40%, transparent);
  }
  :global(.dark) .ba-grid { background-image: radial-gradient(#2a2a2a 1px, transparent 1.3px); }
  .ba-halo {
    position: absolute;
    left: 50%;
    top: 52%;
    width: 78cqmin;
    height: 78cqmin;
    border-radius: 999px;
    background: #ececee;
    transform: translate(-50%, -50%);
  }
  :global(.dark) .ba-halo { background: #1b1b1b; }
  .ba-ring {
    position: absolute;
    left: 50%;
    top: 52%;
    width: 112cqmin;
    height: 112cqmin;
    border-radius: 999px;
    border: 1.5px dashed #d4d4d8;
    transform: translate(-50%, -50%);
  }
  .ba-lines { position: absolute; inset: 0; width: 100%; height: 100%; }
  .ba-lines line { stroke: #a1a1aa; stroke-width: 1.5; stroke-dasharray: 4 5; vector-effect: non-scaling-stroke; }
  .ba-tile {
    position: absolute;
    display: grid;
    place-items: center;
    transform: translate(-50%, -50%);
    border-radius: 28%;
    background: #fff;
    box-shadow: 0 0 0 1px #e4e4e7, 0 1cqmin 3cqmin -1cqmin rgb(0 0 0 / 0.2);
    transition: transform 500ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  :global(.dark) .ba-tile { background: #1c1c1c; box-shadow: 0 0 0 1px #2c2c2c; }
  .ba-main { width: 34cqmin; height: 34cqmin; color: #0b0b0c; box-shadow: 0 0 0 1.5px #d4d4d8, 0 2.5cqmin 6cqmin -2cqmin rgb(0 0 0 / 0.28); }
  :global(.dark) .ba-main { color: #f4f4f5; box-shadow: 0 0 0 1.5px #333; }
  .ba-sat { width: 16cqmin; height: 16cqmin; color: #0b0b0c; }
  :global(.dark) .ba-sat { color: #e6e6e6; }
  .ba-main :global(.ba-icon) { width: 54%; height: 54%; }
  .ba-sat :global(.ba-icon) { width: 52%; height: 52%; }
  .ba-dot {
    position: absolute;
    right: -1.6cqmin;
    top: -1.6cqmin;
    display: grid;
    place-items: center;
    width: 5.4cqmin;
    height: 5.4cqmin;
    min-width: 14px;
    min-height: 14px;
    border-radius: 999px;
    background: #111318;
    color: #fff;
    font: 700 max(8px, 2.6cqmin) / 1 var(--font-mono, ui-monospace, monospace);
  }
  :global(.group:hover) .ba-main { transform: translate(-50%, -54%) scale(1.04); }
  .ba-chip {
    position: absolute;
    left: 4cqmin;
    bottom: 4cqmin;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.7rem 0.3rem 0.4rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.92);
    color: #0b0b0c;
    font-size: 0.72rem;
    font-weight: 600;
    box-shadow: 0 0 0 1px #e4e4e7;
  }
  .ba-chip :global(.ba-chip-icon) { width: 1rem; height: 1rem; color: #0b0b0c; }
  @media (prefers-reduced-motion: reduce) { .ba-tile { transition: none; } }
</style>
