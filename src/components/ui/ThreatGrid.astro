---
import Glyph from '@components/ui/Glyph.astro';
import { threats } from '@data/threats';

/**
 * The ten agent risks as cards: what the risk is, how Pavii stops it, which
 * layers do the work, and an honest badge for what the blockchain adds.
 * The example attack and the blockchain's part open on demand.
 */
interface Props {
  class?: string;
  limit?: number;
}

const { class: className, limit = threats.length } = Astro.props;
const badge = {
  yes: { label: 'Blockchain: core', icon: 'link-simple', cls: 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-200' },
  partly: { label: 'Blockchain: part', icon: 'link-simple-break', cls: 'bg-yellow-100 text-yellow-900 dark:bg-yellow-950 dark:text-yellow-200' },
  evidence: { label: 'Blockchain: evidence only', icon: 'magnifying-glass', cls: 'bg-ground text-muted ring-1 ring-line' },
};
---

<ol class:list={['grid grid-cols-1 gap-3 md:grid-cols-2 xl:grid-cols-3', className]} data-reveal-group>
  {threats.slice(0, limit).map((threat, i) => (
    <li class="glass-card flex flex-col rounded-[1.6rem] p-6" data-reveal-item>
      <div class="flex items-start justify-between gap-3">
        <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-orange-100 text-orange-700 dark:bg-orange-950 dark:text-orange-300"><Glyph icon={threat.icon} class="size-5" /></span>
        <span class="font-mono text-xs text-muted">{String(i + 1).padStart(2, '0')}</span>
      </div>
      <h3 class="mt-5 text-lg leading-snug font-semibold text-balance text-ink">{threat.title}</h3>
      <p class="mt-2 text-sm leading-relaxed text-pretty text-muted">{threat.risk}</p>
      <p class="mt-4 text-sm leading-relaxed text-pretty text-ink"><span class="font-semibold">How Pavii stops it.</span> {threat.answer}</p>
      <ul class="mt-4 flex flex-wrap gap-1.5">
        {threat.layers.map(layer => <li class="rounded-full bg-ground px-2.5 py-1 font-mono text-[0.68rem] text-ink/80 ring-1 ring-line">{layer}</li>)}
      </ul>
      <div class="mt-auto pt-5">
        <p class:list={['inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-semibold', badge[threat.chain].cls]}><Glyph icon={badge[threat.chain].icon} class="size-3.5" />{badge[threat.chain].label}</p>
        <details class="group mt-3">
          <summary class="inline-flex cursor-pointer list-none items-center gap-1.5 text-sm font-semibold text-orange-700 dark:text-orange-300">
            <Glyph icon="caret-down" class="size-4 transition group-open:rotate-180" />See an example
          </summary>
          <p class="mt-3 rounded-xl bg-ground p-3 text-sm text-pretty text-muted"><span class="font-semibold text-ink">Example.</span> {threat.example}</p>
          <p class="mt-2 text-sm text-pretty text-muted"><span class="font-semibold text-ink">What the chain adds.</span> {threat.chainText}</p>
        </details>
      </div>
    </li>
  ))}
</ol>
