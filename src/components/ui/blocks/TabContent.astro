---
import Diagram from '@components/ui/Diagram.astro';
import type { DiagramName } from '@data/diagrams';

/** One tab panel showing an architecture diagram; `first` starts visible. */
interface Props {
  id: string;
  aria: string;
  diagram: DiagramName;
  alt: string;
  first?: boolean;
}

const { id, aria, diagram, alt, first } = Astro.props;
---

<div id={id} role="tabpanel" class={first ? '' : 'hidden'} aria-labelledby={aria}>
  <Diagram name={diagram} alt={alt} />
</div>
