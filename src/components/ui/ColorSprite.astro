---
import { colorSymbol } from '@utils/glyphs';

/**
 * Defines every colour icon used on the page once, at the end of the page;
 * each icon on the page is a <use> of its symbol. The sprite is zero-sized,
 * not hidden, so the icons' gradients still render.
 */
const names = [...(Astro.locals.colorIcons ?? [])].sort();
---

{names.length > 0 && (
  <svg width="0" height="0" style="position:absolute;width:0;height:0;overflow:hidden" aria-hidden="true" focusable="false">
    {names.map(name => <symbol id={`ci-${name}`} set:html={colorSymbol(name).body} />)}
  </svg>
)}
