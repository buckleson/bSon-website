---
import { brand, glyph, type BrandKey } from '@utils/glyphs';

/**
 * One looping scene per product (pure SVG + CSS, no JavaScript), used
 * wherever a product needs a picture: the home accordion, product cards, the
 * product page and services. Each scene has a title bar, a labelled diagram
 * with small data (counts, amounts, statuses) and three numbered captions at
 * the bottom that light up in turn, so it reads at a glance and explains
 * itself on a closer look.
 * - hyper-0x: bank, fintech and AI L2s (and one added live) pass rule checks
 *   and settle on the L1, which seals blocks of different sizes; bridges to
 *   public chains below.
 * - pavii: prompts and tool calls from three agents meet the Pavii shield;
 *   safe ones pass to tools, data or users, malicious ones turn red, show
 *   which gate stopped them, crack and fall; receipts tick by.
 * - hyper-wallet: chains and exchanges on the left, a swap in the phone
 *   settling both legs at once, the rest of the app on the right.
 * - h0x-pay: a payment sends a slice into a tokenized gold balance; roadmap.
 * - hyperrun: a match ends, the result is signed, players, fans and sponsors
 *   are paid.
 * Values in the scenes are illustrations, not live data.
 * Scenes only animate while on screen (and, in the products accordion, while
 * their panel is open); they start after the page has loaded.
 */
interface Props {
  product: 'hyper-0x' | 'pavii' | 'hyper-wallet' | 'h0x-pay' | 'hyperrun';
  class?: string;
  /** Fill a positioned parent instead of sizing itself. */
  fill?: boolean;
  /** `hover`: play only while the surrounding link is hovered or focused. */
  play?: 'auto' | 'hover';
}

const { product, class: className, fill = false, play = 'auto' } = Astro.props;
const W = 440;
const H = 360;

const icon = (name: string, x: number, y: number, size: number, cls = 'pa-ic') =>
  `<svg x="${x}" y="${y}" width="${size}" height="${size}" viewBox="0 0 256 256" fill="currentColor" class="${cls}">${glyph(name)}</svg>`;
const logo = (key: BrandKey, x: number, y: number, size: number, white = false) => {
  const b = brand(key);
  return `<svg x="${x}" y="${y}" width="${size}" height="${size}" viewBox="0 0 24 24"><path d="${b.path}"${b.rule ? ` fill-rule="${b.rule}"` : ''} fill="${white ? '#ffffff' : `#${b.hex}`}"/></svg>`;
};

const META = {
  'hyper-0x': { title: 'How Hyper 0X works', icon: 'cube', live: true, dur: 9, steps: [['Each app gets', 'its own L2'], ['Every L2 settles', 'on one L1'], ['Final in one pass,', 'no reorgs']] },
  pavii: { title: 'How Pavii protects agents', icon: 'shield-check', live: true, dur: 12, steps: [['Agents send prompts', 'and tool calls'], ['Six gates check', 'every call'], ['Bad calls stop,', 'receipts on-chain']] },
  'hyper-wallet': { title: 'Inside Hyper Wallet', icon: 'wallet', live: true, dur: 8, steps: [['Every chain in', 'one app'], ['Best-route swap,', 'MEV-protected'], ['Both legs settle', 'at once']] },
  'h0x-pay': { title: 'How H0X Pay works', icon: 'coins', live: false, dur: 9, steps: [['Pay as usual,', 'by link or QR'], ['A slice of each', 'payment is invested'], ['Your tokenized', 'gold grows']] },
  hyperrun: { title: 'How HyperRun pays out', icon: 'crosshair', live: false, dur: 9, steps: [['Play a ranked', 'match'], ['The result is', 'signed'], ['Players and fans', 'get paid']] },
} as const;
const meta = META[product];

// Hyper 0X
const h0Nodes = [
  { x: 70, label: 'Bank L2', sub: 'KYC · limits', icon: 'bank', check: 'KYC ✓' },
  { x: 166, label: 'Fintech L2', sub: 'Payments', icon: 'credit-card', check: 'limit ✓' },
  { x: 262, label: 'AI L2', sub: 'Audit trail', icon: 'robot', check: 'signed ✓' },
  { x: 358, label: 'New L2', sub: 'Added live', icon: 'plus-circle', dynamic: true },
];
const h0Widths = [10, 22, 14, 28, 8, 18];
const h0Gap = (120 - h0Widths.reduce((a, b) => a + b, 0)) / h0Widths.length;
const h0Blocks: { x: number; w: number }[] = [];
for (let x = 76, i = 0; x < 440; i++) {
  const w = h0Widths[i % h0Widths.length];
  h0Blocks.push({ x, w });
  x += w + h0Gap;
}
const h0Bridges: { label: string; brand?: BrandKey; icon?: string; x: number; w: number }[] = [
  { label: 'Ethereum', brand: 'ethereum', x: 70, w: 86 },
  { label: 'Solana', brand: 'solana', x: 162, w: 78 },
  { label: 'Sui', brand: 'sui', x: 246, w: 60 },
  { label: 'Core banking', icon: 'bank', x: 312, w: 112 },
];

// Pavii (scene drawn 20 right, 40 down from its original 400x260 layout)
const pvLane = [104, 164, 224];
const pvSources: BrandKey[] = ['claude', 'openai', 'gemini'];
const pvTargets = [
  { icon: 'plugs', label: 'Tools' },
  { icon: 'database', label: 'Data' },
  { icon: 'users', label: 'Users' },
];
const pvGates = ['Injection', 'Privacy', 'Supply chain', 'Budget', 'Egress', 'Output'];
// `still`: the moment shown when motion is reduced (seconds into the loop).
const pvItems: { label: string; tool: boolean; bad: boolean; from: number; to?: number; reason?: string; gate?: number; still: number }[] = [
  { label: 'Summarise Q3 report', tool: false, bad: false, from: 0, to: 2, still: -2.6 },
  { label: 'email.send(all, db)', tool: true, bad: true, from: 1, reason: 'data exfiltration', gate: 4, still: -2.3 },
  { label: 'crm.lookup(4821)', tool: true, bad: false, from: 2, to: 1, still: -8 },
  { label: 'Ignore all your rules', tool: false, bad: true, from: 0, reason: 'prompt injection', gate: 0, still: -8 },
  { label: 'invoice.create()', tool: true, bad: false, from: 1, to: 0, still: -8 },
  { label: 'wallet.send($50k)', tool: true, bad: true, from: 2, reason: 'over budget', gate: 3, still: -8 },
];
const gateX = (i: number) => 172 + (i % 3) * 52;
const gateY = (i: number) => (i < 3 ? 240 : 256);

// Hyper Wallet
const hwChains: (BrandKey | 'more')[] = ['bitcoin', 'ethereum', 'solana', 'sui', 'tether', 'more'];
const hwInside = [
  { icon: 'chart-line-up', label: 'Perps' },
  { icon: 'buildings', label: 'Pre-IPO stocks' },
  { icon: 'chart-pie-slice', label: 'Index funds' },
  { icon: 'diamond', label: 'Tokenized gold' },
  { icon: 'target', label: 'Predictions' },
  { icon: 'code', label: 'White-label SDK' },
];

// H0X Pay
const hpPhases = [
  { n: 'Phase 1', label: 'Tokenized gold', x: 14 },
  { n: 'Phase 2', label: 'Funds, stocks, bonds', x: 152 },
  { n: 'Phase 3', label: 'Crypto payments', x: 290 },
];

// HyperRun
const hrRows = [
  { icon: 'user', label: 'Ava · player', amount: '+$25.00' },
  { icon: 'users-three', label: 'Fans who picked Ava', amount: '+$8.40' },
  { icon: 'handshake', label: 'Ava’s sponsors', amount: '+$4.10' },
];
const hrBuilt = [
  { icon: 'wallet', label: 'Hyper Wallet SDK', x: 14 },
  { icon: 'scroll', label: 'Rewards contract', x: 152 },
  { icon: 'seal-check', label: 'Signed results', x: 290 },
];
---

<div class:list={['pa pa-off accent-warm overflow-hidden rounded-[inherit] bg-[#0c0c0c]', fill ? 'absolute inset-0' : 'relative', className]} data-pa={play} role="img" aria-label={`${meta.title}: ${meta.steps.map(step => step.join(' ')).join('; ')}`} style={`--pa-dur:${meta.dur}s`}>
  <svg viewBox={`0 0 ${W} ${H}`} class="block h-full w-full" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
    <defs>
      <pattern id={`pa-grid-${product}`} width="20" height="20" patternUnits="userSpaceOnUse"><circle cx="1" cy="1" r="0.9" fill="#212121" /></pattern>
    </defs>
    <rect width={W} height={H} fill={`url(#pa-grid-${product})`} />

    {/* Title bar */}
    <rect x="14" y="10" width="22" height="22" rx="7" class="pa-chip-accent" />
    <Fragment set:html={icon(meta.icon, 17, 13, 16, 'pa-ic-accent')} />
    <text x="44" y="25.5" class="pa-title">{meta.title}</text>
    {meta.live ? (
      <g>
        <rect x={W - 70} y="12" width="56" height="18" rx="9" class="pa-pill" />
        <circle cx={W - 59} cy="21" r="3" class="pa-live-dot" />
        <text x={W - 51} y="24.5" class="pa-pill-t">LIVE</text>
      </g>
    ) : (
      <g>
        <rect x={W - 100} y="12" width="86" height="18" rx="9" class="pa-pill-accent" />
        <text x={W - 57} y="24.5" text-anchor="middle" class="pa-pill-t-accent">COMING SOON</text>
      </g>
    )}
    <line x1="14" y1="40" x2={W - 14} y2="40" class="pa-rule" />

    {product === 'hyper-0x' && (
      <g>
        <rect x="314" y="52" width="88" height="42" rx="12" class="h0-slot" />
        <text x="358" y="77" text-anchor="middle" class="pa-t-sm h0-slot-t">+ add an L2</text>
        {h0Nodes.map((node, i) => (
          <g class:list={[node.dynamic && 'h0-dyn']}>
            <line x1={node.x} y1="94" x2={node.x} y2="198" class="pa-line" />
            <rect x="-6" y="-6" width="12" height="12" rx="3" class="pa-block">
              <animateMotion dur={`${1.3 + i * 0.25}s`} begin={`${i * 0.4}s`} repeatCount="indefinite" path={`M${node.x},98 L${node.x},194`} />
              <animate attributeName="opacity" values="0;1;1;0" keyTimes="0;0.12;0.88;1" dur={`${1.3 + i * 0.25}s`} begin={`${i * 0.4}s`} repeatCount="indefinite" />
            </rect>
            {node.check && (
              <g class="h0-check" style={`animation-delay:${i * 0.9}s`}>
                <rect x={node.x + 6} y="132" width="46" height="16" rx="8" class="pa-ok-bg" />
                <text x={node.x + 29} y="143.5" text-anchor="middle" class="pa-t-ok">{node.check}</text>
              </g>
            )}
            <rect x={node.x - 44} y="52" width="88" height="42" rx="12" class="pa-node" />
            <Fragment set:html={icon(node.icon, node.x - 38, 61, 16)} />
            <text x={node.x - 18} y="70" class="pa-t">{node.label}</text>
            <text x={node.x - 18} y="83" class="pa-t-xs">{node.sub}</text>
          </g>
        ))}
        <rect x="14" y="198" width="412" height="48" rx="14" class="pa-chain" />
        <svg x="26" y="210" width="20" height="24" viewBox="280 210 700 820" fill="none" stroke="#fff" stroke-linejoin="round" aria-hidden="true">
          <path vector-effect="non-scaling-stroke" stroke-width="1.6" d="M318 385Q318 360 339 347L494 247Q527 228 527 268L527 855Q527 870 513 880L352 988Q318 1005 318 970ZM527 362L436 421Q420 431 420 450L420 800Q420 818 436 828L513 880M736 385Q736 360 757 347L912 247Q945 228 945 268L945 855Q945 870 931 880L770 988Q736 1005 736 970ZM945 362L854 421Q838 431 838 450L838 800Q838 818 854 828L931 880" />
          <rect vector-effect="non-scaling-stroke" stroke-width="1.6" x="557" y="541" width="146" height="151" rx="22" />
        </svg>
        <text x="54" y="217" class="pa-t-w">Hyper 0X L1</text>
        {[48217, 48218, 48219].map((n, i) => (
          <text x="54" y="231" class:list={['pa-t-on h0-count', i === 0 && 'h0-first']} style={`animation-delay:${i * 3}s`}>block #{n.toLocaleString('en-US')} · final ✓</text>
        ))}
        <rect x="196" y="206" width="220" height="32" rx="9" class="h0-lane" />
        <clipPath id="h0-lane"><rect x="196" y="206" width="220" height="32" rx="9" /></clipPath>
        <g clip-path="url(#h0-lane)">
          <g class="h0-chain">
            {h0Blocks.map(block => <rect x={block.x} y="213" width={block.w} height="18" rx="4" class="h0-chunk" />)}
          </g>
        </g>
        <text x="16" y="282" class="pa-t-xs">BRIDGES</text>
        {h0Bridges.map((bridge, i) => (
          <g>
            <line x1={bridge.x + bridge.w / 2} y1="246" x2={bridge.x + bridge.w / 2} y2="264" class="pa-line" />
            <circle r="2.4" class="pa-dot">
              <animateMotion dur="1.6s" begin={`${i * 0.4}s`} repeatCount="indefinite" path={`M${bridge.x + bridge.w / 2},248 L${bridge.x + bridge.w / 2},262`} />
            </circle>
            <rect x={bridge.x} y="264" width={bridge.w} height="26" rx="13" class="pa-node" />
            {bridge.brand ? <Fragment set:html={logo(bridge.brand, bridge.x + 8, 270, 14)} /> : <Fragment set:html={icon(bridge.icon!, bridge.x + 8, 270, 14)} />}
            <text x={bridge.x + 27} y="281" class="pa-t-sm">{bridge.label}</text>
          </g>
        ))}
      </g>
    )}

    {product === 'pavii' && (
      <g>
        <defs>
          <clipPath id="pv-left"><rect x="-70" y="-20" width="70" height="40" /></clipPath>
          <clipPath id="pv-right"><rect x="0" y="-20" width="70" height="40" /></clipPath>
        </defs>
        <text x="44" y="70" text-anchor="middle" class="pa-t-xs">AGENTS</text>
        {pvSources.map((key, i) => (
          <g>
            <circle cx="44" cy={pvLane[i]} r="14" class="pa-node" />
            <Fragment set:html={logo(key, 36, pvLane[i] - 8, 16, key === 'openai')} />
          </g>
        ))}
        <text x="392" y="70" text-anchor="middle" class="pa-t-xs">SYSTEMS</text>
        {pvTargets.map((target, i) => (
          <g>
            <rect x="375" y={pvLane[i] - 17} width="34" height="34" rx="10" class="pa-node" />
            <Fragment set:html={icon(target.icon, 383, pvLane[i] - 9, 18)} />
            <text x="392" y={pvLane[i] + 27} text-anchor="middle" class="pa-t-xs">{target.label.toUpperCase()}</text>
          </g>
        ))}

        <circle cx="224" cy="164" r="46" class="pa-shield-ring" />
        {pvItems.map((item, i) => (
          <circle cx="224" cy="164" r="36" class={item.bad ? 'pv-flash' : 'pv-pulse'} style={`animation-delay:${i * 2}s;--still:${item.still}s`} />
        ))}
        <circle cx="224" cy="164" r="34" class="pa-chain" />
        <svg x="204" y="144" width="40" height="40" viewBox="84 92 1086 1086" class="pv-logo" aria-hidden="true">
          <circle cx="627" cy="613" r="503" fill="none" stroke="currentColor" stroke-width="56" />
          <path d="M376 335H728A185 199 0 0 1 728 733H665V980L552 848V613H722A79 79 0 0 0 722 455H497V710L376 567Z" fill="currentColor" />
        </svg>
        <text x="224" y="224" text-anchor="middle" class="pa-t-w">Pavii · 6 gates</text>
        {pvGates.map((gate, i) => (
          <g>
            <rect x={gateX(i) - 25} y={gateY(i) - 11} width="50" height="14" rx="7" class="pv-gate" />
            <text x={gateX(i)} y={gateY(i) - 1.4} text-anchor="middle" class="pv-gate-t">{gate}</text>
          </g>
        ))}
        {pvItems.filter(item => item.bad).map(item => (
          <rect x={gateX(item.gate!) - 25} y={gateY(item.gate!) - 11} width="50" height="14" rx="7" class="pv-gate-hit" style={`animation-delay:${pvItems.indexOf(item) * 2}s;--still:${item.still}s`} />
        ))}
        {pvItems.filter(item => item.bad).map(item => (
          <g class="pv-reason" style={`animation-delay:${pvItems.indexOf(item) * 2}s;--still:${item.still}s`}>
            <rect x="156" y="270" width="136" height="22" rx="11" class="pv-reason-bg" />
            <text x="224" y="285" text-anchor="middle" class="pv-reason-t">Blocked: {item.reason}</text>
          </g>
        ))}
        {[1042, 1043, 1044].map((n, i) => (
          <text x="16" y="286" class="pa-t-xs pv-receipt" style={`animation-delay:${i * 4}s`}>RECEIPT #{n} · ON HYPER 0X</text>
        ))}

        {pvItems.map((item, i) => {
          const timing = `animation-delay:${i * 2}s;--still:${item.still}s`;
          const parts = item.bad ? ['pv-half pv-half-l', 'pv-half pv-half-r'] : ['pv-whole'];
          return (
            <g class:list={['pv-item', item.bad ? 'pv-bad' : 'pv-good']} style={`--y0:${pvLane[item.from]}px;--y1:${pvLane[item.to ?? 1]}px;${timing}`}>
              {parts.map(part => (
                <g class={part} clip-path={part.endsWith('-l') ? 'url(#pv-left)' : part.endsWith('-r') ? 'url(#pv-right)' : undefined} style={timing}>
                  <rect x="-60" y="-14" width="120" height="28" rx="14" class="pv-pill" />
                  <rect x="-60" y="-14" width="120" height="28" rx="14" class={item.bad ? 'pv-red' : 'pv-ok-ring'} style={timing} />
                  <circle cx="-45" cy="0" r="10" class={item.tool ? 'pv-ic-tool' : 'pv-ic-prompt'} />
                  <Fragment set:html={icon(item.tool ? 'wrench' : 'chat-circle-text', -52, -7, 14, 'pa-ic-w')} />
                  <text x="-31" y="-2.5" class="pv-kind">{item.tool ? 'TOOL CALL' : 'PROMPT'}</text>
                  <text x="-31" y="8" class="pv-label">{item.label}</text>
                </g>
              ))}
              {item.bad && <path d="M0 -14 L-3 -6 L2 -1 L-2 5 L1 14" class="pv-crack" style={timing} />}
              {!item.bad && (
                <g class="pv-check" style={timing}>
                  <circle cx="56" cy="-12" r="7" />
                  <path d="M52.6 -12 L55 -9.6 L59.4 -14" />
                </g>
              )}
            </g>
          );
        })}
      </g>
    )}

    {product === 'hyper-wallet' && (
      <g>
        <text x="16" y="60" class="pa-t-xs">CHAINS</text>
        {hwChains.map((chain, i) => {
          const x = 16 + (i % 2) * 52;
          const y = 68 + Math.floor(i / 2) * 32;
          return (
            <g class="hw-chain" style={`animation-delay:${i * 0.35}s`}>
              <rect x={x} y={y} width="46" height="26" rx="9" class="pa-node" />
              {chain === 'more' ? <text x={x + 23} y={y + 16.5} text-anchor="middle" class="pa-t-sm">+5 more</text> : <Fragment set:html={logo(chain, x + 15, y + 5, 16)} />}
            </g>
          );
        })}
        <text x="16" y="182" class="pa-t-xs">DEPOSIT FROM</text>
        <rect x="16" y="190" width="98" height="26" rx="9" class="pa-node" />
        <Fragment set:html={logo('binance', 24, 196, 14)} />
        <text x="44" y="207" class="pa-t-sm">Binance</text>
        <rect x="16" y="222" width="98" height="26" rx="9" class="pa-node" />
        <Fragment set:html={logo('coinbase', 24, 228, 14)} />
        <text x="44" y="239" class="pa-t-sm">Coinbase</text>
        <rect x="16" y="262" width="98" height="26" rx="9" class="pa-ok-bg" />
        <Fragment set:html={icon('fingerprint', 24, 268, 14, 'pa-ic-ok')} />
        <text x="44" y="279" class="pa-t-ok">No seed phrase</text>

        <rect x="130" y="50" width="180" height="248" rx="24" class="pa-phone" />
        <rect x="196" y="58" width="48" height="6" rx="3" fill="#000" />
        <text x="146" y="82" class="pa-t-xs">HYPER WALLET</text>
        <Fragment set:html={icon('fingerprint', 280, 71, 14, 'pa-ic-accent')} />
        <text x="146" y="98" class="pa-t-xs">PORTFOLIO</text>
        <text x="146" y="116" class="pa-t-big">$12,480.25</text>
        <text x="146" y="129" class="pa-t-ok">+2.4% this week</text>
        <rect x="142" y="138" width="156" height="94" rx="14" class="pa-node" />
        <text x="152" y="152" class="pa-t-xs">SWAP</text>
        <Fragment set:html={logo('ethereum', 152, 160, 14)} />
        <text x="172" y="171" class="pa-t">0.50 ETH</text>
        <text x="288" y="171" text-anchor="end" class="pa-t-xs">FROM</text>
        <line x1="152" y1="185" x2="288" y2="185" class="pa-rule" />
        <circle cx="220" cy="185" r="9" class="hw-arrow-bg" />
        <g class="hw-arrow"><Fragment set:html={icon('arrows-down-up', 213, 178, 14, 'pa-ic-w')} /></g>
        <Fragment set:html={icon('currency-circle-dollar', 151, 198, 16, 'hw-usdc')} />
        <text x="172" y="210" class="pa-t">1,250.00 USDC</text>
        <text x="288" y="210" text-anchor="end" class="pa-t-xs">TO</text>
        <text x="152" y="224" class="pa-t-xs">BEST ROUTE · 3 VENUES</text>
        <g>
          <rect x="142" y="240" width="156" height="22" rx="11" class="pa-node" />
          <Fragment set:html={icon('shield-check', 150, 244, 14, 'pa-ic-accent')} />
          <text x="168" y="255" class="pa-t-sm">MEV-protected · one fee</text>
        </g>
        <g class="hw-swap">
          <rect x="142" y="268" width="156" height="22" rx="11" class="pa-accent-bg" />
          <text x="220" y="283" text-anchor="middle" class="pa-t-w">Swap</text>
        </g>
        <g class="hw-done">
          <rect x="142" y="268" width="156" height="22" rx="11" class="pa-ok-solid" />
          <text x="220" y="283" text-anchor="middle" class="pa-t-dark">Settled · both legs ✓</text>
        </g>

        <text x="326" y="60" class="pa-t-xs">ALSO IN THE APP</text>
        {hwInside.map((item, i) => (
          <g class="hw-item" style={`animation-delay:${i * 0.5}s`}>
            <rect x="326" y={68 + i * 34} width="100" height="26" rx="9" class="pa-node" />
            <Fragment set:html={icon(item.icon, 334, 74 + i * 34, 14)} />
            <text x="353" y={85 + i * 34} class="pa-t-sm">{item.label}</text>
          </g>
        ))}
      </g>
    )}

    {product === 'h0x-pay' && (
      <g>
        <rect x="14" y="54" width="156" height="128" rx="16" class="pa-node" />
        <Fragment set:html={icon('storefront', 26, 66, 18)} />
        <text x="50" y="76" class="pa-t">Coffee shop</text>
        <text x="50" y="88" class="pa-t-xs">PAID BY QR CODE</text>
        <Fragment set:html={icon('qr-code', 144, 64, 16, 'pa-ic-dim')} />
        <text x="26" y="124" class="pa-t-big">$40.00</text>
        <rect x="26" y="140" width="132" height="26" rx="9" class="pa-ok-bg" />
        <Fragment set:html={icon('check-circle', 33, 146, 14, 'pa-ic-ok')} />
