---
import { brand, glyph, type BrandKey } from '@utils/glyphs';

/**
 * Small looping scene per product (pure SVG + CSS, no JavaScript), used
 * wherever a product needs an image: home accordion, product cards.
 * - hyper-0x: three private L2s stream blocks into the shared L1.
 * - pavii: prompts and tool calls from three agents meet the Pavii shield;
 *   safe ones pass to tools, data or users; malicious ones turn red, show why
 *   they were blocked, crack and fall.
 * - hyper-wallet: a trade settles both legs at once.
 * - h0x-pay: a payment drops a slice into a growing gold balance.
 * - hyperrun: a match result is signed and rewards pay out.
 */
interface Props {
  product: 'hyper-0x' | 'pavii' | 'hyper-wallet' | 'h0x-pay' | 'hyperrun';
  class?: string;
  /** Fill a positioned parent instead of sizing itself. */
  fill?: boolean;
}

const { product, class: className, fill = false } = Astro.props;
// Pavii: six calls from three agents on three lanes; safe ones reach a
// system, malicious ones are stopped at the shield with the reason shown.
const pvLane = [64, 124, 184];
const pvSources: BrandKey[] = ['claude', 'openai', 'gemini'];
const pvTargets = [
  { icon: 'plugs', label: 'Tools' },
  { icon: 'database', label: 'Data' },
  { icon: 'users', label: 'Users' },
];
// `still`: the moment shown when motion is reduced (seconds into the loop).
const pvItems: { label: string; tool: boolean; bad: boolean; from: number; to?: number; reason?: string; still: number }[] = [
  { label: 'Summarise Q3 report', tool: false, bad: false, from: 0, to: 2, still: -2.6 },
  { label: 'email.send(all, db)', tool: true, bad: true, from: 1, reason: 'data exfiltration', still: -2.3 },
  { label: 'crm.lookup(4821)', tool: true, bad: false, from: 2, to: 1, still: -8 },
  { label: 'Ignore all your rules', tool: false, bad: true, from: 0, reason: 'prompt injection', still: -8 },
  { label: 'invoice.create()', tool: true, bad: false, from: 1, to: 0, still: -8 },
  { label: 'wallet.send($50k)', tool: true, bad: true, from: 2, reason: 'over budget', still: -8 },
];
const icon = (name: string, x: number, y: number, size: number, cls = 'pa-ic') =>
  `<svg x="${x}" y="${y}" width="${size}" height="${size}" viewBox="0 0 256 256" class="${cls}">${glyph(name)}</svg>`;
---

<div class:list={['pa overflow-hidden rounded-[inherit] bg-[#0e1014]', fill ? 'absolute inset-0' : 'relative', className]} role="img" aria-label={`${product} animation`}>
  <svg viewBox="0 0 400 260" class="block h-full w-full" preserveAspectRatio={fill ? 'xMidYMid meet' : 'xMidYMid slice'}>
    <defs>
      <pattern id={`pa-grid-${product}`} width="20" height="20" patternUnits="userSpaceOnUse"><circle cx="1" cy="1" r="1" fill="#23272f" /></pattern>
    </defs>
    <rect width="400" height="260" fill={`url(#pa-grid-${product})`} />

    {product === 'hyper-0x' && (
      <g>
        {[70, 200, 330].map((x, i) => (
          <g>
            <rect x={x - 48} y="34" width="96" height="40" rx="12" class="pa-node" />
            <text x={x} y="59" text-anchor="middle" class="pa-t">{['Bank L2', 'Fintech L2', 'AI L2'][i]}</text>
            <line x1={x} y1="74" x2="200" y2="190" class="pa-line" />
            <rect x="-7" y="-7" width="14" height="14" rx="3" class="pa-block">
              <animateMotion dur="1.65s" begin={`${i * 0.55}s`} repeatCount="indefinite" path={`M${x},74 L200,190`} />
              <animate attributeName="opacity" values="0;1;1;0" keyTimes="0;0.15;0.9;1" dur="1.65s" begin={`${i * 0.55}s`} repeatCount="indefinite" />
            </rect>
          </g>
        ))}
        <rect x="70" y="190" width="260" height="44" rx="14" class="pa-chain" />
        <Fragment set:html={icon('cube', 92, 202, 20, 'pa-ic-w')} />
        <text x="122" y="217" class="pa-t-w">Hyper 0X L1 · final</text>
        {[0, 1, 2, 3, 4].map(i => <rect x={250 + i * 14} y="204" width="10" height="16" rx="2" class="pa-stack" style={`animation-delay:${i * 0.4}s`} />)}
      </g>
    )}

    {product === 'pavii' && (
      <g>
        <defs>
          <clipPath id="pv-left"><rect x="-70" y="-20" width="70" height="40" /></clipPath>
          <clipPath id="pv-right"><rect x="0" y="-20" width="70" height="40" /></clipPath>
        </defs>
        <text x="24" y="34" text-anchor="middle" class="pa-t-dim">Agents</text>
        {pvSources.map((key, i) => (
          <g>
            <circle cx="24" cy={pvLane[i]} r="14" class="pa-node" />
            <svg x="16" y={pvLane[i] - 8} width="16" height="16" viewBox="0 0 24 24"><path d={brand(key).path} fill-rule={brand(key).rule} fill={key === 'openai' ? '#ffffff' : `#${brand(key).hex}`} /></svg>
          </g>
        ))}
        <text x="372" y="34" text-anchor="middle" class="pa-t-dim">Systems</text>
        {pvTargets.map((target, i) => (
          <g>
            <rect x="355" y={pvLane[i] - 17} width="34" height="34" rx="10" class="pa-node" />
            <Fragment set:html={icon(target.icon, 363, pvLane[i] - 9, 18)} />
            <text x="372" y={pvLane[i] + 28} text-anchor="middle" class="pa-t-xs">{target.label}</text>
          </g>
        ))}

        <circle cx="204" cy="124" r="46" class="pa-shield-ring" />
        {pvItems.map((item, i) => (
          <circle cx="204" cy="124" r="36" class={item.bad ? 'pv-flash' : 'pv-pulse'} style={`animation-delay:${i * 2}s;--still:${item.still}s`} />
        ))}
        <circle cx="204" cy="124" r="34" class="pa-chain" />
        <svg x="184" y="104" width="40" height="40" viewBox="84 92 1086 1086" class="pv-logo" aria-hidden="true">
          <circle cx="627" cy="613" r="503" fill="none" stroke="currentColor" stroke-width="56" />
          <path d="M376 335H728A185 199 0 0 1 728 733H665V980L552 848V613H722A79 79 0 0 0 722 455H497V710L376 567Z" fill="currentColor" />
        </svg>
        <text x="204" y="190" text-anchor="middle" class="pa-t-w">Pavii</text>
        <text x="204" y="203" text-anchor="middle" class="pa-t-dim">6 security gates</text>
        {pvItems.filter(item => item.bad).map(item => (
          <g class="pv-reason" style={`animation-delay:${pvItems.indexOf(item) * 2}s;--still:${item.still}s`}>
            <rect x="136" y="214" width="136" height="22" rx="11" class="pv-reason-bg" />
            <text x="204" y="229" text-anchor="middle" class="pv-reason-t">Blocked: {item.reason}</text>
          </g>
        ))}

        {pvItems.map((item, i) => {
          const timing = `animation-delay:${i * 2}s;--still:${item.still}s`;
          const parts = item.bad ? ['pv-half pv-half-l', 'pv-half pv-half-r'] : ['pv-whole'];
          return (
            <g class:list={['pv-item', item.bad ? 'pv-bad' : 'pv-good']} style={`--y0:${pvLane[item.from]}px;--y1:${pvLane[item.to ?? 1]}px;${timing}`}>
              {parts.map(part => (
                <g class={part} clip-path={part.endsWith('-l') ? 'url(#pv-left)' : part.endsWith('-r') ? 'url(#pv-right)' : undefined} style={timing}>
                  <rect x="-60" y="-14" width="120" height="28" rx="14" class="pv-pill" />
                  <rect x="-60" y="-14" width="120" height="28" rx="14" class={item.bad ? 'pv-red' : 'pv-ok-ring'} style={timing} />
                  <circle cx="-45" cy="0" r="10" class={item.tool ? 'pv-ic-tool' : 'pv-ic-prompt'} />
                  <Fragment set:html={icon(item.tool ? 'wrench' : 'chat-circle-text', -52, -7, 14, 'pa-ic-w')} />
                  <text x="-31" y="-2.5" class="pv-kind">{item.tool ? 'TOOL CALL' : 'PROMPT'}</text>
                  <text x="-31" y="8" class="pv-label">{item.label}</text>
                </g>
              ))}
              {item.bad && <path d="M0 -14 L-3 -6 L2 -1 L-2 5 L1 14" class="pv-crack" style={timing} />}
              {!item.bad && (
                <g class="pv-check" style={timing}>
                  <circle cx="56" cy="-12" r="7" />
                  <path d="M52.6 -12 L55 -9.6 L59.4 -14" />
                </g>
              )}
            </g>
          );
        })}
      </g>
    )}

    {product === 'hyper-wallet' && (
      <g>
        <rect x="140" y="20" width="120" height="220" rx="22" class="pa-phone" />
        <text x="200" y="52" text-anchor="middle" class="pa-t-dim">Swap</text>
        <g class="pa-swap-a"><rect x="154" y="66" width="92" height="40" rx="10" class="pa-node" /><Fragment set:html={icon('currency-eth', 162, 76, 20)} /><text x="190" y="91" class="pa-t">0.5 ETH</text></g>
        <g class="pa-swap-b"><rect x="154" y="122" width="92" height="40" rx="10" class="pa-node" /><Fragment set:html={icon('currency-circle-dollar', 162, 132, 20)} /><text x="190" y="147" class="pa-t">1,250 USDC</text></g>
        <g class="pa-settled"><rect x="154" y="184" width="92" height="32" rx="10" class="pa-ok-bg" /><text x="200" y="204" text-anchor="middle" class="pa-t-ok">Settled · both legs</text></g>
        <rect x="24" y="92" width="96" height="40" rx="12" class="pa-node" /><text x="72" y="117" text-anchor="middle" class="pa-t">Many chains</text>
        <rect x="280" y="92" width="96" height="40" rx="12" class="pa-chain" /><text x="328" y="117" text-anchor="middle" class="pa-t-w">Hyper 0X</text>
      </g>
    )}

    {product === 'h0x-pay' && (
      <g>
        <rect x="30" y="70" width="140" height="88" rx="16" class="pa-node" />
        <Fragment set:html={icon('storefront', 44, 84, 22)} />
        <text x="74" y="100" class="pa-t">Coffee shop</text>
        <text x="44" y="138" class="pa-t-big">$40.00</text>
        <g class="pa-slice"><rect x="-26" y="-12" width="52" height="24" rx="12" class="pa-accent-bg" /><text y="4" text-anchor="middle" class="pa-t-w">$0.80</text></g>
        <rect x="250" y="50" width="120" height="160" rx="18" class="pa-node" />
        <text x="310" y="78" text-anchor="middle" class="pa-t-dim">Gold balance</text>
        <rect x="270" y="130" width="80" height="60" rx="6" class="pa-gold" />
        <Fragment set:html={icon('diamond', 298, 92, 24)} />
      </g>
    )}

    {product === 'hyperrun' && (
      <g>
        <rect x="24" y="60" width="150" height="140" rx="18" class="pa-node" />
        <Fragment set:html={icon('crosshair', 74, 82, 52, 'pa-ic-accent')} />
        <text x="99" y="166" text-anchor="middle" class="pa-t">Match · Ava wins</text>
        <g class="pa-signed"><rect x="190" y="112" width="76" height="34" rx="17" class="pa-ok-bg" /><text x="228" y="134" text-anchor="middle" class="pa-t-ok">Signed</text></g>
        <rect x="286" y="80" width="96" height="100" rx="18" class="pa-chain" />
        <Fragment set:html={icon('trophy', 314, 96, 40, 'pa-ic-w')} />
        <text x="334" y="160" text-anchor="middle" class="pa-t-w">Reward</text>
        {[0, 1, 2].map(i => <circle cx={318 + i * 16} cy="200" r="6" class="pa-coin" style={`animation-delay:${i * 0.25}s`} />)}
      </g>
    )}
  </svg>
</div>

<style is:global>
  .pa { --pa-accent: var(--accent-500); }
  .pa-node { fill: #1a1d23; stroke: #2c313a; stroke-width: 1.5; }
  .pa-chain { fill: var(--pa-accent); }
  .pa-phone { fill: #15171c; stroke: #2c313a; stroke-width: 2; }
  .pa-line { stroke: #2c313a; stroke-width: 1.5; stroke-dasharray: 3 5; }
  .pa-t { fill: #e8e9ee; font-size: 12px; font-weight: 600; font-family: var(--font-sans); }
  .pa-t-w { fill: #fff; font-size: 12px; font-weight: 650; font-family: var(--font-sans); }
  .pa-t-dim { fill: #8b8f99; font-size: 11px; font-family: var(--font-sans); }
  .pa-t-big { fill: #fff; font-size: 20px; font-weight: 700; font-family: var(--font-display); }
  .pa-t-ok { fill: #34d399; font-size: 11px; font-weight: 650; font-family: var(--font-sans); }
  .pa-ok-bg { fill: rgb(52 211 153 / 0.14); }
  .pa-accent-bg { fill: var(--pa-accent); }
  .pa-ic { color: #c9ccd4; }
  .pa-ic-w { color: #fff; }
  .pa-ic-accent { color: var(--pa-accent); }

  /* hyper-0x */
  .pa-block { fill: var(--pa-accent); }
  .pa-stack { fill: #fff; opacity: 0.25; animation: pa-stack 2s ease-in-out infinite; }
  @keyframes pa-stack { 50% { opacity: 0.95; } }

  /* pavii */
  .pa-t-xs { fill: #8b8f99; font-size: 9px; font-family: var(--font-sans); }
  .pa-shield-ring { fill: none; stroke: var(--pa-accent); stroke-width: 2; stroke-dasharray: 8 7; transform-origin: 204px 124px; animation: pa-spin 14s linear infinite; }
  @keyframes pa-spin { to { transform: rotate(360deg); } }
  .pv-logo { color: #fff; }
  .pv-item, .pv-half, .pv-red, .pv-ok-ring, .pv-crack, .pv-check, .pv-flash, .pv-pulse, .pv-reason { animation-duration: 12s; animation-iteration-count: infinite; animation-fill-mode: both; }
  .pv-pill { fill: #1a1d23; stroke: #343a45; stroke-width: 1.2; }
  .pv-kind { fill: #8b8f99; font-size: 7px; font-weight: 600; letter-spacing: 0.08em; font-family: var(--font-mono); }
  .pv-label { fill: #eef0f4; font-size: 9.5px; font-weight: 600; font-family: var(--font-sans); }
  .pv-ic-prompt { fill: #3b5bdb; }
  .pv-ic-tool { fill: #a16207; }
  .pv-good { animation-name: pv-good; animation-timing-function: cubic-bezier(0.45, 0, 0.25, 1); }
  @keyframes pv-good {
    0% { transform: translate(48px, var(--y0)) scale(0.55); opacity: 0; }
    3% { opacity: 1; }
    14% { transform: translate(96px, 124px) scale(1); }
    19% { transform: translate(204px, 124px) scale(0.6); }
    24% { transform: translate(296px, var(--y1)) scale(0.85); opacity: 1; }
    31% { transform: translate(356px, var(--y1)) scale(0.3); opacity: 0.9; }
    33%, 100% { transform: translate(372px, var(--y1)) scale(0.2); opacity: 0; }
  }
  .pv-bad { animation-name: pv-bad; animation-timing-function: cubic-bezier(0.45, 0, 0.25, 1); }
  @keyframes pv-bad {
    0% { transform: translate(48px, var(--y0)) scale(0.55); opacity: 0; }
    3% { opacity: 1; }
    14% { transform: translate(96px, 124px) scale(1); }
    15% { transform: translate(91px, 124px); }
    16% { transform: translate(100px, 124px); }
    17% { transform: translate(93px, 124px); }
    18%, 32% { transform: translate(96px, 124px); opacity: 1; }
    34%, 100% { transform: translate(96px, 124px); opacity: 0; }
  }
  .pv-ok-ring { fill: none; stroke: #34d399; stroke-width: 1.6; opacity: 0; animation-name: pv-ok; }
  .pv-check { opacity: 0; animation-name: pv-ok; }
  .pv-check circle { fill: #10b981; }
  .pv-check path { fill: none; stroke: #04150e; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  @keyframes pv-ok { 0%, 17% { opacity: 0; } 19%, 100% { opacity: 1; } }
  .pv-red { fill: rgb(239 68 68 / 0.2); stroke: #ef4444; stroke-width: 1.6; opacity: 0; animation-name: pv-red; }
  @keyframes pv-red { 0%, 13.5% { opacity: 0; } 14.5%, 100% { opacity: 1; } }
  .pv-crack { fill: none; stroke: #fca5a5; stroke-width: 1.4; stroke-linejoin: round; opacity: 0; animation-name: pv-crack; }
  @keyframes pv-crack { 0%, 16.5% { opacity: 0; } 17.5%, 19% { opacity: 1; } 20%, 100% { opacity: 0; } }
  .pv-half { transform-box: fill-box; transform-origin: center; animation-timing-function: cubic-bezier(0.55, 0, 0.75, 0.4); }
  .pv-half-l { animation-name: pv-fall-l; }
  .pv-half-r { animation-name: pv-fall-r; }
  @keyframes pv-fall-l { 0%, 19% { transform: none; opacity: 1; } 31% { transform: translate(-14px, 86px) rotate(-34deg); opacity: 0; } 100% { opacity: 0; } }
  @keyframes pv-fall-r { 0%, 19% { transform: none; opacity: 1; } 31% { transform: translate(16px, 94px) rotate(28deg); opacity: 0; } 100% { opacity: 0; } }
  .pv-flash { fill: none; stroke: #ef4444; stroke-width: 6; opacity: 0; transform-origin: 204px 124px; animation-name: pv-flash; }
  @keyframes pv-flash { 0%, 13.8% { opacity: 0; transform: scale(1); } 15% { opacity: 0.85; } 23%, 100% { opacity: 0; transform: scale(1.3); } }
  .pv-pulse { fill: none; stroke: #34d399; stroke-width: 4; opacity: 0; transform-origin: 204px 124px; animation-name: pv-pulse; }
  @keyframes pv-pulse { 0%, 17% { opacity: 0; transform: scale(1); } 19% { opacity: 0.7; } 25%, 100% { opacity: 0; transform: scale(1.25); } }
  .pv-reason { opacity: 0; animation-name: pv-reason; }
  .pv-reason-bg { fill: rgb(239 68 68 / 0.16); stroke: rgb(239 68 68 / 0.5); }
  .pv-reason-t { fill: #fca5a5; font-size: 9.5px; font-weight: 650; font-family: var(--font-sans); }
  @keyframes pv-reason { 0%, 14.5% { opacity: 0; transform: translateY(4px); } 16%, 30% { opacity: 1; transform: none; } 33%, 100% { opacity: 0; } }

  /* hyper-wallet */
  .pa-swap-a { animation: pa-swap-a 4s ease-in-out infinite; }
  .pa-swap-b { animation: pa-swap-b 4s ease-in-out infinite; }
  @keyframes pa-swap-a { 0%, 30% { transform: translateY(0); } 50%, 80% { transform: translateY(56px); } 100% { transform: translateY(0); } }
  @keyframes pa-swap-b { 0%, 30% { transform: translateY(0); } 50%, 80% { transform: translateY(-56px); } 100% { transform: translateY(0); } }
  .pa-settled { opacity: 0; animation: pa-flash 4s ease-in-out infinite; }
  @keyframes pa-flash { 0%, 45% { opacity: 0; } 55%, 80% { opacity: 1; } 100% { opacity: 0; } }

  /* h0x-pay */
  .pa-slice { animation: pa-slice 3s cubic-bezier(0.4, 0, 0.2, 1) infinite; }
  @keyframes pa-slice { 0% { transform: translate(140px, 114px); opacity: 0; } 15% { opacity: 1; } 70% { transform: translate(310px, 170px); opacity: 1; } 85%, 100% { transform: translate(310px, 180px); opacity: 0; } }
  .pa-gold { fill: #f5c542; transform-box: fill-box; transform-origin: bottom; animation: pa-gold 3s ease-out infinite; }
  @keyframes pa-gold { 0%, 70% { transform: scaleY(0.55); } 85%, 100% { transform: scaleY(0.8); } }

  /* hyperrun */
  .pa-signed { opacity: 0; animation: pa-flash 3.6s ease-in-out infinite; }
  .pa-coin { fill: #f5c542; animation: pa-coin 1.8s ease-in-out infinite; }
  @keyframes pa-coin { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }

  @media (prefers-reduced-motion: reduce) {
    .pa *:not([class*='pv-']) { animation: none !important; }
    .pa [class*='pv-'] { animation-delay: var(--still, -8s) !important; animation-play-state: paused !important; }
    .pa-block { display: none; }
    .pa-settled, .pa-signed { opacity: 1; }
  }
</style>
