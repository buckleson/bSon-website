---
import { glyph } from '@utils/glyphs';

/**
 * Small looping scene per product (pure SVG + CSS, no JavaScript), used
 * wherever a product needs an image: home accordion, product cards.
 * - hyper-0x: three private L2s stream blocks into the shared L1.
 * - pavii: calls fly at a shield; red ones break, green ones pass.
 * - hyper-wallet: a trade settles both legs at once.
 * - h0x-pay: a payment drops a slice into a growing gold balance.
 * - hyperrun: a match result is signed and rewards pay out.
 */
interface Props {
  product: 'hyper-0x' | 'pavii' | 'hyper-wallet' | 'h0x-pay' | 'hyperrun';
  class?: string;
  /** Fill a positioned parent instead of sizing itself. */
  fill?: boolean;
}

const { product, class: className, fill = false } = Astro.props;
const icon = (name: string, x: number, y: number, size: number, cls = 'pa-ic') =>
  `<svg x="${x}" y="${y}" width="${size}" height="${size}" viewBox="0 0 256 256" class="${cls}">${glyph(name)}</svg>`;
---

<div class:list={['pa overflow-hidden rounded-[inherit] bg-[#0e1014]', fill ? 'absolute inset-0' : 'relative', className]} role="img" aria-label={`${product} animation`}>
  <svg viewBox="0 0 400 260" class="block h-full w-full" preserveAspectRatio="xMidYMid slice">
    <defs>
      <pattern id={`pa-grid-${product}`} width="20" height="20" patternUnits="userSpaceOnUse"><circle cx="1" cy="1" r="1" fill="#23272f" /></pattern>
    </defs>
    <rect width="400" height="260" fill={`url(#pa-grid-${product})`} />

    {product === 'hyper-0x' && (
      <g>
        {[70, 200, 330].map((x, i) => (
          <g>
            <rect x={x - 48} y="34" width="96" height="40" rx="12" class="pa-node" />
            <text x={x} y="59" text-anchor="middle" class="pa-t">{['Bank L2', 'Fintech L2', 'AI L2'][i]}</text>
            <line x1={x} y1="74" x2="200" y2="190" class="pa-line" />
            <rect x="-7" y="-7" width="14" height="14" rx="3" class="pa-block">
              <animateMotion dur="1.65s" begin={`${i * 0.55}s`} repeatCount="indefinite" path={`M${x},74 L200,190`} />
              <animate attributeName="opacity" values="0;1;1;0" keyTimes="0;0.15;0.9;1" dur="1.65s" begin={`${i * 0.55}s`} repeatCount="indefinite" />
            </rect>
          </g>
        ))}
        <rect x="70" y="190" width="260" height="44" rx="14" class="pa-chain" />
        <Fragment set:html={icon('cube', 92, 202, 20, 'pa-ic-w')} />
        <text x="122" y="217" class="pa-t-w">Hyper 0X L1 · final</text>
        {[0, 1, 2, 3, 4].map(i => <rect x={250 + i * 14} y="204" width="10" height="16" rx="2" class="pa-stack" style={`animation-delay:${i * 0.4}s`} />)}
      </g>
    )}

    {product === 'pavii' && (
      <g>
        {['Prompt', 'Tool call', 'Email'].map((label, i) => (
          <g class:list={['pa-call', i === 1 && 'pa-call--bad']} style={`animation-delay:${i * 1.1}s`}>
            <rect x="-34" y="-12" width="68" height="24" rx="12" />
            <text y="4" text-anchor="middle">{label}</text>
          </g>
        ))}
        <circle cx="200" cy="130" r="52" class="pa-shield-ring" />
        <circle cx="200" cy="130" r="34" class="pa-chain" />
        <Fragment set:html={icon('shield-check', 184, 114, 32, 'pa-ic-w')} />
        <rect x="300" y="108" width="84" height="44" rx="12" class="pa-node" />
        <Fragment set:html={icon('database', 310, 120, 20)} />
        <text x="336" y="134" class="pa-t">Systems</text>
      </g>
    )}

    {product === 'hyper-wallet' && (
      <g>
        <rect x="140" y="20" width="120" height="220" rx="22" class="pa-phone" />
        <text x="200" y="52" text-anchor="middle" class="pa-t-dim">Swap</text>
        <g class="pa-swap-a"><rect x="154" y="66" width="92" height="40" rx="10" class="pa-node" /><Fragment set:html={icon('currency-eth', 162, 76, 20)} /><text x="190" y="91" class="pa-t">0.5 ETH</text></g>
        <g class="pa-swap-b"><rect x="154" y="122" width="92" height="40" rx="10" class="pa-node" /><Fragment set:html={icon('currency-circle-dollar', 162, 132, 20)} /><text x="190" y="147" class="pa-t">1,250 USDC</text></g>
        <g class="pa-settled"><rect x="154" y="184" width="92" height="32" rx="10" class="pa-ok-bg" /><text x="200" y="204" text-anchor="middle" class="pa-t-ok">Settled · both legs</text></g>
        <rect x="24" y="92" width="96" height="40" rx="12" class="pa-node" /><text x="72" y="117" text-anchor="middle" class="pa-t">20+ chains</text>
        <rect x="280" y="92" width="96" height="40" rx="12" class="pa-chain" /><text x="328" y="117" text-anchor="middle" class="pa-t-w">Hyper 0X</text>
      </g>
    )}

    {product === 'h0x-pay' && (
      <g>
        <rect x="30" y="70" width="140" height="88" rx="16" class="pa-node" />
        <Fragment set:html={icon('storefront', 44, 84, 22)} />
        <text x="74" y="100" class="pa-t">Coffee shop</text>
        <text x="44" y="138" class="pa-t-big">$40.00</text>
        <g class="pa-slice"><rect x="-26" y="-12" width="52" height="24" rx="12" class="pa-accent-bg" /><text y="4" text-anchor="middle" class="pa-t-w">$0.80</text></g>
        <rect x="250" y="50" width="120" height="160" rx="18" class="pa-node" />
        <text x="310" y="78" text-anchor="middle" class="pa-t-dim">Gold balance</text>
        <rect x="270" y="130" width="80" height="60" rx="6" class="pa-gold" />
        <Fragment set:html={icon('diamond', 298, 92, 24)} />
      </g>
    )}

    {product === 'hyperrun' && (
      <g>
        <rect x="24" y="60" width="150" height="140" rx="18" class="pa-node" />
        <Fragment set:html={icon('crosshair', 74, 82, 52, 'pa-ic-accent')} />
        <text x="99" y="166" text-anchor="middle" class="pa-t">Match · Ava wins</text>
        <g class="pa-signed"><rect x="190" y="112" width="76" height="34" rx="17" class="pa-ok-bg" /><text x="228" y="134" text-anchor="middle" class="pa-t-ok">Signed</text></g>
        <rect x="286" y="80" width="96" height="100" rx="18" class="pa-chain" />
        <Fragment set:html={icon('trophy', 314, 96, 40, 'pa-ic-w')} />
        <text x="334" y="160" text-anchor="middle" class="pa-t-w">Reward</text>
        {[0, 1, 2].map(i => <circle cx={318 + i * 16} cy="200" r="6" class="pa-coin" style={`animation-delay:${i * 0.25}s`} />)}
      </g>
    )}
  </svg>
</div>

<style is:global>
  .pa { --pa-accent: var(--accent-500); }
  .pa-node { fill: #1a1d23; stroke: #2c313a; stroke-width: 1.5; }
  .pa-chain { fill: var(--pa-accent); }
  .pa-phone { fill: #15171c; stroke: #2c313a; stroke-width: 2; }
  .pa-line { stroke: #2c313a; stroke-width: 1.5; stroke-dasharray: 3 5; }
  .pa-t { fill: #e8e9ee; font-size: 12px; font-weight: 600; font-family: var(--font-sans); }
  .pa-t-w { fill: #fff; font-size: 12px; font-weight: 650; font-family: var(--font-sans); }
  .pa-t-dim { fill: #8b8f99; font-size: 11px; font-family: var(--font-sans); }
  .pa-t-big { fill: #fff; font-size: 20px; font-weight: 700; font-family: var(--font-display); }
  .pa-t-ok { fill: #34d399; font-size: 11px; font-weight: 650; font-family: var(--font-sans); }
  .pa-ok-bg { fill: rgb(52 211 153 / 0.14); }
  .pa-accent-bg { fill: var(--pa-accent); }
  .pa-ic { color: #c9ccd4; }
  .pa-ic-w { color: #fff; }
  .pa-ic-accent { color: var(--pa-accent); }

  /* hyper-0x */
  .pa-block { fill: var(--pa-accent); }
  .pa-stack { fill: #fff; opacity: 0.25; animation: pa-stack 2s ease-in-out infinite; }
  @keyframes pa-stack { 50% { opacity: 0.95; } }

  /* pavii */
  .pa-call { animation: pa-call 3.3s cubic-bezier(0.4, 0, 0.2, 1) infinite; }
  .pa-call rect { fill: #10b981; }
  .pa-call text { fill: #04150e; font-size: 11px; font-weight: 700; font-family: var(--font-sans); }
  @keyframes pa-call { 0% { transform: translate(40px, 130px); opacity: 0; } 10% { opacity: 1; } 45% { transform: translate(140px, 130px); } 100% { transform: translate(300px, 130px); opacity: 0; } }
  .pa-call--bad { animation-name: pa-call-bad; }
  .pa-call--bad rect { fill: #ef4444; }
  .pa-call--bad text { fill: #1a0505; }
  @keyframes pa-call-bad { 0% { transform: translate(40px, 130px); opacity: 0; } 10% { opacity: 1; } 45% { transform: translate(140px, 130px) scale(1); opacity: 1; } 60% { transform: translate(140px, 130px) scale(1.4); opacity: 0; } 100% { opacity: 0; } }
  .pa-shield-ring { fill: none; stroke: var(--pa-accent); stroke-width: 2; stroke-dasharray: 8 7; transform-origin: 200px 130px; animation: pa-spin 14s linear infinite; }
  @keyframes pa-spin { to { transform: rotate(360deg); } }

  /* hyper-wallet */
  .pa-swap-a { animation: pa-swap-a 4s ease-in-out infinite; }
  .pa-swap-b { animation: pa-swap-b 4s ease-in-out infinite; }
  @keyframes pa-swap-a { 0%, 30% { transform: translateY(0); } 50%, 80% { transform: translateY(56px); } 100% { transform: translateY(0); } }
  @keyframes pa-swap-b { 0%, 30% { transform: translateY(0); } 50%, 80% { transform: translateY(-56px); } 100% { transform: translateY(0); } }
  .pa-settled { opacity: 0; animation: pa-flash 4s ease-in-out infinite; }
  @keyframes pa-flash { 0%, 45% { opacity: 0; } 55%, 80% { opacity: 1; } 100% { opacity: 0; } }

  /* h0x-pay */
  .pa-slice { animation: pa-slice 3s cubic-bezier(0.4, 0, 0.2, 1) infinite; }
  @keyframes pa-slice { 0% { transform: translate(140px, 114px); opacity: 0; } 15% { opacity: 1; } 70% { transform: translate(310px, 170px); opacity: 1; } 85%, 100% { transform: translate(310px, 180px); opacity: 0; } }
  .pa-gold { fill: #f5c542; transform-box: fill-box; transform-origin: bottom; animation: pa-gold 3s ease-out infinite; }
  @keyframes pa-gold { 0%, 70% { transform: scaleY(0.55); } 85%, 100% { transform: scaleY(0.8); } }

  /* hyperrun */
  .pa-signed { opacity: 0; animation: pa-flash 3.6s ease-in-out infinite; }
  .pa-coin { fill: #f5c542; animation: pa-coin 1.8s ease-in-out infinite; }
  @keyframes pa-coin { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }

  @media (prefers-reduced-motion: reduce) {
    .pa * { animation: none !important; }
    .pa-block { display: none; }
    .pa-settled, .pa-signed { opacity: 1; }
  }
</style>
