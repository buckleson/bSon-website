---
import Glyph from '@components/ui/Glyph.astro';

/**
 * Features as a bento grid. The first card is the lead: a dark panel with a
 * real number (or the first feature) and a row of chips; the others vary in
 * size by how many there are, each with an icon tile, a large faded icon
 * and a soft spotlight that follows the pointer.
 */
interface Item {
  icon?: string;
  title: string;
  text: string;
}
interface Props {
  items: Item[];
  highlight?: { value: string; label: string };
  chips?: string[];
  class?: string;
}

const { items, highlight, chips = [], class: className } = Astro.props;
// Column spans on the 12-column grid, by the number of cards.
const spans: Record<number, string[]> = {
  2: ['lg:col-span-7', 'lg:col-span-5'],
  3: ['lg:col-span-7 lg:row-span-2', 'lg:col-span-5', 'lg:col-span-5'],
  4: ['lg:col-span-7 lg:row-span-2', 'lg:col-span-5', 'lg:col-span-5', 'lg:col-span-12'],
  5: ['lg:col-span-7 lg:row-span-2', 'lg:col-span-5', 'lg:col-span-5', 'lg:col-span-6', 'lg:col-span-6'],
  6: ['lg:col-span-7 lg:row-span-2', 'lg:col-span-5', 'lg:col-span-5', 'lg:col-span-4', 'lg:col-span-4', 'lg:col-span-4'],
};
const layout = spans[Math.min(6, Math.max(2, items.length))];
const [lead, ...rest] = items;
---

<div class:list={['grid grid-cols-1 gap-3 md:grid-cols-2 lg:grid-cols-12', className]} data-bento data-reveal-group>
  <article class:list={['bento-card bento-lead accent-warm relative flex flex-col overflow-hidden rounded-[1.8rem] bg-sheet p-7 text-white sm:p-8 md:col-span-2', layout[0]]} data-reveal-item>
    <span class="bento-mark" aria-hidden="true">{lead.icon && <Glyph icon={lead.icon} class="size-full" />}</span>
    <span class="grid size-12 place-items-center rounded-2xl bg-white/10 text-orange-300">{lead.icon && <Glyph icon={lead.icon} class="size-6" />}</span>
    {highlight && (
      <p class="mt-8 font-display text-[clamp(3rem,7vw,5.5rem)] leading-[0.9] font-semibold tracking-tight text-orange-300 tabular-nums">{highlight.value}</p>
    )}
    {highlight && <p class="mt-2 max-w-[28ch] text-white/70">{highlight.label}</p>}
    <div class="mt-auto pt-10">
      <h3 class="text-2xl leading-tight font-semibold text-balance sm:text-3xl">{lead.title}</h3>
      <p class="mt-3 max-w-[48ch] leading-relaxed text-pretty text-white/70">{lead.text}</p>
      {chips.length > 0 && (
        <ul class="mt-6 flex flex-wrap gap-2">
          {chips.map(chip => <li class="rounded-full bg-white/10 px-3 py-1 text-xs font-semibold text-white/85">{chip}</li>)}
        </ul>
      )}
    </div>
  </article>
  {rest.map((item, i) => (
    <article class:list={['bento-card glass-card group relative flex flex-col overflow-hidden rounded-[1.8rem] p-6 transition duration-300 hover:-translate-y-0.5 sm:p-7', layout[i + 1], rest.length % 2 === 1 && i === rest.length - 1 ? 'md:col-span-2' : '']} data-reveal-item>
      <span class="bento-mark text-ink" aria-hidden="true">{item.icon && <Glyph icon={item.icon} class="size-full" />}</span>
      <span class="grid size-11 place-items-center rounded-xl bg-orange-100 text-orange-700 transition duration-300 group-hover:bg-orange-600 group-hover:text-white dark:bg-orange-950 dark:text-orange-300 dark:group-hover:bg-orange-700">{item.icon && <Glyph icon={item.icon} class="size-5" />}</span>
      <h3 class="mt-6 text-lg font-semibold text-balance text-ink">{item.title}</h3>
      <p class="mt-2 max-w-[52ch] text-sm leading-relaxed text-pretty text-muted">{item.text}</p>
    </article>
  ))}
</div>

<style>
  .bento-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(22rem circle at var(--mx, 50%) var(--my, -30%), color-mix(in oklab, var(--accent-500) 10%, transparent), transparent 60%);
    opacity: 0;
    transition: opacity 300ms ease;
    pointer-events: none;
  }
  .bento-card:hover::before { opacity: 1; }
  .bento-mark { position: absolute; right: -1.5rem; bottom: -1.75rem; width: 9rem; height: 9rem; opacity: 0.05; transform: rotate(-12deg); pointer-events: none; }
  .bento-lead .bento-mark { width: 16rem; height: 16rem; right: -2.5rem; bottom: auto; top: -2.5rem; opacity: 0.07; color: #fff; }
  .bento-lead::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgb(255 255 255 / 0.07) 1px, transparent 1.2px);
    background-size: 20px 20px;
    mask-image: linear-gradient(to bottom, #000, transparent 70%);
    pointer-events: none;
  }
  @media (prefers-reduced-motion: reduce) { .bento-card { transition: none; } }
</style>

<script>
  // The spotlight follows the pointer inside each card.
  document.querySelectorAll<HTMLElement>('[data-bento]').forEach(grid => {
    grid.addEventListener('pointermove', event => {
      const card = (event.target as HTMLElement).closest<HTMLElement>('.bento-card');
      if (!card) return;
      const r = card.getBoundingClientRect();
      card.style.setProperty('--mx', `${event.clientX - r.left}px`);
      card.style.setProperty('--my', `${event.clientY - r.top}px`);
    });
  });
</script>
