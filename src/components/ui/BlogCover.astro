---
/**
 * Generated cover art for a blog post: a small block network drawn from the
 * post's slug (so every post gets its own, stable pattern) with the topic
 * label. Follows the theme accent; no photo needed.
 */
interface Props {
  seed: string;
  label: string;
  class?: string;
  /** Fill a positioned parent (cover-style) instead of sizing itself. */
  fill?: boolean;
}

const { seed, label, class: className, fill = false } = Astro.props;

// Deterministic pseudo-random numbers from the slug.
let h = 2166136261;
for (const ch of seed) h = Math.imul(h ^ ch.charCodeAt(0), 16777619);
const rand = () => {
  h = Math.imul(h ^ (h >>> 15), 2246822507);
  h = Math.imul(h ^ (h >>> 13), 3266489909);
  return ((h ^= h >>> 16) >>> 0) / 4294967296;
};

const W = 800;
const H = 450;
const nodes = Array.from({ length: 9 }, (_, i) => ({
  x: 90 + (i % 3) * 260 + (rand() - 0.5) * 120,
  y: 70 + Math.floor(i / 3) * 120 + (rand() - 0.5) * 60,
  s: 18 + rand() * 18,
}));
const edges = nodes.flatMap((n, i) =>
  nodes.slice(i + 1).filter(() => rand() > 0.72).map(m => [n, m] as const)
);
const hero = Math.floor(rand() * nodes.length);
---

<svg
  class:list={['blog-cover block', fill ? 'absolute inset-0 size-full' : 'h-auto w-full', className]}
  viewBox={`0 0 ${W} ${H}`}
  role={label ? 'img' : undefined}
  aria-label={label ? `${label} illustration` : undefined}
  aria-hidden={label ? undefined : 'true'}
  preserveAspectRatio="xMidYMid slice"
>
  <rect width={W} height={H} class="fill-orange-50 dark:fill-[#0b0f1a]" />
  <g class="stroke-orange-300 dark:stroke-orange-900" stroke-width="2">
    {edges.map(([a, b]) => <line x1={a.x} y1={a.y} x2={b.x} y2={b.y} />)}
  </g>
  {nodes.map((n, i) => (
    <rect
      x={n.x - n.s / 2}
      y={n.y - n.s / 2}
      width={n.s}
      height={n.s}
      rx="5"
      class={i === hero ? 'fill-orange-600 dark:fill-orange-500' : 'fill-white stroke-orange-400 dark:fill-[#161b26] dark:stroke-orange-700'}
      stroke-width="2"
    />
  ))}
  <text x="40" y={H - 40} class="fill-orange-900 dark:fill-orange-200" font-size="34" font-weight="700">
    {label}
  </text>
</svg>
