---
import BlogCover from '@components/ui/BlogCover.astro';
import { formatDate } from '@utils/utils';
import { localeOf, pathFor, slugOf } from '@utils/content';
import type { CollectionEntry } from 'astro:content';

/** A blog post card: generated cover, topic, title, summary and date. */
interface Props {
  post: CollectionEntry<'blog'>;
  featured?: boolean;
  headingLevel?: 'h2' | 'h3';
}

const { post, featured = false, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
const topic = post.data.tags[0] ?? 'Hyper 0X';
---

<a
  href={pathFor(post)}
  data-astro-prefetch
  class:list={[
    'group flex flex-col overflow-hidden rounded-2xl bg-white ring-1 ring-neutral-900/10 transition duration-300 hover:-translate-y-1 hover:shadow-[0_18px_40px_-20px_rgb(30_16_60/0.35)] focus-visible:ring-3 focus-visible:ring-orange-500 focus-visible:outline-hidden dark:bg-neutral-900 dark:ring-white/10',
    featured && 'lg:flex-row',
  ]}
>
  <div class:list={['overflow-hidden', featured && 'lg:w-1/2']}>
    <BlogCover seed={slugOf(post)} label={topic} class="transition duration-500 group-hover:scale-[1.03]" />
  </div>
  <div class:list={['flex flex-1 flex-col p-5 sm:p-6', featured && 'lg:justify-center lg:p-10']}>
    <p class="text-sm text-neutral-500 dark:text-neutral-400">
      <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, localeOf(post))}</time>
      <span aria-hidden="true"> · </span>{post.data.readTime} min read
    </p>
    <Heading
      class:list={[
        'mt-2 font-bold text-balance text-neutral-900 group-hover:text-orange-700 dark:text-neutral-100 dark:group-hover:text-orange-300',
        featured ? 'text-2xl sm:text-3xl' : 'text-lg sm:text-xl',
      ]}
    >
      {post.data.title}
    </Heading>
    <p class="mt-2 text-pretty text-neutral-600 dark:text-neutral-400">{post.data.description}</p>
  </div>
</a>
