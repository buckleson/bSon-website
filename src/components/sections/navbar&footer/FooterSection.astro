---
import BrandLogo from '@components/BrandLogo.astro';
import PrimaryCTA from '@components/ui/buttons/PrimaryCTA.astro';
import { BOOKING_URL, SITE } from '@data/constants';
import { footerColumns } from '@data/navigation';
import { localePath } from '@utils/locale';

const { locale, copy: t } = Astro.locals;
const year = new Date().getFullYear();
---

<footer class="w-full border-t border-neutral-300 bg-white dark:border-neutral-700 dark:bg-neutral-900">
  <div class="mx-auto w-full max-w-[85rem] px-4 py-14 sm:px-6 lg:px-8 lg:pt-20">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,2fr)_repeat(3,minmax(0,1fr))]">
      <div class="max-w-sm">
        <BrandLogo />
        <p class="mt-4 text-pretty text-neutral-600 dark:text-neutral-400">{t.site.description}</p>
        <div class="mt-6"><PrimaryCTA title="Book a call" url={BOOKING_URL} /></div>
      </div>
      {footerColumns.map(column => (
        <div>
          <h2 class="font-semibold text-neutral-900 dark:text-neutral-100">{column.title}</h2>
          <ul class="mt-4 space-y-3">
            {column.links.map(link => (
              <li>
                <a
                  href={localePath(locale, link.path)}
                  class="text-neutral-600 transition hover:text-orange-700 dark:text-neutral-400 dark:hover:text-orange-300"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <div class="mt-12 flex flex-wrap items-center justify-between gap-4 border-t border-neutral-200 pt-6 text-sm text-neutral-600 dark:border-neutral-800 dark:text-neutral-400">
      <p>© {year} {SITE.title}. All rights reserved.</p>
      <a href="mailto:vijay@buckleson.com" class="hover:text-orange-700 dark:hover:text-orange-300">vijay@buckleson.com</a>
    </div>
  </div>
</footer>
