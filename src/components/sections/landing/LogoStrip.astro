---
import Glyph from '@components/ui/Glyph.astro';
import { brand, type BrandKey } from '@utils/glyphs';

/** "Connects to": chains, exchanges and AI models Hyper 0X works with. */
interface Props {
  title: string;
}

const { title } = Astro.props;
const logos: BrandKey[] = ['ethereum', 'bitcoin', 'solana', 'sui', 'tether', 'binance', 'coinbase', 'claude', 'gemini', 'openai'];
---

<section class="mx-auto max-w-[85rem] px-4 py-6 sm:px-6 lg:px-8" aria-label={title}>
  <div class="flex flex-col gap-4 border-y border-neutral-300 py-5 md:flex-row md:items-center md:gap-8 dark:border-neutral-700">
    <p class="shrink-0 text-xs font-semibold tracking-wide text-neutral-600 uppercase dark:text-neutral-400">{title}</p>
    <ul class="flex flex-wrap items-center gap-x-6 gap-y-3" data-reveal-group>
      {logos.map(key => (
        <li class="flex items-center gap-2 text-neutral-500 transition hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100" data-reveal-item>
          <Glyph brand={key} class="size-5" />
          <span class="text-sm font-medium">{brand(key).title}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
