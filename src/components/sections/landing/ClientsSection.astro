---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const { title, subTitle, partners } = Astro.props;

interface Partner {
  logo?: ImageMetadata;
  name: string;
  tagline: string;
  href?: string;
  soon?: boolean;
}

interface Props {
  title: string;
  subTitle?: string;
  partners: Partner[];
}
---

<section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full">
  <div class="mx-auto mb-10 max-w-2xl space-y-2 text-center">
    <h2 class="text-2xl leading-tight font-bold text-balance text-neutral-800 sm:text-3xl dark:text-neutral-200">
      {title}
    </h2>
    {subTitle && (
      <p class="text-pretty text-neutral-600 dark:text-neutral-400">
        {subTitle}
      </p>
    )}
  </div>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
    {partners.map(partner => (
      <a
        href={partner.href}
        class:list={[
          'group flex flex-col gap-4 rounded-2xl border p-5 transition duration-300',
          partner.soon
            ? 'border-dashed border-neutral-300 bg-transparent hover:border-orange-400 dark:border-neutral-700'
            : 'border-neutral-200 bg-white shadow-xs hover:-translate-y-1 hover:border-orange-300 hover:shadow-lg dark:border-neutral-700 dark:bg-neutral-900',
        ]}
      >
        <div class="flex items-center justify-between">
          {partner.logo ? (
            <Image
              src={partner.logo}
              alt=""
              width={48}
              height={48}
              class="size-12 rounded-xl bg-white object-contain p-1 ring-1 ring-neutral-200 dark:ring-neutral-700"
            />
          ) : (
            <span class="flex size-12 items-center justify-center rounded-xl bg-orange-100 text-sm font-bold text-orange-700 dark:bg-orange-950 dark:text-orange-300">
              {partner.name.slice(0, 2)}
            </span>
          )}
          {partner.soon && (
            <span class="rounded-full bg-orange-100 px-2.5 py-1 text-xs font-semibold text-orange-700 dark:bg-orange-950 dark:text-orange-300">
              Coming soon
            </span>
          )}
        </div>
        <div>
          <p class="font-bold text-neutral-800 group-hover:text-orange-600 dark:text-neutral-200 dark:group-hover:text-orange-400">
            {partner.name}
          </p>
          <p class="mt-1 text-sm text-neutral-600 dark:text-neutral-400">{partner.tagline}</p>
        </div>
      </a>
    ))}
  </div>
</section>
