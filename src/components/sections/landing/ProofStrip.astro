---
import Glyph from '@components/ui/Glyph.astro';

/** Proof in one band: four live numbers and the enterprise pilot. */
interface Props {
  title: string;
  stats: { count: string; description: string; icon: string }[];
  quote: { content: string; author: string; role: string };
}

const { title, stats, quote } = Astro.props;
---

<section class="mx-auto max-w-[85rem] px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
  <div class="rounded-3xl bg-neutral-900 p-6 text-white sm:p-10 dark:bg-neutral-950 dark:ring-1 dark:ring-white/10">
    <h2 class="text-2xl font-bold tracking-tight sm:text-3xl" data-reveal>{title}</h2>
    <dl class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4" data-reveal-group>
      {stats.map(stat => (
        <div class="flex gap-3" data-reveal-item>
          <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-white/10 text-orange-300">
            <Glyph icon={stat.icon} class="size-5" />
          </span>
          <div>
            <dt class="sr-only">{stat.description}</dt>
            <dd class="font-display text-3xl font-bold tabular-nums">{stat.count}</dd>
            <dd class="mt-0.5 text-sm text-neutral-300">{stat.description}</dd>
          </div>
        </div>
      ))}
    </dl>
    <figure class="mt-8 border-t border-white/15 pt-6" data-reveal>
      <blockquote class="max-w-3xl text-pretty text-neutral-200">{quote.content}</blockquote>
      <figcaption class="mt-3 text-sm"><span class="font-semibold text-white">{quote.author}</span> <span class="text-neutral-400">· {quote.role}</span></figcaption>
    </figure>
  </div>
</section>
