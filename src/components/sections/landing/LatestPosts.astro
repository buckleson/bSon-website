---
import PostCard from '@components/ui/cards/PostCard.astro';
import { entriesFor } from '@utils/content';
import { localePath } from '@utils/locale';

/** The three newest blog posts. */
interface Props {
  title: string;
  cta: string;
}

const { title, cta } = Astro.props;
const posts = (await entriesFor('blog', 'en')).slice(0, 3);
---

<section class="mx-auto max-w-[85rem] px-4 py-14 sm:px-6 lg:px-8 lg:py-20">
  <div class="flex flex-wrap items-end justify-between gap-4" data-reveal>
    <h2 class="text-3xl font-bold tracking-tight text-balance text-neutral-900 lg:text-4xl dark:text-neutral-100">{title}</h2>
    <a href={localePath('en', '/blog/')} class="font-semibold text-orange-700 underline decoration-orange-300 underline-offset-4 dark:text-orange-300 dark:decoration-orange-700">{cta}</a>
  </div>
  <div class="mt-8 grid gap-6 md:grid-cols-3" data-reveal-group>
    {posts.map(post => (
      <div data-reveal-item><PostCard post={post} /></div>
    ))}
  </div>
</section>
