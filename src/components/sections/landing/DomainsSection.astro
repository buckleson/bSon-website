---
import Glyph from '@components/ui/Glyph.astro';
import Icon from '@components/ui/icons/Icon.astro';
import { localePath } from '@utils/locale';

/** "What we build": the four domains, each with an icon and a link. */
interface Props {
  title: string;
  subTitle: string;
  items: { title: string; content: string; href: string; icon: string }[];
}

const { title, subTitle, items } = Astro.props;
---

<section class="mx-auto max-w-[85rem] px-4 py-12 sm:px-6 lg:px-8 lg:py-16" aria-labelledby="domains-title">
  <div class="max-w-2xl" data-reveal>
    <h2 id="domains-title" class="text-3xl font-bold tracking-tight text-balance text-neutral-900 dark:text-neutral-100">{title}</h2>
    <p class="mt-2 text-pretty text-neutral-600 dark:text-neutral-400">{subTitle}</p>
  </div>
  <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4" data-reveal-group>
    {items.map(item => (
      <li data-reveal-item>
        <a
          href={localePath('en', item.href)}
          class="group flex h-full flex-col rounded-2xl bg-white p-5 ring-1 ring-neutral-900/10 transition duration-300 hover:-translate-y-1 hover:shadow-[0_18px_40px_-22px_rgb(30_16_60/0.4)] hover:ring-orange-400 dark:bg-neutral-900 dark:ring-white/10 dark:hover:ring-orange-500"
        >
          <span class="grid size-11 place-items-center rounded-xl bg-orange-600 text-white transition duration-300 group-hover:rotate-[-6deg] group-hover:scale-110 dark:bg-orange-700">
            <Glyph icon={item.icon} class="size-6" />
          </span>
          <h3 class="mt-4 flex items-center justify-between gap-2 text-lg font-semibold text-neutral-900 dark:text-neutral-100">
            {item.title}
            <Icon name="arrowRight" class="size-4 shrink-0 text-orange-600 transition duration-300 group-hover:translate-x-1 dark:text-orange-400" />
          </h3>
          <p class="mt-1.5 text-sm text-pretty text-neutral-600 dark:text-neutral-400">{item.content}</p>
        </a>
      </li>
    ))}
  </ul>
</section>
