---
import Icon from '@components/ui/icons/Icon.astro';
import { localePath } from '@utils/locale';

/** "What we build": the four domains Buckleson works in, each linked. */
interface Props {
  title: string;
  items: { title: string; content: string; href: string }[];
}

const { title, items } = Astro.props;
---

<section class="mx-auto max-w-[85rem] px-4 py-12 sm:px-6 lg:px-8 lg:py-16" aria-labelledby="domains-title">
  <h2 id="domains-title" class="text-3xl font-bold tracking-tight text-balance text-neutral-900 lg:text-4xl dark:text-neutral-100">
    {title}
  </h2>
  <ul class="mt-6 grid gap-x-8 gap-y-2 sm:grid-cols-2 lg:grid-cols-4" data-reveal-group>
    {items.map(item => (
      <li data-reveal-item class="border-t-2 border-neutral-900 dark:border-neutral-200">
        <a href={localePath('en', item.href)} class="group block h-full py-5">
          <h3 class="flex items-center justify-between gap-3 text-xl font-bold text-neutral-900 dark:text-neutral-100">
            {item.title}
            <Icon name="arrowRight" class="size-5 shrink-0 text-orange-600 transition duration-300 group-hover:translate-x-1 dark:text-orange-400" />
          </h3>
          <p class="mt-2 text-pretty text-neutral-600 dark:text-neutral-400">{item.content}</p>
        </a>
      </li>
    ))}
  </ul>
</section>
