---
import Glyph from '@components/ui/Glyph.astro';

/** Closing call to action. */
interface Props {
  title: string;
  subTitle?: string;
  url?: string;
}

const { title, subTitle, url } = Astro.props;
const btnTitle = Astro.locals.copy.home.heroAlt.btn;
const steps = [
  ['calendar-check', 'Book a 30-minute call'],
  ['clipboard-list', 'We scope a pilot together'],
  ['rocket', 'Your chain goes live'],
];
---

<section class="mx-auto max-w-[85rem] px-4 pt-6 pb-20 sm:px-6 lg:px-8">
  <div class="grid items-center gap-8 rounded-3xl bg-orange-600 p-8 text-white sm:p-12 lg:grid-cols-2 dark:bg-orange-800" data-reveal>
    <div>
      <h2 class="text-3xl font-bold tracking-tight text-balance sm:text-4xl">{title}</h2>
      {subTitle && <p class="mt-3 max-w-lg text-pretty text-white/85">{subTitle}</p>}
      <div class="mt-7"><a href={url} class="inline-flex items-center gap-2 rounded-lg bg-white px-5 py-3 text-sm font-bold text-neutral-900 transition hover:bg-neutral-100">{btnTitle}<Glyph icon="arrow-right" class="size-4" /></a></div>
    </div>
    <ol class="grid gap-3 sm:grid-cols-3 lg:grid-cols-1">
      {steps.map(([icon, label], index) => (
        <li class="flex items-center gap-3 rounded-2xl bg-white/10 px-4 py-3 ring-1 ring-white/20">
          <span class="grid size-9 shrink-0 place-items-center rounded-xl bg-white/15"><Glyph icon={icon} class="size-5" /></span>
          <span class="text-sm font-semibold"><span class="text-white/70">{index + 1}.</span> {label}</span>
        </li>
      ))}
    </ol>
  </div>
</section>
