---
import PrimaryCTA from '@components/ui/buttons/PrimaryCTA.astro';
import SecondaryCTA from '@components/ui/buttons/SecondaryCTA.astro';

/** Home hero: headline, one-line summary, two calls to action and a visual. */
interface Props {
  title: string;
  subTitle?: string;
  primaryBtn?: string;
  primaryBtnURL?: string;
  secondaryBtn?: string;
  secondaryBtnURL?: string;
}

const { title, subTitle, primaryBtn, primaryBtnURL, secondaryBtn, secondaryBtnURL } = Astro.props;
---

<section class="relative mx-auto grid max-w-[85rem] items-center gap-12 px-4 pt-12 pb-14 sm:px-6 lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] lg:gap-10 lg:px-8 lg:pt-20 lg:pb-24">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 -top-24 -z-10 mx-auto h-[28rem] max-w-5xl rounded-full bg-orange-300/25 blur-3xl dark:bg-orange-900/25"
  ></div>
  <div data-hero-copy>
    <h1 class="text-4xl font-bold tracking-tight text-balance text-neutral-900 sm:text-5xl lg:text-6xl lg:leading-[1.05] dark:text-neutral-100">
      <Fragment set:html={title} />
    </h1>
    {subTitle && (
      <p class="mt-5 max-w-[34rem] text-lg leading-relaxed text-pretty text-neutral-700 dark:text-neutral-300">
        {subTitle}
      </p>
    )}
    <div class="mt-8 flex flex-wrap gap-3">
      {primaryBtn && <PrimaryCTA title={primaryBtn} url={primaryBtnURL} />}
      {secondaryBtn && <SecondaryCTA title={secondaryBtn} url={secondaryBtnURL} />}
    </div>
  </div>
  <div class="w-full" data-hero-visual>
    <slot name="visual" />
  </div>
</section>
