---
/**
 * "At a glance": short, quotable facts about the company. Written as plain
 * definitions so search engines and AI assistants can lift them verbatim.
 */
interface Props {
  title: string;
  facts: { term: string; detail: string }[];
}

const { title, facts } = Astro.props;
---

<section class="mx-auto max-w-[85rem] px-4 py-14 sm:px-6 lg:px-8 lg:py-20">
  <div class="grid gap-10 lg:grid-cols-3">
    <h2 class="text-3xl font-bold tracking-tight text-balance text-neutral-900 lg:text-4xl dark:text-neutral-100" data-reveal>
      {title}
    </h2>
    <dl class="grid gap-x-10 gap-y-6 sm:grid-cols-2 lg:col-span-2" data-reveal-group>
      {facts.map(fact => (
        <div data-reveal-item>
          <dt class="text-sm font-semibold text-orange-700 dark:text-orange-300">{fact.term}</dt>
          <dd class="mt-1 text-pretty text-neutral-800 dark:text-neutral-200">{fact.detail}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
