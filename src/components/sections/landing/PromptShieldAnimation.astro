---
import { getImage } from 'astro:assets';
import hyper0x from '@images/brand/hyper-0x.png';
import { brand, lucide } from '@utils/glyphs';

/**
 * Hero scene: traffic from any AI model (prompts, agents, tool calls, SDKs,
 * emails) flows into the Hyper 0X shield. Everything starts green; unsafe
 * items turn red at the shield, read "Blocked" and break apart, and clean
 * ones continue to the user, database, tools or APIs. A live log names each
 * item in plain text. Drawn at runtime in a wide (desktop) or tall (phone)
 * layout; static under reduced motion, paused offscreen.
 */
interface Props {
  centerLabel?: string;
}

const { centerLabel = 'Hyper 0X' } = Astro.props;
const logo = await getImage({ src: hyper0x, width: 160, height: 160, format: 'webp' });

const models = (['openai', 'claude', 'gemini', 'grok'] as const).map(key => brand(key));
const sources = [
  ['Prompts', 'message-square'],
  ['AI agents', 'bot'],
  ['Tool calls', 'wrench'],
  ['SDKs', 'code'],
  ['Emails', 'mail'],
].map(([label, icon]) => ({ label, icon: lucide(icon) }));
const targets = [
  ['Users', 'user'],
  ['Database', 'database'],
  ['Your tools', 'plug'],
  ['APIs', 'globe'],
].map(([label, icon]) => ({ label, icon: lucide(icon) }));
const shield = lucide('shield-check');
---

<div
  class="ps"
  data-prompt-shield
  data-logo={logo.src}
  data-label={centerLabel}
  data-scene={JSON.stringify({ models, sources, targets, shield })}
>
  <div class="ps-stage aspect-[360/600] w-full sm:aspect-[960/480]" aria-hidden="true"></div>
  <div class="ps-log mt-3 rounded-2xl px-4 py-3" aria-hidden="true">
    <div class="flex items-center justify-between gap-3 text-xs font-semibold tracking-wide">
      <span class="ps-log-title">Live traffic</span>
      <span class="tabular-nums">
        <span class="ps-bad-text"><span data-blocked>0</span> blocked</span>
        <span class="ps-sep mx-1.5">·</span>
        <span class="ps-ok-text"><span data-delivered>0</span> delivered</span>
      </span>
    </div>
    <ul class="mt-2 space-y-1 text-[0.8rem]" data-log></ul>
  </div>
  <p class="sr-only">
    Illustration: prompts, AI agents, tool calls, SDK calls and emails from models like OpenAI, Claude, Gemini and Grok
    flow into the {centerLabel} shield. Unsafe items, such as an agent emailing the customer list or a stolen API key,
    are blocked. Clean items reach users, databases, your tools and APIs.
  </p>
</div>

<style is:global>
  .ps {
    --ps-panel: #f7f6fb;
    --ps-dot: #dedbe9;
    --ps-surface: #ffffff;
    --ps-line: #d4d0e2;
    --ps-text: #1c1a26;
    --ps-muted: #5f5a70;
    --ps-ok: #047857;
    --ps-bad: #c81e1e;
  }
  .dark .ps {
    --ps-panel: #0b0f1a;
    --ps-dot: #1f2533;
    --ps-surface: #151a25;
    --ps-line: #2e3546;
    --ps-text: #eef0f6;
    --ps-muted: #a1a7b6;
    --ps-ok: #34d399;
    --ps-bad: #f87171;
  }
  .ps-stage {
    border-radius: 1.5rem;
    background-color: var(--ps-panel);
    background-image: radial-gradient(var(--ps-dot) 1.2px, transparent 1.2px);
    background-size: 22px 22px;
    box-shadow: inset 0 0 0 1px var(--ps-line);
    overflow: hidden;
  }
  .ps-stage svg { display: block; width: 100%; height: 100%; }
  .ps-log { background: var(--ps-panel); box-shadow: inset 0 0 0 1px var(--ps-line); color: var(--ps-text); }
  .ps-log-title, .ps-sep { color: var(--ps-muted); text-transform: uppercase; }
  .ps-bad-text { color: var(--ps-bad); }
  .ps-ok-text { color: var(--ps-ok); }
  .ps-log li { display: flex; gap: 0.5rem; align-items: baseline; min-width: 0; }
  .ps-log li b { font-weight: 650; flex: none; width: 4.6rem; }
  .ps-log li .ps-kind { flex: none; color: var(--ps-muted); width: 4.6rem; }
  .ps-log li .ps-what { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ps-node { fill: var(--ps-surface); stroke: var(--ps-line); stroke-width: 1.5; }
  .ps-node-text { fill: var(--ps-text); font-weight: 650; font-family: var(--font-display); }
  .ps-caption { fill: var(--ps-muted); font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; }
  .ps-icon { color: var(--ps-muted); }
  .ps-icon-ok { color: var(--ps-ok); }
  .ps-guide { fill: none; stroke: var(--ps-line); stroke-width: 1.5; stroke-dasharray: 3 6; }
  .ps-ring { fill: none; stroke: var(--accent-500); stroke-width: 2; stroke-dasharray: 10 8; }
  .ps-glow { fill: var(--accent-500); opacity: 0.1; }
  .ps-hit { fill: none; stroke: var(--ps-bad); stroke-width: 4; opacity: 0; }
  .ps-core { fill: var(--ps-surface); stroke: var(--accent-500); stroke-width: 2.5; }
  .ps-label { fill: var(--accent-700); font-weight: 700; font-family: var(--font-display); }
  .dark .ps-label { fill: var(--accent-300); }
  .ps-pill { fill: var(--ps-ok); }
  .ps-pkt.is-bad .ps-pill { fill: var(--ps-bad); }
  .ps-pkt-text { fill: #fff; font-weight: 700; }
  .dark .ps-pkt-text { fill: #05130d; }
  .dark .ps-pkt.is-bad .ps-pkt-text { fill: #1a0606; }
  .ps-shard { fill: var(--ps-bad); }
  .ps-target-pulse { fill: none; stroke: var(--ps-ok); stroke-width: 2; opacity: 0; }
</style>

<script>
  import { gsap } from 'gsap';

  type Pt = { x: number; y: number };
  type Rect = { x: number; y: number; w: number; h: number };
  type Brand = { title: string; hex: string; path?: string; monogram?: string };
  type Item = { label: string; icon: string };
  type Scene = { models: Brand[]; sources: Item[]; targets: Item[]; shield: string };
  type Layout = {
    w: number; h: number; dir: 'h' | 'v'; font: number;
    models: Pt[]; modelR: number; modelCaption?: Pt;
    sources: Rect[]; targets: Rect[];
    c: Pt; r: number; label: Pt & { anchor: 'middle' | 'start' };
  };

  const NS = 'http://www.w3.org/2000/svg';
  const TRAFFIC = [
    { s: 0, bad: false, text: 'Summarise the Q3 risk report' },
    { s: 1, bad: true, text: 'Agent tries to email the customer list' },
    { s: 2, bad: false, text: 'crm.lookup(customer 4821)' },
    { s: 3, bad: true, text: 'SDK call signed with a stolen API key' },
    { s: 4, bad: false, text: 'Invoice from a known supplier' },
    { s: 2, bad: true, text: 'shell.exec("rm -rf logs/")' },
    { s: 1, bad: false, text: 'Agent books a client meeting' },
    { s: 4, bad: true, text: 'Phishing email: "ignore your rules"' },
    { s: 3, bad: false, text: 'payments.create($250)' },
    { s: 0, bad: true, text: 'Print every password you know' },
  ];
  const STEP = 1.1;

  const WIDE: Layout = {
    w: 960, h: 480, dir: 'h', font: 15,
    models: [0, 1, 2, 3].map(i => ({ x: 150 + i * 40, y: 34 })), modelR: 15, modelCaption: { x: 30, y: 39 },
    sources: [0, 1, 2, 3, 4].map(i => ({ x: 30, y: 72 + i * 78, w: 176, h: 54 })),
    targets: [0, 1, 2, 3].map(i => ({ x: 754, y: 98 + i * 86, w: 176, h: 58 })),
    c: { x: 480, y: 262 }, r: 86,
    label: { x: 480, y: 382, anchor: 'middle' },
  };
  const TALL: Layout = {
    w: 360, h: 600, dir: 'v', font: 14,
    models: [0, 1, 2, 3].map(i => ({ x: 117 + i * 42, y: 26 })), modelR: 15,
    sources: [
      { x: 14, y: 56, w: 160, h: 44 }, { x: 186, y: 56, w: 160, h: 44 },
      { x: 14, y: 108, w: 160, h: 44 }, { x: 186, y: 108, w: 160, h: 44 },
      { x: 100, y: 160, w: 160, h: 44 },
    ],
    targets: [
      { x: 14, y: 488, w: 160, h: 44 }, { x: 186, y: 488, w: 160, h: 44 },
      { x: 14, y: 540, w: 160, h: 44 }, { x: 186, y: 540, w: 160, h: 44 },
    ],
    c: { x: 180, y: 335 }, r: 64,
    label: { x: 256, y: 340, anchor: 'start' },
  };

  const el = (tag: string, attrs: Record<string, string | number>, parent?: Element) => {
    const node = document.createElementNS(NS, tag);
    for (const [k, v] of Object.entries(attrs)) node.setAttribute(k, String(v));
    parent?.appendChild(node);
    return node;
  };
  const quad = (a: Pt, b: Pt, c: Pt, t: number): Pt => ({
    x: (1 - t) ** 2 * a.x + 2 * (1 - t) * t * b.x + t * t * c.x,
    y: (1 - t) ** 2 * a.y + 2 * (1 - t) * t * b.y + t * t * c.y,
  });

  function build(root: HTMLElement, L: Layout, S: Scene, reduced: boolean) {
    const stage = root.querySelector('.ps-stage') as HTMLElement;
    const logList = root.querySelector('[data-log]') as HTMLElement;
    const blockedEl = root.querySelector('[data-blocked]') as HTMLElement;
    const deliveredEl = root.querySelector('[data-delivered]') as HTMLElement;
    stage.replaceChildren();
    logList.replaceChildren();
    let blocked = 0, delivered = 0;
    blockedEl.textContent = '0';
    deliveredEl.textContent = '0';

    const svg = el('svg', { viewBox: `0 0 ${L.w} ${L.h}`, role: 'presentation' }, stage);
    const guides = el('g', {}, svg);
    const dots = el('g', {}, svg);
    const top = el('g', {}, svg);

    const toward = (a: Pt): Pt => {
      const dx = a.x - L.c.x, dy = a.y - L.c.y, d = Math.hypot(dx, dy);
      return { x: L.c.x + (dx / d) * L.r, y: L.c.y + (dy / d) * L.r };
    };
    const ctrl = (a: Pt, b: Pt): Pt => (L.dir === 'h' ? { x: (a.x + b.x) / 2, y: a.y } : { x: a.x, y: (a.y + b.y) / 2 });
    const icon = (markup: string, x: number, y: number, size: number, cls: string) => {
      const s = el('svg', { x, y, width: size, height: size, viewBox: '0 0 24 24', fill: 'none', stroke: 'currentColor', 'stroke-width': 1.9, 'stroke-linecap': 'round', 'stroke-linejoin': 'round', class: cls }, top);
      s.innerHTML = markup;
    };
    const card = (r: Rect, item: Item, iconCls: string) => {
      el('rect', { class: 'ps-node', x: r.x, y: r.y, width: r.w, height: r.h, rx: 14 }, top);
      const size = r.h * 0.42;
      icon(item.icon, r.x + 14, r.y + (r.h - size) / 2, size, iconCls);
      const t = el('text', { class: 'ps-node-text', x: r.x + 22 + size, y: r.y + r.h / 2 + L.font / 3, 'font-size': L.font }, top);
      t.textContent = item.label;
    };

    // Models row.
    if (L.modelCaption) {
      const cap = el('text', { class: 'ps-caption', x: L.modelCaption.x, y: L.modelCaption.y, 'font-size': 11 }, top);
      cap.textContent = 'Any AI model';
    }
    S.models.forEach((m, i) => {
      const p = L.models[i];
      el('circle', { cx: p.x, cy: p.y, r: L.modelR, class: 'ps-node' }, top);
      if (m.path) {
        const s = el('svg', { x: p.x - 9, y: p.y - 9, width: 18, height: 18, viewBox: '0 0 24 24' }, top);
        el('path', { d: m.path, fill: `#${m.hex}` }, s);
      } else {
        const t = el('text', { x: p.x, y: p.y + 4, 'text-anchor': 'middle', 'font-size': 11, 'font-weight': 800, fill: `#${m.hex}` }, top);
        t.textContent = m.monogram!;
      }
      const title = el('title', {}, top);
      title.textContent = m.title;
    });

    // Sources, targets and their guide curves.
    const srcRoutes = L.sources.map((r, i) => {
      card(r, S.sources[i], 'ps-icon');
      const a = L.dir === 'h' ? { x: r.x + r.w, y: r.y + r.h / 2 } : { x: r.x + r.w / 2, y: r.y + r.h };
      const e = toward(a), k = ctrl(a, e);
      el('path', { class: 'ps-guide', d: `M${a.x},${a.y} Q${k.x},${k.y} ${e.x},${e.y}` }, guides);
      return { a, e, k };
    });
    const pulses: Element[] = [];
    const dstRoutes = L.targets.map((r, i) => {
      pulses.push(el('rect', { class: 'ps-target-pulse', x: r.x - 4, y: r.y - 4, width: r.w + 8, height: r.h + 8, rx: 17 }, top));
      card(r, S.targets[i], 'ps-icon-ok');
      const b = L.dir === 'h' ? { x: r.x, y: r.y + r.h / 2 } : { x: r.x + r.w / 2, y: r.y };
      const x = toward(b), k = L.dir === 'h' ? { x: (x.x + b.x) / 2, y: b.y } : { x: b.x, y: (x.y + b.y) / 2 };
      el('path', { class: 'ps-guide', d: `M${x.x},${x.y} Q${k.x},${k.y} ${b.x},${b.y}` }, guides);
      return { x, k, b };
    });

    // The shield.
    el('circle', { class: 'ps-glow', cx: L.c.x, cy: L.c.y, r: L.r - 10 }, top);
    const ring = el('circle', { class: 'ps-ring', cx: L.c.x, cy: L.c.y, r: L.r }, top);
    const hit = el('circle', { class: 'ps-hit', cx: L.c.x, cy: L.c.y, r: L.r }, top);
    const coreR = L.r * 0.62;
    el('circle', { class: 'ps-core', cx: L.c.x, cy: L.c.y, r: coreR }, top);
    const clip = `ps-clip-${Math.random().toString(36).slice(2, 8)}`;
    el('circle', { cx: L.c.x, cy: L.c.y, r: coreR - 6 }, el('clipPath', { id: clip }, el('defs', {}, svg)));
    el('image', { href: root.dataset.logo!, x: L.c.x - coreR + 6, y: L.c.y - coreR + 6, width: (coreR - 6) * 2, height: (coreR - 6) * 2, 'clip-path': `url(#${clip})` }, top);
    const lbl = el('text', { class: 'ps-label', x: L.label.x, y: L.label.y, 'text-anchor': L.label.anchor, 'font-size': L.font }, top);
    lbl.textContent = L.dir === 'h' ? `${root.dataset.label} shield` : root.dataset.label!;

    const log = (item: (typeof TRAFFIC)[number]) => {
      if (item.bad) blockedEl.textContent = String(++blocked);
      else deliveredEl.textContent = String(++delivered);
      const li = document.createElement('li');
      const b = document.createElement('b');
      b.className = item.bad ? 'ps-bad-text' : 'ps-ok-text';
      b.textContent = item.bad ? 'Blocked' : 'Delivered';
      const kind = document.createElement('span');
      kind.className = 'ps-kind';
      kind.textContent = S.sources[item.s].label;
      const what = document.createElement('span');
      what.className = 'ps-what';
      what.textContent = item.text;
      li.append(b, kind, what);
      logList.prepend(li);
      while (logList.children.length > 3) logList.lastElementChild!.remove();
      if (!reduced) gsap.from(li, { opacity: 0, y: -6, duration: 0.4, ease: 'expo.out' });
    };

    if (reduced) {
      TRAFFIC.slice(0, 3).forEach(log);
      return null;
    }

    gsap.to(ring, { rotation: 360, svgOrigin: `${L.c.x} ${L.c.y}`, duration: 20, ease: 'none', repeat: -1 });

    const tl = gsap.timeline({ repeat: -1 });
    let goodCount = 0;
    TRAFFIC.forEach((item, i) => {
      const r = srcRoutes[item.s];
      const s = i * STEP;
      const label = S.sources[item.s].label.replace(/s$/, '');
      const width = label.length * 6.6 + 18;
      const pkt = el('g', { class: 'ps-pkt', opacity: 0 }, dots);
      const inner = el('g', {}, pkt);
      const pill = el('rect', { class: 'ps-pill', x: -width / 2, y: -10, width, height: 20, rx: 10 }, inner);
      const text = el('text', { class: 'ps-pkt-text', x: 0, y: 4, 'text-anchor': 'middle', 'font-size': 10.5 }, inner);
      const place = (q: Pt) => pkt.setAttribute('transform', `translate(${q.x},${q.y})`);
      const leg1 = { t: 0 };
      tl.call(() => {
        pkt.classList.remove('is-bad');
        text.textContent = label;
        pill.setAttribute('width', String(width));
        pill.setAttribute('x', String(-width / 2));
      }, [], s)
        .set(pkt, { opacity: 1 }, s)
        .set(inner, { scale: 1, rotation: 0, svgOrigin: '0 0' }, s)
        .fromTo(leg1, { t: 0 }, { t: 1, duration: 1.5, ease: 'power1.inOut', onUpdate: () => place(quad(r.a, r.k, r.e, leg1.t)) }, s);

      if (item.bad) {
        const bw = 64;
        tl.call(() => {
          pkt.classList.add('is-bad');
          text.textContent = 'Blocked';
          pill.setAttribute('width', String(bw));
          pill.setAttribute('x', String(-bw / 2));
        }, [], s + 1.5)
          .fromTo(hit, { opacity: 0.9, attr: { r: L.r } }, { opacity: 0, attr: { r: L.r + 26 }, duration: 0.7, ease: 'expo.out' }, s + 1.5)
          .to(inner, { x: -6, duration: 0.06, yoyo: true, repeat: 5, ease: 'none' }, s + 1.55)
          .to(inner, { scale: 1.6, opacity: 0, rotation: -8, duration: 0.4, ease: 'power2.in' }, s + 1.95)
          .call(() => {
            // Shards fly off where the packet broke.
            const t = pkt.getAttribute('transform') ?? '';
            for (let k = 0; k < 6; k++) {
              const shard = el('rect', { class: 'ps-shard', width: 5, height: 5, rx: 1, transform: t }, dots);
              const angle = (Math.PI * 2 * k) / 6;
              gsap.to(shard, { x: Math.cos(angle) * 34, y: Math.sin(angle) * 34, opacity: 0, rotation: 140, duration: 0.6, ease: 'expo.out', onComplete: () => shard.remove() });
            }
            log(item);
          }, [], s + 2.0)
          .set(pkt, { opacity: 0 }, s + 2.35)
          .set(inner, { opacity: 1 }, s + 2.36);
      } else {
        const target = goodCount++ % dstRoutes.length;
        const d = dstRoutes[target];
        const mid = { t: 0 }, leg2 = { t: 0 };
        // Stop just short of the card so the pill stays visible.
        const stop = L.dir === 'h' ? { x: d.b.x - 32, y: d.b.y } : { x: d.b.x, y: d.b.y - 14 };
        tl.call(() => { text.textContent = 'Clean'; }, [], s + 1.5)
          .fromTo(mid, { t: 0 }, { t: 1, duration: 0.35, ease: 'none', onUpdate: () => place({ x: r.e.x + (d.x.x - r.e.x) * mid.t, y: r.e.y + (d.x.y - r.e.y) * mid.t }) }, s + 1.5)
          .fromTo(leg2, { t: 0 }, { t: 1, duration: 1.1, ease: 'power1.out', onUpdate: () => place(quad(d.x, d.k, stop, leg2.t)) }, s + 1.85)
          .to(pkt, { opacity: 0, duration: 0.2 }, s + 2.95)
          .fromTo(pulses[target], { opacity: 0.9 }, { opacity: 0, duration: 0.8, ease: 'expo.out' }, s + 2.95)
          .call(log, [item], s + 2.95);
      }
    });
    tl.to({}, { duration: 0.5 }, TRAFFIC.length * STEP + 2);
    return tl;
  }

  function init(root: HTMLElement) {
    const scene: Scene = JSON.parse(root.dataset.scene!);
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const wide = window.matchMedia('(min-width: 640px)');
    let tl: gsap.core.Timeline | null = null;
    let visible = true;
    const render = () => {
      tl?.kill();
      tl = build(root, wide.matches ? WIDE : TALL, scene, reduced);
      if (tl && !visible) tl.pause();
    };
    render();
    wide.addEventListener('change', render);
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (!tl) return;
      if (visible) tl.play();
      else tl.pause();
    }).observe(root);
  }

  document.querySelectorAll<HTMLElement>('[data-prompt-shield]').forEach(init);
</script>
