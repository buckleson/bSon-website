---
import PrimaryCTA from '@components/ui/buttons/PrimaryCTA.astro';
import SecondaryCTA from '@components/ui/buttons/SecondaryCTA.astro';
import SectionHead from '@components/home/SectionHead.astro';
import ProductArt from '@components/ui/ProductArt.astro';
import ProductMock from '@components/ui/ProductMock.astro';
import FeatureBento from '@components/ui/FeatureBento.astro';
import FlowStack from '@components/ui/FlowStack.astro';
import ThreatGrid from '@components/ui/ThreatGrid.astro';
import IsoFigure from '@components/ui/IsoFigure.astro';
import Diagram from '@components/ui/Diagram.astro';
import Glyph from '@components/ui/Glyph.astro';
import type { CollectionEntry } from 'astro:content';
import { flows, type FlowName } from '@data/explainers';
import { localePath } from '@utils/locale';
import { slugOf } from '@utils/content';

/**
 * Product page, one long read: the product in use beside its name, the
 * features as a bento grid, then "how it works" as a layered stack that a
 * request travels through. Pavii adds the ten agent risks and how each is
 * stopped; Hyper 0X adds its two labelled figures. Specifications, FAQ and
 * a call to action close the page.
 */
interface Props {
  product: CollectionEntry<'products'>;
}

const { product } = Astro.props;
const data = product.data;
const slug = slugOf(product) as 'hyper-0x' | 'pavii' | 'hyper-wallet' | 'h0x-pay' | 'hyperrun';
const soon = data.status === 'coming-soon';
const href = (url: string) => localePath('en', url);

const extras: Record<typeof slug, { flow: FlowName; highlight?: { value: string; label: string }; chips: string[] }> = {
  'hyper-0x': { flow: 'hyper0x', highlight: { value: '1 pass', label: 'to a final record, with no reorgs' }, chips: ['aBFT consensus', 'Post-quantum-resistant', 'Private L2s', 'EVM · Solana · Sui bridges'] },
  pavii: { flow: 'pavii', highlight: { value: '100M+', label: 'AI tokens saved across 82K+ queries' }, chips: ['Claude', 'Claude Code', 'Codex', 'ChatGPT', 'Grok', 'OpenCode', 'Custom agents'] },
  'hyper-wallet': { flow: 'wallet', highlight: { value: '2M+', label: 'transactions, 33K+ portfolios and $128K+ saved in fees' }, chips: ['Bitcoin', 'Ethereum', 'Solana', 'Tron', 'TON', 'XRP', 'Stellar', 'Sui'] },
  'h0x-pay': { flow: 'pay', chips: ['Gold first', 'Index funds next', 'Crypto payments'] },
  hyperrun: { flow: 'run', chips: ['Play', 'Predict', 'Earn', 'Sponsor'] },
};
const extra = extras[slug];
const flow = flows[extra.flow];
const features = data.features.map(f => ({ icon: f.icon, title: f.title, text: f.subTitle }));
let n = 0;
const next = () => String(++n).padStart(2, '0');
---

<section class="mx-auto flex max-w-[85rem] flex-col px-4 pt-10 pb-12 sm:px-6 lg:px-8 lg:pt-14">
  <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)]">
    <div id="fadeInUp">
      <p class="font-mono text-xs tracking-wide text-muted uppercase">Product{soon && ' · coming soon'}</p>
      <h1 class="mt-4 text-5xl leading-[0.98] font-semibold text-ink sm:text-6xl lg:text-7xl">{data.title}</h1>
      <p class="mt-4 max-w-md text-xl font-medium text-pretty text-ink/85">{data.tagline}</p>
      <p id="fadeText" class="mt-5 max-w-[52ch] leading-relaxed text-pretty text-muted">{data.summary}</p>
      <div class="mt-7 flex flex-wrap gap-3">
        <PrimaryCTA title={data.cta.title} url={href(data.cta.url)} />
        <SecondaryCTA title="How it works" url="#how-it-works" />
      </div>
    </div>
    <div id="fadeInMoveRight" class="will-change-transform">
      {slug === 'hyper-0x'
        ? <div class="overflow-hidden rounded-[1.8rem] ring-1 ring-line"><ProductArt product="hyper-0x" class="aspect-[440/360]" /></div>
        : <ProductMock kind={slug} class="min-h-[24rem] ring-1 ring-line sm:min-h-[27rem]" />}
    </div>
  </div>
</section>

<section class="mx-auto max-w-[85rem] px-4 py-14 sm:px-6 lg:px-8 lg:py-20" aria-labelledby="features-title">
  <SectionHead index={next()} label="Features" claim={`What ${data.title}`} payoff="does for you." id="features-title" />
  <FeatureBento class="mt-10" items={features} highlight={extra.highlight} chips={extra.chips} />
</section>

<section id="how-it-works" class="mx-auto max-w-[85rem] scroll-mt-24 px-4 py-14 sm:px-6 lg:px-8 lg:py-20" aria-labelledby="how-title">
  <SectionHead
    index={next()}
    label="How it works"
    claim={`Follow one ${flow.unit}`}
    payoff={`through ${data.title}.`}
    body={`Each layer has one job. Watch a ${flow.unit} pass through them, and see where a bad one stops and why.`}
    id="how-title"
  />
  <FlowStack name={extra.flow} class="mt-10" />
</section>

{slug === 'pavii' && (
  <section class="mx-auto max-w-[85rem] px-4 py-14 sm:px-6 lg:px-8 lg:py-20" aria-labelledby="threats-title">
    <SectionHead
      index={next()}
      label="Threats"
      claim="Ten ways agents get attacked,"
      payoff="and how Pavii stops each one."
      body="We say plainly where the blockchain adds real protection, where it helps with part of the job, and where it only gives evidence after the fact."
      id="threats-title"
    />
    <ThreatGrid class="mt-10" />
  </section>
)}

{slug === 'hyper-0x' && (
  <section class="mx-auto max-w-[85rem] px-4 py-14 sm:px-6 lg:px-8 lg:py-20" aria-labelledby="inside-title">
    <SectionHead index={next()} label="Inside Hyper 0X" claim="One L1, many L2s," payoff="four layers of encryption." id="inside-title" />
    <div class="mt-10 grid gap-6 xl:grid-cols-2">
      <IsoFigure name="chain-rack" />
      <IsoFigure name="cipher-tower" />
    </div>
  </section>
)}

<section class="mx-auto max-w-[85rem] px-4 py-14 sm:px-6 lg:px-8 lg:py-20" aria-labelledby="specs-title">
  <SectionHead index={next()} label={data.details.title} claim={soon ? 'What we are' : 'What runs'} payoff={soon ? 'building next.' : 'under the hood.'} id="specs-title" />
  <ul class="mt-10 grid gap-3 md:grid-cols-2 lg:grid-cols-3" data-reveal-group>
    {data.details.items.map((item, i) => (
      <li class="rounded-[1.4rem] bg-card p-6 ring-1 ring-line" data-reveal-item>
        <p class="flex items-center gap-2 font-mono text-xs text-muted"><Glyph icon={soon ? 'flag' : 'check-circle'} class="size-4 text-orange-600 dark:text-orange-400" />{String(i + 1).padStart(2, '0')}</p>
        <h3 class="mt-3 font-semibold text-ink">{item.title}</h3>
        <p class="mt-1.5 text-sm leading-relaxed text-pretty text-muted">{item.subTitle}</p>
      </li>
    ))}
  </ul>
  <details class="group mt-8">
    <summary class="inline-flex cursor-pointer list-none items-center gap-2 text-sm font-semibold text-orange-700 dark:text-orange-300">
      <Glyph icon="caret-down" class="size-4 transition group-open:rotate-180" />Full architecture diagram
    </summary>
    <Diagram name={data.diagram} class="mt-4" caption={`${data.title} architecture. Select the diagram to open it full size.`} />
  </details>
</section>

{(data.faqs.length > 0 || data.learnMore.length > 0) && (
  <section class="mx-auto grid max-w-[85rem] gap-12 px-4 py-14 sm:px-6 lg:grid-cols-3 lg:px-8 lg:py-20">
    <div data-reveal>
      <h2 class="text-3xl font-semibold text-balance text-ink">{data.title} questions</h2>
      {data.learnMore.length > 0 && (
        <ul class="mt-6 space-y-3">
          {data.learnMore.map(link => (
            <li><a href={href(link.url)} class="inline-flex items-center gap-2 font-medium text-orange-700 hover:underline dark:text-orange-300"><Glyph icon="article" class="size-4" />{link.title}</a></li>
          ))}
        </ul>
      )}
    </div>
    <div class="divide-y divide-line lg:col-span-2" data-reveal>
      {data.faqs.map((faq, index) => (
        <details class="group py-5" open={index === 0}>
          <summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-lg font-semibold text-ink">
            {faq.question}
            <span class="grid size-8 shrink-0 place-items-center rounded-full bg-card ring-1 ring-line transition duration-300 group-open:rotate-45"><Glyph icon="plus" class="size-4" /></span>
          </summary>
          <p class="mt-3 max-w-[65ch] text-pretty text-muted">{faq.answer}</p>
        </details>
      ))}
    </div>
  </section>
)}

<section class="px-2 pb-6 sm:px-3">
  <div class="on-sheet rounded-[2rem] bg-sheet px-6 py-16 text-center text-white" data-reveal>
    <h2 class="mx-auto max-w-2xl text-3xl font-semibold text-balance sm:text-5xl">
      <span class="block">{soon ? 'Be first to use' : `Put ${data.title}`}</span>
      <span class="mark">{soon ? data.title : 'to work.'}</span>
    </h2>
    <p class="mx-auto mt-4 max-w-xl text-pretty text-white/70">A 30-minute call with a Buckleson engineer. Tell us what you want to build. We will show you how it runs on Hyper 0X.</p>
    <div class="mt-8"><PrimaryCTA title={data.cta.title} url={href(data.cta.url)} /></div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';

  // Intro: the text is visible from the first paint and only settles into
  // place; the visual fades in beside it.
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    gsap
      .timeline({ defaults: { ease: 'power3.out' } })
      .from('#fadeInUp', { y: 22, duration: 0.9 }, 0)
      .from('#fadeInMoveRight', { autoAlpha: 0, x: 48, scale: 0.97, duration: 1 }, 0.1);
  }
</script>
