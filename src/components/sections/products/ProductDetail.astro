---
import ProductTabBtn from '@components/ui/buttons/ProductTabBtn.astro';
import PrimaryCTA from '@components/ui/buttons/PrimaryCTA.astro';
import SecondaryCTA from '@components/ui/buttons/SecondaryCTA.astro';
import ProductArt from '@components/ui/ProductArt.astro';
import Diagram from '@components/ui/Diagram.astro';
import SystemDiagram from '@components/ui/SystemDiagram.astro';
import Glyph from '@components/ui/Glyph.astro';
import PromptShieldAnimation from '@components/sections/landing/PromptShieldAnimation.astro';
import type { CollectionEntry } from 'astro:content';
import type { SystemName } from '@data/systems';
import { localePath } from '@utils/locale';
import { slugOf } from '@utils/content';

/**
 * Product page in the original ScrewFast layout: a fading intro, the product
 * name beside its animated scene, then Overview / Specifications /
 * How it works tabs (the last runs the transaction animation), followed by
 * FAQ and a call to action.
 */
interface Props {
  product: CollectionEntry<'products'>;
}

const { product } = Astro.props;
const data = product.data;
const soon = data.status === 'coming-soon';
const href = (url: string) => localePath('en', url);
type Art = 'hyper-0x' | 'pavii' | 'hyper-wallet' | 'h0x-pay' | 'hyperrun';
const half = Math.ceil(data.details.items.length / 2);
const tabs = [
  { id: 'tab-overview', panel: '#panel-overview', title: 'Overview', icon: 'squares-four' },
  { id: 'tab-specs', panel: '#panel-specs', title: data.details.title, icon: 'list-checks' },
  { id: 'tab-architecture', panel: '#panel-architecture', title: 'How it works', icon: 'flow-arrow' },
];
---

<div id="overlay" class="pointer-events-none fixed inset-0 z-40 bg-ground"></div>

<section class="mx-auto flex max-w-[85rem] flex-col px-4 pt-10 pb-12 sm:px-6 lg:px-8 lg:pt-14">
  <p id="fadeText" class="mb-8 max-w-[62ch] text-lg leading-relaxed text-pretty text-muted sm:text-xl">{data.summary}</p>
  <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)]">
    <div id="fadeInUp">
      <h1 class="text-5xl leading-[0.98] font-semibold text-ink sm:text-6xl lg:text-7xl">{data.title}</h1>
      {soon && <p class="mt-4 w-fit rounded-full bg-orange-100 px-3 py-1 text-sm font-semibold text-orange-800 dark:bg-orange-950 dark:text-orange-200">Coming soon</p>}
      <p class="mt-4 max-w-md text-lg font-medium text-pretty text-ink/80">{data.tagline}</p>
      <div class="mt-7 flex flex-wrap gap-3">
        <PrimaryCTA title={data.cta.title} url={href(data.cta.url)} />
        <SecondaryCTA title="How it works" url="#product-detail-body" />
      </div>
    </div>
    <div id="fadeInMoveRight" class="overflow-hidden rounded-[1.8rem] ring-1 ring-line will-change-transform">
      <ProductArt product={slugOf(product) as Art} class="aspect-[400/260]" />
    </div>
  </div>
</section>

<div id="product-detail-body" class="mx-auto max-w-[85rem] scroll-mt-24 px-4 pt-6 sm:px-6 lg:px-8">
  <nav class="mx-auto grid max-w-3xl gap-1.5 rounded-[1.6rem] bg-card p-1.5 ring-1 ring-line sm:grid-cols-3 sm:rounded-full" aria-label={`${data.title} details`} role="tablist">
    {tabs.map((tab, index) => <ProductTabBtn id={tab.id} dataTab={tab.panel} title={tab.title} icon={tab.icon} first={index === 0} />)}
  </nav>

  <div class="relative mt-10 md:mt-14">
    <div id="panel-overview" class="product-tab-panel" role="tabpanel" aria-labelledby="tab-overview">
      <div class="grid gap-12 pb-14 md:grid-cols-2">
        <div>
          <h2 class="text-3xl leading-tight font-semibold text-balance text-ink lg:text-4xl">What {data.title} does</h2>
          <p class="mt-4 text-pretty text-muted">{data.summary}</p>
          <p class="mt-6"><PrimaryCTA title={data.cta.title} url={href(data.cta.url)} /></p>
        </div>
        <dl class="grid gap-6 sm:grid-cols-2">
          {data.features.map(feature => (
            <div class="flex gap-4">
              {feature.icon && <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-orange-100 text-orange-700 dark:bg-orange-950 dark:text-orange-300"><Glyph icon={feature.icon} class="size-5" /></span>}
              <div>
                <dt class="font-semibold text-ink">{feature.title}</dt>
                <dd class="mt-1 text-sm text-pretty text-muted">{feature.subTitle}</dd>
              </div>
            </div>
          ))}
        </dl>
      </div>
    </div>

    <div id="panel-specs" class="product-tab-panel hidden" role="tabpanel" aria-labelledby="tab-specs">
      <div class="grid w-full grid-cols-1 gap-x-16 gap-y-6 pb-14 md:grid-cols-2">
        {[data.details.items.slice(0, half), data.details.items.slice(half)].map(group => (
          <div class="space-y-6">
            {group.map(item => (
              <div class="border-t border-line pt-5">
                <h3 class="font-semibold text-ink">{item.title}</h3>
                <p class="mt-1 text-pretty text-muted">{item.subTitle}</p>
              </div>
            ))}
          </div>
        ))}
      </div>
    </div>

    <div id="panel-architecture" class="product-tab-panel hidden" role="tabpanel" aria-labelledby="tab-architecture">
      <div class="space-y-10 pb-14">
        <SystemDiagram name={data.diagram as SystemName} />
        {product.id.endsWith('pavii') && (
          <div>
            <h3 class="text-2xl font-semibold text-ink">Pavii in action</h3>
            <p class="mt-2 max-w-[60ch] text-muted">Prompts, agents, tool calls, SDKs and emails pass through Pavii, secured by Hyper 0X. Unsafe ones stop at the shield; clean ones reach your systems.</p>
            <div class="mt-6"><PromptShieldAnimation centerLabel="Pavii" /></div>
          </div>
        )}
        <details class="group">
          <summary class="inline-flex cursor-pointer list-none items-center gap-2 text-sm font-semibold text-orange-700 dark:text-orange-300">
            <Glyph icon="caret-down" class="size-4 transition group-open:rotate-180" />Full architecture diagram
          </summary>
          <Diagram name={data.diagram} class="mt-4" caption={`${data.title} architecture. Select the diagram to open it full size.`} />
        </details>
      </div>
    </div>
  </div>
</div>

{(data.faqs.length > 0 || data.learnMore.length > 0) && (
  <section class="mx-auto grid max-w-[85rem] gap-12 px-4 py-14 sm:px-6 lg:grid-cols-3 lg:px-8 lg:py-20">
    <div data-reveal>
      <h2 class="text-3xl font-semibold text-balance text-ink">{data.title} questions</h2>
      {data.learnMore.length > 0 && (
        <ul class="mt-6 space-y-3">
          {data.learnMore.map(link => (
            <li><a href={href(link.url)} class="inline-flex items-center gap-2 font-medium text-orange-700 hover:underline dark:text-orange-300"><Glyph icon="article" class="size-4" />{link.title}</a></li>
          ))}
        </ul>
      )}
    </div>
    <div class="divide-y divide-line lg:col-span-2" data-reveal>
      {data.faqs.map((faq, index) => (
        <details class="group py-5" open={index === 0}>
          <summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-lg font-semibold text-ink">
            {faq.question}
            <span class="grid size-8 shrink-0 place-items-center rounded-full bg-card ring-1 ring-line transition duration-300 group-open:rotate-45"><Glyph icon="plus" class="size-4" /></span>
          </summary>
          <p class="mt-3 max-w-[65ch] text-pretty text-muted">{faq.answer}</p>
        </details>
      ))}
    </div>
  </section>
)}

<section class="px-2 pb-6 sm:px-3">
  <div class="on-sheet rounded-[2rem] bg-sheet px-6 py-16 text-center text-white" data-reveal>
    <h2 class="mx-auto max-w-2xl text-3xl font-semibold text-balance sm:text-5xl">
      <span class="block">{soon ? 'Be first to use' : `Put ${data.title}`}</span>
      <span class="mark">{soon ? data.title : 'to work.'}</span>
    </h2>
    <p class="mx-auto mt-4 max-w-xl text-pretty text-white/70">A 30-minute call with a Buckleson engineer. Tell us what you want to build; we will show you how it runs on Hyper 0X.</p>
    <div class="mt-8"><PrimaryCTA title={data.cta.title} url={href(data.cta.url)} /></div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const parts = ['#fadeText', '#fadeInUp', '#fadeInMoveRight', '#product-detail-body'];

  if (reduced) {
    gsap.set('#overlay', { autoAlpha: 0, display: 'none' });
  } else {
    gsap.set('#fadeText', { autoAlpha: 0, y: 20 });
    gsap.set('#fadeInUp', { autoAlpha: 0, y: 28 });
    gsap.set('#fadeInMoveRight', { autoAlpha: 0, x: 56, scale: 0.97 });
    gsap.set('#product-detail-body', { autoAlpha: 0, y: 24 });
    const reveal = () => {
      gsap.set(parts, { autoAlpha: 1, x: 0, y: 0, scale: 1 });
      gsap.set('#overlay', { autoAlpha: 0, display: 'none' });
    };
    const safety = window.setTimeout(reveal, 2200);
    gsap
      .timeline({ defaults: { ease: 'power3.out' }, onComplete: () => { window.clearTimeout(safety); gsap.set('#overlay', { display: 'none' }); } })
      .to('#overlay', { autoAlpha: 0, duration: 0.65, ease: 'power2.inOut' }, 0.08)
      .to('#fadeText', { autoAlpha: 1, y: 0, duration: 0.85 }, 0.12)
      .to('#fadeInUp', { autoAlpha: 1, y: 0, duration: 0.95 }, 0.22)
      .to('#fadeInMoveRight', { autoAlpha: 1, x: 0, scale: 1, duration: 1.05 }, 0.18)
      .to('#product-detail-body', { autoAlpha: 1, y: 0, duration: 0.8 }, 0.42);
  }

  // Tabs with a short fade between panels; arrow keys move between tabs.
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('.product-tab')];
  let active = document.querySelector<HTMLElement>('.product-tab-panel:not(.hidden)');
  const show = (button: HTMLButtonElement) => {
    const next = document.querySelector<HTMLElement>(button.dataset.target!);
    if (!next || next === active) return;
    buttons.forEach(b => b.setAttribute('aria-selected', String(b === button)));
    active?.classList.add('hidden');
    next.classList.remove('hidden');
    if (!reduced) gsap.fromTo(next, { autoAlpha: 0, y: 14 }, { autoAlpha: 1, y: 0, duration: 0.45, ease: 'power3.out' });
    active = next;
  };
  buttons.forEach((button, index) => {
    button.addEventListener('click', () => show(button));
    button.addEventListener('keydown', event => {
      const step = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
      if (!step) return;
      const next = buttons[(index + step + buttons.length) % buttons.length];
      next.focus();
      show(next);
    });
  });
</script>
