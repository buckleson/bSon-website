---
import PrimaryCTA from '@components/ui/buttons/PrimaryCTA.astro';
import SecondaryCTA from '@components/ui/buttons/SecondaryCTA.astro';
import Diagram from '@components/ui/Diagram.astro';
import SystemDiagram from '@components/ui/SystemDiagram.astro';
import type { SystemName } from '@data/systems';
import Icon from '@components/ui/icons/Icon.astro';
import Glyph from '@components/ui/Glyph.astro';
import PromptShieldAnimation from '@components/sections/landing/PromptShieldAnimation.astro';
import type { CollectionEntry } from 'astro:content';
import { localePath } from '@utils/locale';

/**
 * One product page: what it is in a few lines, the architecture diagram,
 * features, details, FAQ and a call to action. Everything is visible without
 * tabs so search engines and readers see the whole page.
 */
interface Props {
  product: CollectionEntry<'products'>;
}

const { product } = Astro.props;
const data = product.data;
const soon = data.status === 'coming-soon';
const href = (url: string) => localePath('en', url);
---

<section class="mx-auto max-w-[85rem] px-4 pt-12 pb-10 sm:px-6 lg:px-8 lg:pt-20">
  <div class="max-w-3xl" data-reveal>
    <h1 class="text-4xl font-bold tracking-tight text-balance text-neutral-900 sm:text-5xl dark:text-neutral-100">
      {data.title}
      {soon && (
        <span class="ms-2 inline-block translate-y-[-0.4em] rounded-full bg-orange-100 px-3 py-1 align-middle text-sm font-semibold tracking-normal text-orange-800 dark:bg-orange-950 dark:text-orange-200">
          Coming soon
        </span>
      )}
    </h1>
    <p class="mt-3 text-lg font-medium text-pretty text-neutral-700 dark:text-neutral-300">
      {data.tagline}
    </p>
    <p class="mt-3 max-w-[62ch] text-base leading-relaxed text-pretty text-neutral-600 dark:text-neutral-400">
      {data.summary}
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <PrimaryCTA title={data.cta.title} url={href(data.cta.url)} />
      <SecondaryCTA title="See how it works" url="#architecture" />
    </div>
  </div>

  <div id="architecture" class="mt-12 scroll-mt-28" data-reveal>
    <SystemDiagram name={data.diagram as SystemName} />
    <details class="group mt-6">
      <summary class="inline-flex cursor-pointer list-none items-center gap-2 text-sm font-semibold text-orange-700 dark:text-orange-300">
        <Icon name="chevronDown" class="size-4 transition group-open:rotate-180" />
        Full architecture diagram
      </summary>
      <Diagram name={data.diagram} class="mt-4" caption={`${data.title} architecture. Select the diagram to open it full size.`} />
    </details>
  </div>
</section>

{product.id.endsWith('pavii') && (
  <section class="mx-auto max-w-[85rem] px-4 py-14 sm:px-6 lg:px-8">
    <h2 class="text-3xl font-bold tracking-tight text-balance text-neutral-900 dark:text-neutral-100" data-reveal>
      Pavii in action
    </h2>
    <p class="mt-3 max-w-[60ch] text-neutral-600 dark:text-neutral-400" data-reveal>
      Prompts from every AI model pass through Pavii, secured by Hyper 0X. Unsafe requests stop at the shield; clean ones reach your systems.
    </p>
    <div class="mt-8" data-reveal>
      <PromptShieldAnimation centerLabel="Pavii" />
    </div>
  </section>
)}

<section class="mx-auto max-w-[85rem] px-4 py-14 sm:px-6 lg:px-8 lg:py-20">
  <h2 class="text-3xl font-bold tracking-tight text-balance text-neutral-900 lg:text-4xl dark:text-neutral-100" data-reveal>
    {soon ? 'What it will do' : 'What you get'}
  </h2>
  <dl class="mt-8 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3" data-reveal-group>
    {data.features.map(feature => (
      <div class="flex gap-4" data-reveal-item>
        {feature.icon && (
          <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-orange-100 text-orange-700 dark:bg-orange-950 dark:text-orange-300">
            <Glyph icon={feature.icon} class="size-5" />
          </span>
        )}
        <div>
          <dt class="font-semibold text-neutral-900 dark:text-neutral-100">{feature.title}</dt>
          <dd class="mt-1 text-sm text-pretty text-neutral-600 dark:text-neutral-400">{feature.subTitle}</dd>
        </div>
      </div>
    ))}
  </dl>
</section>

<section class="mx-auto max-w-[85rem] px-4 sm:px-6 lg:px-8">
  <div class="grid gap-10 rounded-3xl bg-white px-6 py-12 ring-1 ring-neutral-900/5 sm:px-10 lg:grid-cols-3 lg:py-16 dark:bg-neutral-900 dark:ring-white/10">
    <h2 class="text-3xl font-bold tracking-tight text-balance text-neutral-900 lg:text-4xl dark:text-neutral-100" data-reveal>
      {data.details.title}
    </h2>
    <dl class="grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:col-span-2" data-reveal-group>
      {data.details.items.map(item => (
        <div data-reveal-item>
          <dt class="font-semibold text-neutral-900 dark:text-neutral-100">{item.title}</dt>
          <dd class="mt-1 text-pretty text-neutral-600 dark:text-neutral-400">{item.subTitle}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

{(data.faqs.length > 0 || data.learnMore.length > 0) && (
  <section class="mx-auto grid max-w-[85rem] gap-12 px-4 py-14 sm:px-6 lg:grid-cols-3 lg:px-8 lg:py-20">
    <div data-reveal>
      <h2 class="text-3xl font-bold tracking-tight text-balance text-neutral-900 dark:text-neutral-100">
        {data.title} questions
      </h2>
      {data.learnMore.length > 0 && (
        <ul class="mt-6 space-y-3">
          {data.learnMore.map(link => (
            <li>
              <a
                href={href(link.url)}
                class="font-medium text-orange-700 underline decoration-orange-300 underline-offset-4 hover:decoration-orange-600 dark:text-orange-300 dark:decoration-orange-700"
              >
                {link.title}
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
    <div class="divide-y divide-neutral-300 lg:col-span-2 dark:divide-neutral-700" data-reveal>
      {data.faqs.map((faq, index) => (
        <details class="group py-5" open={index === 0}>
          <summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-lg font-semibold text-neutral-900 dark:text-neutral-100">
            {faq.question}
            <Icon name="chevronDown" class="size-5 shrink-0 text-orange-600 transition duration-300 group-open:rotate-180 dark:text-orange-400" />
          </summary>
          <p class="mt-3 max-w-[65ch] text-pretty text-neutral-600 dark:text-neutral-400">{faq.answer}</p>
        </details>
      ))}
    </div>
  </section>
)}

<section class="mx-auto max-w-[85rem] px-4 pb-20 sm:px-6 lg:px-8">
  <div class="rounded-3xl bg-neutral-900 px-6 py-12 text-center sm:px-12 dark:bg-neutral-950 dark:ring-1 dark:ring-white/10" data-reveal>
    <h2 class="text-3xl font-bold tracking-tight text-balance text-white">
      {soon ? `Be first to use ${data.title}` : `Put ${data.title} to work`}
    </h2>
    <p class="mx-auto mt-3 max-w-xl text-pretty text-neutral-300">
      A 30-minute call with a Buckleson engineer. Tell us what you want to build; we will show you how it runs on Hyper 0X.
    </p>
    <div class="mt-8">
      <PrimaryCTA title={data.cta.title} url={href(data.cta.url)} />
    </div>
  </div>
</section>
