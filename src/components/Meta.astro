---
import { getImage } from 'astro:assets';
import { SITE } from '@data/constants';
import faviconSrc from '@images/icon.png';
import type { PageMetadata } from '@utils/metadata';
import { BASE } from '@utils/locale';

/**
 * Emits the `<head>` tags for a page. All page-specific values come from
 * `buildPageMetadata()` (see `@utils/metadata`); this file only renders them
 * plus the site-wide head chrome (favicons, manifest, theme colour).
 */
interface Props {
  metadata: PageMetadata;
}

const { metadata } = Astro.props;

const appleTouchIcon = await getImage({
  src: faviconSrc,
  width: 180,
  height: 180,
  format: 'png',
});
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{metadata.title}</title>
<meta name="description" content={metadata.description} />
<link rel="canonical" href={metadata.canonical} />
<meta
  name="robots"
  content={metadata.noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'}
/>
<meta name="author" content={SITE.author} />

{/* Open Graph */}
<meta property="og:locale" content={metadata.ogLocale} />
<meta property="og:url" content={metadata.canonical} />
<meta property="og:type" content={metadata.ogType} />
<meta property="og:title" content={metadata.ogTitle} />
<meta property="og:site_name" content={SITE.title} />
<meta property="og:description" content={metadata.ogDescription} />
<meta property="og:image" content={metadata.ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:alt" content={metadata.ogTitle} />
{metadata.articleDates && (
  <>
    <meta property="article:published_time" content={metadata.articleDates.published} />
    <meta property="article:modified_time" content={metadata.articleDates.modified} />
  </>
)}

{/* Twitter / X */}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={metadata.ogTitle} />
<meta name="twitter:description" content={metadata.ogDescription} />
<meta name="twitter:image" content={metadata.ogImage} />

{/* JSON-LD structured data: https://developers.google.com/search/docs/appearance/structured-data/intro-structured-data */}
<script type="application/ld+json" set:html={JSON.stringify(metadata.jsonLd)} />

{/* Site-wide head chrome: manifest, sitemap, LLM summary, favicons, theme colour */}
<link rel="manifest" href={`${BASE}/manifest.json`} />
<link rel="sitemap" href={`${BASE}/sitemap-index.xml`} />
<link rel="alternate" type="text/plain" title="LLM summary" href={`${BASE}/llms.txt`} />
<link rel="alternate" type="application/rss+xml" title="Buckleson blog" href={`${BASE}/rss.xml`} />
<link href={`${BASE}/favicon.ico`} rel="icon" sizes="any" type="image/x-icon" />
<link href={appleTouchIcon.src} rel="apple-touch-icon" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="theme-color" content="#4f46e5" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#262626" media="(prefers-color-scheme: dark)" />
