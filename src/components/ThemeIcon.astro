---
import Icon from '@components/ui/icons/Icon.astro';

const { copy: t } = Astro.locals;
---

{/* Theme toggle: the moon shows in light mode, the sun in dark mode. The choice is saved under the same key the head script reads on load. */}
<button
  type="button"
  aria-label={t.layout.darkTheme}
  title={t.layout.toggleTheme}
  class="flex h-8 w-8 items-center justify-center rounded-full font-medium text-ink/70 transition duration-300 hover:bg-neutral-200 hover:text-orange-400 dark:hidden"
  data-theme-set="dark"
>
  <Icon name="moon" class="size-4 shrink-0" />
</button>
<button
  type="button"
  aria-label={t.layout.lightTheme}
  title={t.layout.toggleTheme}
  class="hidden h-8 w-8 items-center justify-center rounded-full font-medium text-neutral-400 transition duration-300 hover:bg-neutral-700 hover:text-orange-300 dark:flex"
  data-theme-set="light"
>
  <Icon name="sun" class="size-4.5 shrink-0" />
</button>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-theme-set]').forEach(button => {
    button.addEventListener('click', () => {
      const dark = button.dataset.themeSet === 'dark';
      document.documentElement.classList.toggle('dark', dark);
      try {
        localStorage.setItem('hs_theme', dark ? 'dark' : 'light');
      } catch {
        // Storage blocked: the theme still changes for this page.
      }
    });
  });
</script>
