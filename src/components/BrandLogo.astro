---
import { Image } from 'astro:assets';
import mark from '@images/brand/buckleson.png';

const { class: className } = Astro.props;
---

<span class:list={['inline-flex items-center gap-2', className]}>
  <Image src={mark} alt="" width={36} height={36} class="size-9 rounded-md" />
  <span class="text-lg font-bold tracking-tight text-neutral-900 dark:text-neutral-100">
    Buckleson
  </span>
</span>
