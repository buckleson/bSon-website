---
/**
 * One home section as its own rounded box, edge to edge with a small gutter,
 * separated from its neighbours by a gap (no overlapping sheets).
 * `light` is a glass panel; `paper` is the warm drafting paper (kept for
 * a few sections); `dark` is the sheet colour. Boxes skip
 * rendering until they scroll near (content-visibility), which keeps the
 * first load fast; pass `render` for a box that must always lay out (sticky
 * or scroll-driven content inside).
 */
interface Props {
  tone?: 'light' | 'paper' | 'dark';
  render?: boolean;
  class?: string;
}

const { tone = 'light', render = false, class: className } = Astro.props;
---

<div class:list={['mx-2 mt-3 rounded-[2rem] sm:mx-3', !render && 'box-lazy', tone === 'dark' ? 'on-sheet bg-sheet text-white' : tone === 'paper' ? 'bg-paper ring-1 ring-paper-line' : 'glass', className]}>
  <slot />
</div>

<style>
  .box-lazy { content-visibility: auto; contain-intrinsic-size: auto 60rem; }
</style>
