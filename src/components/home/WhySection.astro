---
import SectionHead from '@components/home/SectionHead.astro';
import Glyph from '@components/ui/Glyph.astro';
import IsoFigure from '@components/ui/IsoFigure.astro';
import { localePath } from '@utils/locale';

/**
 * "Why Hyper 0X" as three stacking cards: how the chain works, how Pavii
 * secures AI agents, and the four layers of encryption. Each card pairs an
 * animated Anatomy figure with a dark panel (tags, title, one paragraph, a
 * real number and a link). On wide screens the cards stick under the header
 * and each new card slides up over the last, which tips back and shrinks a
 * little. Narrower screens get a plain list.
 */
type FigureName = 'chain-rack' | 'pavii-gates' | 'cipher-tower';
interface Card {
  figure: string;
  tags: string[];
  title: string;
  text: string;
  stat: string;
  statLabel: string;
  cta: { title: string; url: string };
}
interface Props {
  index: string;
  label: string;
  claim: string;
  payoff: string;
  body: string;
  cards: Card[];
}

const { index, label, claim, payoff, body, cards } = Astro.props;
---

<section class="mx-auto max-w-[85rem] px-4 py-20 sm:px-6 lg:px-8 lg:py-28" aria-labelledby="why-title">
  <SectionHead index={index} label={label} claim={claim} payoff={payoff} body={body} id="why-title" />

  <ol class="mt-14 grid gap-5 lg:block" data-stack>
    {cards.map((card, i) => (
      <li class="stack-item" data-stack-card>
        <article class="stack-card grid overflow-hidden rounded-[2rem] ring-1 ring-line lg:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)]">
          <div class="stack-visual relative min-h-0 px-2 pt-4 sm:px-4">
            <IsoFigure name={card.figure as FigureName} tone="card" lazy />
          </div>
          <div class="m-3 flex flex-col rounded-[1.6rem] bg-[#0b0c0e] p-7 text-white sm:p-8">
            <ul class="flex flex-wrap gap-2">
              {card.tags.map(tag => <li class="rounded-full bg-white/10 px-3 py-1 text-xs font-semibold text-white/90">{tag}</li>)}
            </ul>
            <p class="mt-8 font-mono text-xs tracking-wide text-white/50">0{i + 1} / 0{cards.length}</p>
            <h3 class="mt-2 text-3xl leading-tight font-semibold text-balance sm:text-[2.2rem]">{card.title}</h3>
            <p class="mt-4 max-w-[38ch] leading-relaxed text-pretty text-white/70">{card.text}</p>
            <div class="mt-auto pt-8">
              <div class="flex items-end justify-between gap-4 border-t border-white/12 pt-6">
                <p class="font-display text-5xl leading-none font-semibold text-orange-300 tabular-nums">{card.stat}</p>
                <p class="max-w-[16ch] text-right text-sm text-white/60">{card.statLabel}</p>
              </div>
              <a href={localePath('en', card.cta.url)} class="group mt-6 flex items-center justify-between rounded-full bg-white py-2 ps-6 pe-2 font-semibold text-[#0b0c0e] transition hover:bg-white/90">
                {card.cta.title}
                <span class="grid size-10 place-items-center rounded-full bg-[#0b0c0e] text-white transition group-hover:rotate-45"><Glyph icon="arrow-up-right" class="size-4" /></span>
              </a>
            </div>
          </div>
        </article>
      </li>
    ))}
  </ol>
</section>

<style>
  .stack-card { background: #f4f3ef; }
  :global(.dark) .stack-card { background: #121418; }
  @media (min-width: 1024px) {
    .stack-item { position: sticky; top: 6rem; margin-bottom: 2.5rem; }
    .stack-item:last-child { margin-bottom: 0; }
    .stack-card { height: min(40rem, calc(100svh - 8rem)); transform-origin: 50% 0; will-change: transform; }
    .stack-visual { container: figbox / size; display: grid; align-items: center; }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // As each card slides up to its place, the one beneath tips back and
  // shrinks a little, like the stack in the reference.
  document.querySelectorAll<HTMLElement>('[data-stack]').forEach(stack => {
    const items = [...stack.querySelectorAll<HTMLElement>('[data-stack-card]')];
    const media = gsap.matchMedia();
    media.add('(min-width: 1024px) and (prefers-reduced-motion: no-preference)', () => {
      items.slice(0, -1).forEach((item, i) => {
        const card = item.querySelector<HTMLElement>('.stack-card')!;
        gsap.to(card, {
          scale: 0.92,
          rotate: -1.6,
          opacity: 0.55,
          ease: 'none',
          scrollTrigger: { trigger: items[i + 1], start: 'top bottom', end: 'top top+=96', scrub: true },
        });
      });
    });
  });
</script>
