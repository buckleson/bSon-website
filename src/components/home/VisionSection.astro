---
import PrimaryCTA from '@components/ui/buttons/PrimaryCTA.astro';
import { localePath } from '@utils/locale';

/**
 * "Our vision" on a dark sheet: one statement that reveals word by word as it
 * scrolls, beside the short story of what we have already shipped.
 */
interface Props {
  index?: string;
  label: string;
  statement: string;
  story: string[];
  cta: { title: string; url: string };
}

const { index = '06', label, statement, story, cta } = Astro.props;
---

<section class="on-sheet relative rounded-t-[2rem] bg-sheet text-white">
  <div class="mx-auto grid max-w-[85rem] gap-12 px-4 pt-20 pb-28 sm:px-6 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:px-8 lg:pt-28">
    <div>
      <p class="font-mono text-xs tracking-wide text-white/60 uppercase">({index}) {label}</p>
      <p class="mt-6 max-w-[30ch] text-3xl leading-[1.15] font-semibold text-balance sm:text-4xl lg:text-[2.4rem]" data-words>{statement}</p>
    </div>
    <div class="space-y-5 text-lg leading-relaxed text-pretty text-white/80 lg:pt-12" data-reveal>
      {story.map(paragraph => <p>{paragraph}</p>)}
      <div class="pt-3"><PrimaryCTA title={cta.title} url={localePath('en', cta.url)} /></div>
    </div>
  </div>
</section>
