---
import { Picture } from 'astro:assets';
import PrimaryCTA from '@components/ui/buttons/PrimaryCTA.astro';
import founderPhoto from '@images/team/vijay.jpg';
import { localePath } from '@utils/locale';

/**
 * "Our vision" (placed in a dark box), in the founder's voice: the founder's
 * photo in a thin frame with corner marks, name and role below it; beside it
 * the label with a rule, one large statement that reveals word by word as it
 * scrolls (data-words, see motion-run.ts), and the founder's short note.
 */
interface Props {
  index?: string;
  label: string;
  statement: string;
  story: string[];
  person: { name: string; role: string };
  cta: { title: string; url: string };
}

const { index, label, statement, story, person, cta } = Astro.props;
---

<section class="relative">
  <div class="mx-auto grid max-w-[85rem] grid-cols-1 gap-12 px-4 py-20 sm:px-6 lg:grid-cols-[minmax(0,4fr)_minmax(0,7fr)] lg:gap-20 lg:px-8 lg:py-28">
    <figure class="max-w-[18rem] sm:max-w-[22rem] lg:max-w-[26rem]" data-reveal>
      <div class="vision-photo relative aspect-[4/5] overflow-hidden rounded-[1.4rem] bg-white/5">
        <Picture
          src={founderPhoto}
          formats={['avif', 'webp']}
          widths={[320, 480, 640, 832]}
          sizes="(min-width: 1024px) 26rem, (min-width: 640px) 22rem, 18rem"
          alt={`${person.name}, ${person.role.toLowerCase()} of Buckleson`}
          loading="lazy"
          decoding="async"
          class="absolute inset-0 size-full object-cover object-top"
        />
        <span class="vision-frame" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
      </div>
      <figcaption class="mt-5">
        <p class="font-mono text-xs tracking-wide text-white uppercase">{person.name}</p>
        <p class="mt-1 text-sm text-white/60">{person.role}, Buckleson</p>
      </figcaption>
    </figure>

    <div class="lg:pt-2">
      <p class="flex items-center gap-4 font-mono text-xs tracking-wide text-white/70 uppercase">
        <span>{index && `(${index}) `}{label}</span>
        <span class="h-px flex-1 bg-white/20"></span>
        <span class="size-2.5 rounded-full ring-1 ring-white/50" aria-hidden="true"></span>
      </p>
      <p class="mt-8 text-[2rem] leading-[1.08] font-semibold tracking-tight text-balance text-white sm:text-[2.6rem] lg:text-[2.9rem]" data-words>{statement}</p>
      <div class="mt-10 max-w-[38rem] space-y-4 text-lg leading-relaxed text-pretty text-white/75" data-reveal>
        {story.map(paragraph => <p>{paragraph}</p>)}
        <div class="pt-3"><PrimaryCTA title={cta.title} url={localePath('en', cta.url)} /></div>
      </div>
    </div>
  </div>
</section>

<style>
  /* A thin inner frame with small diagonal marks at each corner. */
  .vision-frame {
    position: absolute;
    inset: 0.8rem;
    border-radius: 1rem;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.32);
    pointer-events: none;
  }
  .vision-frame i {
    position: absolute;
    width: 1.1rem;
    height: 1px;
    background: rgb(255 255 255 / 0.55);
  }
  .vision-frame i:nth-child(1) { left: 0.55rem; top: 0.95rem; transform: rotate(45deg); }
  .vision-frame i:nth-child(2) { right: 0.55rem; top: 0.95rem; transform: rotate(-45deg); }
  .vision-frame i:nth-child(3) { left: 0.55rem; bottom: 0.95rem; transform: rotate(-45deg); }
  .vision-frame i:nth-child(4) { right: 0.55rem; bottom: 0.95rem; transform: rotate(45deg); }
</style>
