---
import Glyph from '@components/ui/Glyph.astro';
import { BOOKING_URL } from '@data/constants';

/** Closing call to action on a dark sheet with slowly expanding rings. */
interface Props {
  claim: string;
  payoff: string;
  text: string;
  btn: string;
  email: string;
}

const { claim, payoff, text, btn, email } = Astro.props;
---

<section class="px-2 pb-3 sm:px-3">
  <div class="on-sheet relative isolate overflow-hidden rounded-[2rem] bg-sheet px-6 py-20 text-center text-white sm:py-28">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 grid place-items-center">
      {[0, 1, 2, 3].map(i => <span class="cta-ring absolute aspect-square w-[18rem] rounded-full border border-white/10" style={`animation-delay:${i * 1.5}s`}></span>)}
    </div>
    <h2 class="mx-auto max-w-3xl text-4xl leading-[1.02] font-semibold sm:text-6xl" data-reveal>
      <span class="block">{claim}</span>
      <span class="mark">{payoff}</span>
    </h2>
    <p class="mx-auto mt-5 max-w-md text-pretty text-white/70" data-reveal>{text}</p>
    <div class="mt-8 flex flex-col items-center gap-4" data-reveal>
      <a href={BOOKING_URL} class="cta-pill text-base"><span>{btn}</span><span class="cta-chip"><Glyph icon="calendar-check" class="size-4" /></span></a>
      <a href="mailto:vijay@buckleson.com" class="text-sm text-white/60 hover:text-white">{email}</a>
    </div>
  </div>
</section>

<style>
  .cta-ring { animation: cta-ring 6s cubic-bezier(0.22, 1, 0.36, 1) infinite; }
  @keyframes cta-ring { from { transform: scale(0.6); opacity: 0; } 20% { opacity: 1; } to { transform: scale(3.4); opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .cta-ring { animation: none; transform: scale(calc(1 + var(--i, 0))); opacity: 0.5; } }
</style>
