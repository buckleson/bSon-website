---
import MainLayout from '@/layouts/MainLayout.astro';
import PrimaryCTA from '@components/ui/buttons/PrimaryCTA.astro';
import Diagram from '@components/ui/Diagram.astro';
import Glyph from '@components/ui/Glyph.astro';
import ProductArt from '@components/ui/ProductArt.astro';
import ServiceMock from '@components/ui/ServiceMock.astro';
import { BOOKING_URL } from '@data/constants';
import type { DiagramName } from '@data/diagrams';
import { getCopy } from '@/copy';
import { localePath, type MarketingLocale } from '@utils/locale';

/**
 * Services in the original ScrewFast layout: a centred intro, then
 * alternating sections (text with two staggered visuals, or one diagram
 * beside the text), then a stats band.
 */
interface Props {
  locale: MarketingLocale;
}

const { locale } = Astro.props;
const copy = getCopy(locale).services;
type Mock = 'chain' | 'token' | 'wallet' | 'agent';
type Art = 'hyper-0x' | 'pavii' | 'hyper-wallet' | 'h0x-pay' | 'hyperrun';
const visuals: Record<string, { mock?: Mock; art?: Art }> = {
  'custom-blockchains': { mock: 'chain', art: 'hyper-0x' },
  'wallets-exchanges': { mock: 'wallet', art: 'hyper-wallet' },
  'ai-agent-security': { mock: 'agent', art: 'pavii' },
};
const icons = ['trend-up', 'briefcase', 'piggy-bank', 'sparkle'];
---

<MainLayout
  title={copy.title}
  seoTitle={copy.seoTitle}
  description={copy.metaDescription}
  ogImage="/og/services.png"
  kind={{ type: 'Service', services: copy.items.map(item => ({ name: item.title, description: item.content })) }}
>
  <section class="mx-auto max-w-[85rem] px-4 pt-14 pb-10 text-center sm:px-6 lg:px-8 lg:pt-20">
    <p class="font-mono text-xs tracking-wide text-muted uppercase" data-reveal>Services</p>
    <h1 class="mx-auto mt-4 max-w-4xl text-5xl leading-[1] font-semibold text-balance text-ink sm:text-6xl">{copy.intro.title}</h1>
    <p class="mx-auto mt-5 max-w-2xl text-lg text-pretty text-muted" data-reveal>{copy.intro.subTitle}</p>
    <div class="mt-8" data-reveal><PrimaryCTA title={copy.intro.cta} url={BOOKING_URL} /></div>
    <nav aria-label="Services" class="mt-10 flex flex-wrap justify-center gap-2" data-reveal>
      {copy.items.map(item => (
        <a href={`#${item.id}`} class="rounded-full bg-card px-4 py-2 text-sm font-medium text-ink ring-1 ring-line transition hover:ring-orange-500">{item.title}</a>
      ))}
    </nav>
  </section>

  {copy.items.map((item, index) => {
    const pair = visuals[item.id];
    const text = (
      <div data-reveal>
        <h2 class="text-4xl leading-[1.05] font-semibold text-balance text-ink">{item.title}</h2>
        <p class="mt-4 max-w-prose text-pretty text-muted sm:text-lg">{item.content}</p>
        <ul class="mt-6 space-y-2.5">
          {item.points.map(point => <li class="flex items-center gap-2.5 text-ink"><Glyph icon="check-circle" class="size-5 text-orange-600 dark:text-orange-400" />{point}</li>)}
        </ul>
        {'link' in item && item.link && <div class="mt-7"><PrimaryCTA title={item.link.title} url={localePath(locale, item.link.url)} /></div>}
      </div>
    );
    return pair ? (
      <section id={item.id} class="mx-auto max-w-[85rem] scroll-mt-24 items-center gap-16 px-4 py-14 sm:px-6 lg:grid lg:grid-cols-2 lg:px-8 lg:py-20">
        {text}
        <div class="mt-10 grid grid-cols-2 gap-4 lg:mt-0" data-reveal>
          <div class="h-72"><ServiceMock kind={pair.mock!} /></div>
          <div class="mt-8 overflow-hidden rounded-[1.2rem] ring-1 ring-line lg:mt-14"><ProductArt product={pair.art!} class="aspect-[440/360]" /></div>
        </div>
      </section>
    ) : (
      <section id={item.id} class="mx-auto max-w-[85rem] scroll-mt-24 items-center gap-16 px-4 py-14 sm:px-6 lg:grid lg:grid-cols-2 lg:px-8 lg:py-20">
        <div class="mb-10 lg:mb-0" data-reveal><Diagram name={item.diagram as DiagramName} /></div>
        {text}
      </section>
    );
  })}

  <section class="mx-auto max-w-[85rem] px-4 py-14 sm:px-6 lg:px-8">
    <div class="on-sheet rounded-[2rem] bg-sheet p-6 text-white sm:p-10">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:items-end">
        <div data-reveal>
          <h2 class="text-3xl font-semibold text-balance sm:text-4xl">{copy.stats.title}</h2>
          <p class="mt-3 text-pretty text-white/70">{copy.stats.subTitle}</p>
        </div>
        <dl class="grid grid-cols-2 gap-6 sm:grid-cols-4" data-reveal-group>
          {copy.stats.items.map((stat, i) => (
            <div data-reveal-item>
              <Glyph icon={icons[i]} class="size-6 text-orange-300" />
              <dt class="sr-only">{stat.label}</dt>
              <dd class="mt-3 font-display text-3xl font-semibold tabular-nums">{stat.value}</dd>
              <dd class="mt-1 text-sm text-white/65">{stat.label}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-[85rem] px-4 pb-20 text-center sm:px-6 lg:px-8">
    <h2 class="text-3xl font-semibold text-ink sm:text-4xl" data-reveal><span class="block">Start with</span><span class="mark">a pilot.</span></h2>
    <p class="mx-auto mt-3 max-w-xl text-muted" data-reveal>One use case, one forward-deployed engineer, success metrics agreed up front.</p>
    <div class="mt-7" data-reveal><PrimaryCTA title="Book a call" url={BOOKING_URL} /></div>
  </section>
</MainLayout>
