---
import MainLayout from '@/layouts/MainLayout.astro';
import CardBlog from '@components/ui/cards/CardBlog.astro';
import BlogCover from '@components/ui/BlogCover.astro';
import Diagram from '@components/ui/Diagram.astro';
import Icon from '@components/ui/icons/Icon.astro';
import PrimaryCTA from '@components/ui/buttons/PrimaryCTA.astro';
import SocialShare from '@components/ui/buttons/SocialShare.astro';
import { Image } from 'astro:assets';
import { render, type CollectionEntry } from 'astro:content';
import { formatDate } from '@utils/utils';
import { entriesFor, localeOf, slugOf } from '@utils/content';
import { BOOKING_URL } from '@data/constants';
import { localePath } from '@utils/locale';

/** One blog post: answer-first intro, optional diagram, body, FAQ, CTA. */
interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const data = post.data;
const locale = localeOf(post);
const { Content } = await render(post);

// Related: posts sharing the most tags, newest first.
const others = (await entriesFor('blog', locale)).filter(entry => entry.id !== post.id);
const related = others
  .map(entry => ({ entry, score: entry.data.tags.filter(tag => data.tags.includes(tag)).length }))
  .sort((a, b) => b.score - a.score)
  .slice(0, 3)
  .map(({ entry }) => entry);
---

<MainLayout
  title={data.title}
  seoTitle={data.title.length > 52 ? data.title : `${data.title} | Buckleson`}
  description={data.description}
  ogImage={`/og/blog-${slugOf(post)}.png`}
  kind={{
    type: 'BlogPosting',
    datePublished: data.pubDate,
    dateModified: data.updatedDate,
    author: data.author,
    tags: data.tags,
  }}
  faqs={data.faqs}
>
  <article class="mx-auto max-w-3xl px-4 pt-10 pb-12 sm:px-6 lg:px-8 lg:pt-16">
    <nav aria-label="Breadcrumb" class="text-sm text-muted">
      <a href={localePath('en', '/blog/')} class="hover:text-orange-700 dark:hover:text-orange-300">Blog</a>
      {data.tags[0] && <span aria-hidden="true"> / </span>}
      {data.tags[0]}
    </nav>
    <h1 class="mt-4 text-4xl leading-[1.05] font-semibold text-balance text-ink sm:text-5xl">
      {data.title}
    </h1>
    <div class="mt-6 flex items-center gap-3 text-sm text-muted">
      <Image src={data.authorImage} alt={data.authorImageAlt} width={40} height={40} class="size-10 rounded-full" />
      <div>
        <p class="font-semibold text-ink">{data.author}</p>
        <p>
          <time datetime={data.pubDate.toISOString()}>{formatDate(data.pubDate, locale)}</time>
          {data.updatedDate && (
            <>
              <span aria-hidden="true"> · </span>Updated <time datetime={data.updatedDate.toISOString()}>{formatDate(data.updatedDate, locale)}</time>
            </>
          )}
          <span aria-hidden="true"> · </span>{data.readTime} min read
        </p>
      </div>
    </div>

    {data.diagram ? (
      <Diagram name={data.diagram} class="mt-10" />
    ) : (
      <div class="relative mt-10 overflow-hidden rounded-[1.6rem] pt-[52%] ring-1 ring-line"><BlogCover seed={slugOf(post)} label="" fill /></div>
    )}

    <div class="prose prose-lg prose-neutral dark:prose-invert prose-headings:font-semibold mt-10 max-w-none text-pretty prose-headings:tracking-tight prose-a:text-orange-700 prose-a:decoration-orange-300 prose-a:underline-offset-4 dark:prose-a:text-orange-300 dark:prose-a:decoration-orange-700">
      <Content />
    </div>

    {data.faqs.length > 0 && (
      <section class="mt-14" aria-labelledby="faq-title">
        <h2 id="faq-title" class="text-2xl font-semibold text-ink">Frequently asked questions</h2>
        <div class="mt-4 divide-y divide-line">
          {data.faqs.map(faq => (
            <details class="group py-4">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 font-semibold text-ink">
                {faq.question}
                <Icon name="chevronDown" class="size-5 shrink-0 text-orange-600 transition duration-300 group-open:rotate-180 dark:text-orange-400" />
              </summary>
              <p class="mt-2 text-pretty text-muted">{faq.answer}</p>
            </details>
          ))}
        </div>
      </section>
    )}

    <div class="on-sheet mt-14 rounded-[2rem] bg-sheet p-8 text-center">
      <p class="text-2xl font-bold text-balance text-white">Building something like this?</p>
      <p class="mx-auto mt-2 max-w-md text-pretty text-white/70">Talk to a Buckleson engineer for 30 minutes. No slides, just your use case.</p>
      <div class="mt-6"><PrimaryCTA title="Book a call" url={BOOKING_URL} /></div>
    </div>

    <div class="mt-10 flex justify-end">
      <SocialShare pageTitle={data.title} />
    </div>
  </article>

  {related.length > 0 && (
    <section class="mx-auto max-w-[85rem] px-4 pb-20 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-semibold text-ink">Related articles</h2>
      <div class="mt-6 grid gap-5 lg:grid-cols-2">
        {related.slice(0, 2).map(entry => <CardBlog blogEntry={entry} />)}
      </div>
    </section>
  )}
</MainLayout>
