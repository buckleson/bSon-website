---
import MainLayout from '@/layouts/MainLayout.astro';
import SectionHead from '@components/home/SectionHead.astro';
import PrimaryCTA from '@components/ui/buttons/PrimaryCTA.astro';
import SecondaryCTA from '@components/ui/buttons/SecondaryCTA.astro';
import ServiceMock from '@components/ui/ServiceMock.astro';
import FeatureBento from '@components/ui/FeatureBento.astro';
import FlowStack from '@components/ui/FlowStack.astro';
import IsoFigure from '@components/ui/IsoFigure.astro';
import Glyph from '@components/ui/Glyph.astro';
import { BOOKING_URL } from '@data/constants';
import { flows } from '@data/explainers';
import { servicePage } from '@data/services';
import { getCopy } from '@/copy';
import { localePath } from '@utils/locale';

/**
 * One service: what it is and what you get (a bento), how it works (two or
 * three labelled figures, then a request travelling through the layers),
 * how we work with you (four steps), then reading, FAQ and a call to action.
 */
interface Props {
  id: string;
}

const { id } = Astro.props;
const page = servicePage(id)!;
const item = getCopy('en').services.items.find(entry => entry.id === id)!;
const flow = flows[page.flow];
const href = (url: string) => localePath('en', url);
---

<MainLayout
  title={item.title}
  seoTitle={page.seoTitle}
  description={page.description}
  ogImage={`/og/services-${id}.png`}
  kind={{ type: 'Service', services: [{ name: item.title, description: page.description }] }}
  faqs={page.faqs}
>
  <section class="mx-auto grid max-w-[85rem] grid-cols-1 items-center gap-10 px-4 pt-10 pb-12 sm:px-6 lg:grid-cols-[minmax(0,6fr)_minmax(0,5fr)] lg:px-8 lg:pt-14">
    <div>
      <p class="font-mono text-xs tracking-wide text-muted uppercase">Service</p>
      <h1 class="mt-3 text-lg font-semibold text-balance text-orange-700 dark:text-orange-300">{item.title}</h1>
      <p class="mt-3 font-display text-5xl leading-[0.98] font-semibold text-balance text-ink sm:text-6xl">
        <span class="block">{page.claim}</span>
        <span class="mark">{page.payoff}</span>
      </p>
      <p class="mt-6 max-w-[54ch] text-lg leading-relaxed text-pretty text-muted">{page.intro}</p>
      <ul class="mt-6 flex flex-wrap gap-2">
        {page.outcomes.map(outcome => (
          <li class="inline-flex items-center gap-1.5 rounded-full bg-card px-3 py-1.5 text-sm font-medium text-ink ring-1 ring-line"><Glyph icon="check-circle" class="size-4 text-orange-600 dark:text-orange-400" />{outcome}</li>
        ))}
      </ul>
      <div class="mt-8 flex flex-wrap gap-3">
        <PrimaryCTA title="Book a call" url={BOOKING_URL} />
        <SecondaryCTA title="How it works" url="#how-it-works" />
      </div>
    </div>
    <div class="h-72 sm:h-80"><ServiceMock kind={page.mock} /></div>
  </section>

  <section class="mx-auto max-w-[85rem] px-4 py-14 sm:px-6 lg:px-8 lg:py-20" aria-labelledby="deliver-title">
    <SectionHead index="01" label="What we deliver" claim="Everything you need," payoff="built and run with you." id="deliver-title" />
    <FeatureBento class="mt-10" items={page.deliverables} highlight={page.highlight} chips={page.outcomes} />
  </section>

  <section id="how-it-works" class="mx-auto max-w-[85rem] scroll-mt-24 px-4 py-14 sm:px-6 lg:px-8 lg:py-20" aria-labelledby="how-title">
    <SectionHead index="02" label="How it works" claim="See the machine" payoff="behind the service." body="Each figure is live. Select a step under it to jump to that stage, and watch the labels explain each part." id="how-title" />
    <div class="mt-10 grid grid-cols-1 gap-12">
      {page.figures.map((figure, i) => (
        <div class="grid grid-cols-1 items-start gap-6 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:gap-10">
          <div class="lg:sticky lg:top-28">
            <p class="font-mono text-xs text-muted">Figure {i + 1} of {page.figures.length}</p>
            <h3 class="mt-2 text-2xl font-semibold text-balance text-ink">{figure.title}</h3>
            <p class="mt-3 max-w-[48ch] leading-relaxed text-pretty text-muted">{figure.text}</p>
          </div>
          <IsoFigure name={figure.name} />
        </div>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-[85rem] px-4 py-14 sm:px-6 lg:px-8 lg:py-20" aria-labelledby="flow-title">
    <SectionHead index="03" label="Step by step" claim={`Follow one ${flow.unit}`} payoff="through every layer." body={`Watch a ${flow.unit} pass through each layer, and see where a bad one stops and why.`} id="flow-title" />
    <FlowStack name={page.flow} class="mt-10" />
  </section>

  <section class="mx-auto max-w-[85rem] px-4 py-14 sm:px-6 lg:px-8 lg:py-20" aria-labelledby="process-title">
    <SectionHead index="04" label="How we work" claim="Small first," payoff="then production." id="process-title" />
    <ol class="process mt-10 grid grid-cols-1 gap-3 md:grid-cols-2 lg:grid-cols-4" data-reveal-group>
      {page.steps.map((step, i) => (
        <li class="relative rounded-[1.6rem] bg-card p-6 ring-1 ring-line" data-reveal-item>
          <div class="flex items-center justify-between">
            <span class="grid size-11 place-items-center rounded-xl bg-orange-100 text-orange-700 dark:bg-orange-950 dark:text-orange-300"><Glyph icon={step.icon} class="size-5" /></span>
            <span class="font-mono text-xs text-muted">Step {i + 1}</span>
          </div>
          <h3 class="mt-5 text-lg font-semibold text-ink">{step.title}</h3>
          <p class="mt-1.5 text-sm leading-relaxed text-pretty text-muted">{step.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="mx-auto grid max-w-[85rem] grid-cols-1 gap-12 px-4 py-14 sm:px-6 lg:grid-cols-3 lg:px-8 lg:py-20">
    <div data-reveal>
      <h2 class="text-3xl font-semibold text-balance text-ink">{item.title} questions</h2>
      <ul class="mt-6 space-y-3">
        {page.related.map(link => (
          <li><a href={href(link.url)} class="inline-flex items-center gap-2 font-medium text-orange-700 hover:underline dark:text-orange-300"><Glyph icon="arrow-right" class="size-4" />{link.title}</a></li>
        ))}
        <li><a href={href('/services/')} class="inline-flex items-center gap-2 font-medium text-orange-700 hover:underline dark:text-orange-300"><Glyph icon="squares-four" class="size-4" />All services</a></li>
      </ul>
    </div>
    <div class="divide-y divide-line lg:col-span-2" data-reveal>
      {page.faqs.map((faq, index) => (
        <details class="group py-5" open={index === 0}>
          <summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-lg font-semibold text-ink">
            {faq.question}
            <span class="grid size-8 shrink-0 place-items-center rounded-full bg-card ring-1 ring-line transition duration-300 group-open:rotate-45"><Glyph icon="plus" class="size-4" /></span>
          </summary>
          <p class="mt-3 max-w-[65ch] text-pretty text-muted">{faq.answer}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="px-2 pb-6 sm:px-3">
    <div class="on-sheet rounded-[2rem] bg-sheet px-6 py-16 text-center text-white" data-reveal>
      <h2 class="mx-auto max-w-2xl text-3xl font-semibold text-balance sm:text-5xl">
        <span class="block">Start with</span>
        <span class="mark">a pilot.</span>
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-pretty text-white/70">Thirty minutes with one of our engineers is enough to turn your idea into a pilot on your own L2.</p>
      <div class="mt-8"><PrimaryCTA title="Book a call" url={BOOKING_URL} /></div>
    </div>
  </section>
</MainLayout>
