---
import MainLayout from '@/layouts/MainLayout.astro';
import HeroSection from '@components/sections/landing/HeroSection.astro';
import HeroSectionAlt from '@components/sections/landing/HeroSectionAlt.astro';
import PromptShieldAnimation from '@components/sections/landing/PromptShieldAnimation.astro';
import LogoStrip from '@components/sections/landing/LogoStrip.astro';
import DomainsSection from '@components/sections/landing/DomainsSection.astro';
import HowItWorks from '@components/sections/landing/HowItWorks.astro';
import ClientsSection from '@components/sections/landing/ClientsSection.astro';
import ProofStrip from '@components/sections/landing/ProofStrip.astro';
import LatestPosts from '@components/sections/landing/LatestPosts.astro';
import FAQ from '@components/sections/misc/FAQ.astro';
import AnnouncementBanner from '@components/ui/banners/AnnouncementBanner.astro';
import { BOOKING_URL, partnersData } from '@data/constants';
import type { SystemName } from '@data/systems';
import { getCopy } from '@/copy';
import { localePath, type MarketingLocale } from '@utils/locale';

/** The home page: who we are, what we build, how it works, proof. */
interface Props {
  locale: MarketingLocale;
}

const { locale } = Astro.props;
const t = getCopy(locale);
const copy = t.home;
---

<MainLayout seoTitle={copy.metaTitle} kind={{ type: 'Home' }} faqs={t.data.faqs.faqs}>
  <AnnouncementBanner
    btnId="dismiss-button"
    btnTitle={copy.banner}
    url={localePath(locale, '/products/h0x-pay/')}
  />

  <HeroSection
    lead={copy.hero.lead}
    phrases={copy.hero.phrases}
    intro={copy.hero.intro}
    primaryBtn={copy.hero.primaryBtn}
    primaryBtnURL={BOOKING_URL}
    secondaryBtn={copy.hero.secondaryBtn}
    secondaryBtnURL={localePath(locale, '/products/hyper-0x/')}
    proof={copy.hero.proof}
  >
    <PromptShieldAnimation slot="visual" />
  </HeroSection>

  <LogoStrip title={copy.logos} />

  <DomainsSection title={copy.domains.title} subTitle={copy.domains.subTitle} items={copy.domains.items} />

  <HowItWorks
    title={copy.how.title}
    subTitle={copy.how.subTitle}
    tabs={copy.how.tabs.map(tab => ({ ...tab, system: tab.system as SystemName }))}
  />

  <ClientsSection title={copy.clients.title} subTitle={copy.clients.subTitle} partners={partnersData} />

  <ProofStrip title={copy.proof.title} stats={copy.proof.stats} quote={copy.proof.quote} />

  <FAQ title={copy.faqTitle} faqs={t.data.faqs} />

  <LatestPosts title={copy.latestPosts.title} cta={copy.latestPosts.cta} />

  <HeroSectionAlt title={copy.heroAlt.title} subTitle={copy.heroAlt.subTitle} url={BOOKING_URL} />
</MainLayout>
