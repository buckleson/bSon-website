---
import MainLayout from '@/layouts/MainLayout.astro';
import HomeHero from '@components/home/HomeHero.astro';
import GlanceBento from '@components/home/GlanceBento.astro';
import ProductsAccordion from '@components/home/ProductsAccordion.astro';
import ServicesBento from '@components/home/ServicesBento.astro';
import HowItWorks from '@components/sections/landing/HowItWorks.astro';
import WhySection from '@components/home/WhySection.astro';
import ProcessSteps from '@components/home/ProcessSteps.astro';
import VisionSection from '@components/home/VisionSection.astro';
import FaqTimeline from '@components/home/FaqTimeline.astro';
import InsightsSection from '@components/home/InsightsSection.astro';
import FinalCta from '@components/home/FinalCta.astro';
import Box from '@components/home/Box.astro';
import { BOOKING_URL } from '@data/constants';
import type { SystemName } from '@data/systems';
import { getCopy } from '@/copy';
import { localePath, type MarketingLocale } from '@utils/locale';

/**
 * Home, one idea per section, each in its own box: who we are (hero), proof
 * at a glance, products, services, a live transaction, why Hyper 0X (three
 * stacking cards), how we work, vision, FAQ, insights and a closing call to
 * action.
 */
interface Props {
  locale: MarketingLocale;
}

const { locale } = Astro.props;
const t = getCopy(locale);
const c = t.home;
---

<MainLayout seoTitle={c.metaTitle} kind={{ type: 'Home' }} faqs={t.data.faqs.faqs}>
  <HomeHero
    badge={c.hero.badge}
    lead={c.hero.lead}
    phrases={c.hero.phrases}
    intro={c.hero.intro}
    primary={{ title: c.hero.primaryBtn, url: BOOKING_URL }}
    secondary={{ title: c.hero.secondaryBtn, url: localePath(locale, '/products/') }}
    chips={c.hero.chips}
  />

  <Box><GlanceBento label={c.glanceIntro.label} statement={c.glanceIntro.statement} pilot={c.glanceIntro.pilot} logosTitle={c.logos} /></Box>
  <Box><ProductsAccordion index="01" {...c.products} /></Box>
  <Box><ServicesBento index="02" {...c.services} /></Box>
  <Box><HowItWorks index="03" {...c.how} tabs={c.how.tabs.map(tab => ({ ...tab, system: tab.system as SystemName }))} /></Box>
  <Box><WhySection index="04" {...c.why} /></Box>
  <Box><ProcessSteps index="05" {...c.process} /></Box>
  <Box tone="dark"><VisionSection index="06" {...c.vision} /></Box>
  <Box><FaqTimeline index="07" {...c.faq} faqs={t.data.faqs.faqs} /></Box>
  <Box><InsightsSection index="08" {...c.latestPosts} /></Box>
  <FinalCta {...c.finalCta} />
</MainLayout>
