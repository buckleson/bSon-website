---
import MainLayout from '@/layouts/MainLayout.astro';
import HomeHero from '@components/home/HomeHero.astro';
import GlanceBento from '@components/home/GlanceBento.astro';
import WhySection from '@components/home/WhySection.astro';
import ProductsAccordion from '@components/home/ProductsAccordion.astro';
import ServicesScroll from '@components/home/ServicesScroll.astro';
import ProcessSticky from '@components/home/ProcessSticky.astro';
import HowItWorks from '@components/sections/landing/HowItWorks.astro';
import VisionSection from '@components/home/VisionSection.astro';
import FaqTimeline from '@components/home/FaqTimeline.astro';
import InsightsSection from '@components/home/InsightsSection.astro';
import FinalCta from '@components/home/FinalCta.astro';
import { BOOKING_URL } from '@data/constants';
import type { SystemName } from '@data/systems';
import { getCopy } from '@/copy';
import { localePath, type MarketingLocale } from '@utils/locale';

/**
 * Home: who we are (hero), proof at a glance, why we built our own chain,
 * products, services, how we work, a live system view, vision, FAQ,
 * insights and a closing call to action. One idea per section.
 */
interface Props {
  locale: MarketingLocale;
}

const { locale } = Astro.props;
const t = getCopy(locale);
const c = t.home;
const over = 'relative z-[1] -mt-8 rounded-t-[2rem] bg-ground';
---

<MainLayout seoTitle={c.metaTitle} kind={{ type: 'Home' }} faqs={t.data.faqs.faqs}>
  <HomeHero
    badge={c.hero.badge}
    lead={c.hero.lead}
    phrases={c.hero.phrases}
    intro={c.hero.intro}
    primary={{ title: c.hero.primaryBtn, url: BOOKING_URL }}
    secondary={{ title: c.hero.secondaryBtn, url: localePath(locale, '/products/') }}
    counter={{ value: 2000000, label: c.hero.counterLabel }}
    chips={c.hero.chips}
  />

  <GlanceBento label={c.glanceIntro.label} statement={c.glanceIntro.statement} quote={c.glanceIntro.quote} logosTitle={c.logos} />

  <WhySection {...c.why} />

  <div class={over}>
    <ProductsAccordion {...c.products} />
    <ServicesScroll {...c.services} />
  </div>

  <ProcessSticky {...c.process} />

  <div class={over}>
    <HowItWorks index="05" {...c.how} tabs={c.how.tabs.map(tab => ({ ...tab, system: tab.system as SystemName }))} />
  </div>

  <VisionSection {...c.vision} />

  <div class={over}>
    <FaqTimeline {...c.faq} faqs={t.data.faqs.faqs} />
    <InsightsSection {...c.latestPosts} />
  </div>

  <FinalCta {...c.finalCta} />
</MainLayout>
