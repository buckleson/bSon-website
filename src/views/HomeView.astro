---
import MainLayout from '@/layouts/MainLayout.astro';
import HomeHero from '@components/home/HomeHero.astro';
import GlanceBento from '@components/home/GlanceBento.astro';
import ProductsAccordion from '@components/home/ProductsAccordion.astro';
import ServicesBento from '@components/home/ServicesBento.astro';
import HowItWorks from '@components/sections/landing/HowItWorks.astro';
import WhySection from '@components/home/WhySection.astro';
import ProcessSteps from '@components/home/ProcessSteps.astro';
import VisionSection from '@components/home/VisionSection.astro';
import FaqTimeline from '@components/home/FaqTimeline.astro';
import InsightsSection from '@components/home/InsightsSection.astro';
import FinalCta from '@components/home/FinalCta.astro';
import { BOOKING_URL } from '@data/constants';
import type { SystemName } from '@data/systems';
import { getCopy } from '@/copy';
import { localePath, type MarketingLocale } from '@utils/locale';

/**
 * Home, one idea per section: who we are (hero), proof at a glance, products,
 * services, a live transaction, why we built our own chain, how we work,
 * vision, FAQ, insights and a closing call to action.
 */
interface Props {
  locale: MarketingLocale;
}

const { locale } = Astro.props;
const t = getCopy(locale);
const c = t.home;
const over = 'relative z-[1] -mt-8 rounded-t-[2rem] bg-ground';
---

<MainLayout seoTitle={c.metaTitle} kind={{ type: 'Home' }} faqs={t.data.faqs.faqs}>
  <HomeHero
    badge={c.hero.badge}
    lead={c.hero.lead}
    phrases={c.hero.phrases}
    intro={c.hero.intro}
    primary={{ title: c.hero.primaryBtn, url: BOOKING_URL }}
    secondary={{ title: c.hero.secondaryBtn, url: localePath(locale, '/products/') }}
    chips={c.hero.chips}
  />

  <GlanceBento label={c.glanceIntro.label} statement={c.glanceIntro.statement} pilot={c.glanceIntro.pilot} logosTitle={c.logos} />
  <ProductsAccordion index="01" {...c.products} />
  <ServicesBento index="02" {...c.services} />
  <HowItWorks index="03" {...c.how} tabs={c.how.tabs.map(tab => ({ ...tab, system: tab.system as SystemName }))} />

  <WhySection index="04" {...c.why} />

  <div class={over}>
    <ProcessSteps index="05" {...c.process} />
  </div>

  <VisionSection index="06" {...c.vision} />

  <div class={over}>
    <FaqTimeline index="07" {...c.faq} faqs={t.data.faqs.faqs} />
    <InsightsSection index="08" {...c.latestPosts} />
  </div>

  <FinalCta {...c.finalCta} />
</MainLayout>
