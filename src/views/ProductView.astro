---
import MainLayout from '@/layouts/MainLayout.astro';
import ProductDetail from '@components/sections/products/ProductDetail.astro';
import type { CollectionEntry } from 'astro:content';
import { slugOf } from '@utils/content';

/** One product page. */
interface Props {
  product: CollectionEntry<'products'>;
}

const { product } = Astro.props;
---

<MainLayout
  title={product.data.title}
  seoTitle={product.data.seoTitle}
  description={product.data.description}
  ogImage={`/og/products-${slugOf(product)}.png`}
  kind={{ type: 'Product', status: product.data.status }}
  faqs={product.data.faqs}
>
  <ProductDetail product={product} />
</MainLayout>
