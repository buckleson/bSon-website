---
import MainLayout from '@/layouts/MainLayout.astro';
import PrimaryCTA from '@components/ui/buttons/PrimaryCTA.astro';
import CardProduct from '@components/ui/cards/CardProduct.astro';
import Diagram from '@components/ui/Diagram.astro';
import Glyph from '@components/ui/Glyph.astro';
import TestimonialsSectionAlt from '@components/sections/testimonials/TestimonialsSectionAlt.astro';
import buckleson from '@images/brand/buckleson.png';
import hyperWallet from '@images/brand/hyper-wallet.png';
import pavii from '@images/brand/pavii.png';
import { BOOKING_URL } from '@data/constants';
import { entriesFor } from '@utils/content';
import { getCopy } from '@/copy';
import { localePath, type MarketingLocale } from '@utils/locale';

/**
 * The products index in the original layout: a heading row, then a grid of
 * large product cards alternating wide and small, a "why build on Hyper 0X"
 * band with the platform diagram, and proof points.
 */
interface Props {
  locale: MarketingLocale;
}

const { locale } = Astro.props;
const copy = getCopy(locale).productsIndex;
const products = await entriesFor('products', locale);
// Row pattern for five products plus a custom-build card: wide+small,
// small+wide, wide+small.
const wide = [true, false, false, true, true];

const avatarSrcs = [buckleson.src, hyperWallet.src, pavii.src];
const testimonials = copy.testimonials.quotes.map((quote, index) => ({ ...quote, avatarSrc: avatarSrcs[index] }));
---

<MainLayout title={copy.title} seoTitle={copy.seoTitle} description={copy.metaDescription} ogImage="/og/products.png" kind={{ type: 'CollectionPage' }}>
  <div class="mx-auto max-w-[85rem] px-4 pt-12 pb-16 sm:px-6 lg:px-8 lg:pt-16">
    <div class="mb-8 flex flex-col gap-6 md:mb-12 md:flex-row md:items-end md:justify-between">
      <div class="max-w-2xl" data-reveal>
        <p class="font-mono text-xs tracking-wide text-muted uppercase">Products</p>
        <h1 class="mt-3 text-4xl leading-[1.04] font-semibold text-ink sm:text-5xl">{copy.heading}</h1>
        <p class="mt-4 max-w-[58ch] text-pretty text-muted">{copy.subTitle}</p>
      </div>
      <div data-reveal><PrimaryCTA title="Proof points" url="#testimonials" /></div>
    </div>

    <section class="grid grid-cols-1 gap-4 md:grid-cols-3 md:gap-5">
      {products.map((product, index) => <CardProduct product={product} wide={wide[index]} />)}
      <a href={localePath(locale, '/services/#custom-blockchains')} class="group relative flex h-64 flex-col justify-between overflow-hidden rounded-[1.6rem] bg-orange-600 p-6 text-white md:h-80 dark:bg-orange-700" data-reveal>
        <span class="grid size-12 place-items-center rounded-2xl bg-white/15"><Glyph icon="stack" class="size-6" /></span>
        <span>
          <span class="block text-2xl font-semibold">Need your own chain?</span>
          <span class="mt-1 block text-sm text-white/80">We build private L2s on Hyper 0X for banks, fintechs and asset issuers.</span>
          <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold">See services<Glyph icon="arrow-right" class="size-4 transition group-hover:translate-x-1" /></span>
        </span>
      </a>
    </section>
  </div>

  <section class="mx-auto max-w-[85rem] px-4 pb-16 sm:px-6 lg:px-8">
    <div class="grid gap-10 rounded-[2rem] bg-card p-6 ring-1 ring-line sm:p-10 lg:grid-cols-2">
      <div data-reveal>
        <h2 class="text-3xl font-semibold text-balance text-ink sm:text-4xl">{copy.why.title}</h2>
        <p class="mt-3 text-pretty text-muted">{copy.why.subTitle}</p>
        <ul class="mt-6 space-y-3">
          {copy.why.benefits.map(benefit => (
            <li class="flex gap-3 text-ink"><Glyph icon="check-circle" class="mt-0.5 size-5 shrink-0 text-orange-600 dark:text-orange-400" />{benefit}</li>
          ))}
        </ul>
        <div class="mt-7"><PrimaryCTA title="Book a call" url={BOOKING_URL} /></div>
      </div>
      <div class="lg:col-span-2" data-reveal><Diagram name="platform" /></div>
    </div>
  </section>

  <TestimonialsSectionAlt title={copy.testimonials.title} testimonials={testimonials} />
</MainLayout>
