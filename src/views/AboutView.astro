---
import MainLayout from '@/layouts/MainLayout.astro';
import VisionSection from '@components/home/VisionSection.astro';
import FinalCta from '@components/home/FinalCta.astro';
import Glyph from '@components/ui/Glyph.astro';
import { Image } from 'astro:assets';
import { team } from '@data/team';
import { getCopy } from '@/copy';
import type { MarketingLocale } from '@utils/locale';

/**
 * About: our story, the numbers behind it, our vision, the team (shown once
 * team data exists) and a call to action.
 */
interface Props {
  locale: MarketingLocale;
}

const { locale } = Astro.props;
const t = getCopy(locale);
const copy = t.about;
const icons = ['trend-up', 'briefcase', 'piggy-bank', 'sparkle'];
---

<MainLayout title={copy.title} seoTitle={copy.seoTitle} description={copy.metaDescription} kind={{ type: 'AboutPage' }}>
  <section class="mx-auto max-w-[85rem] px-4 pt-14 pb-16 sm:px-6 lg:px-8 lg:pt-20">
    <p class="font-mono text-xs tracking-wide text-muted uppercase" data-reveal>{copy.label}</p>
    <h1 class="mt-4 max-w-4xl text-5xl leading-[1] font-semibold text-ink sm:text-6xl lg:text-7xl" data-reveal>
      <span class="block">{copy.claim}</span>
      <span class="mark">{copy.payoff}</span>
    </h1>
  </section>

  <section class="mx-auto max-w-[85rem] px-4 pb-20 sm:px-6 lg:px-8">
    <div class="grid gap-10 rounded-[2rem] bg-card p-6 ring-1 ring-line sm:p-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]">
      <div>
        <p class="flex items-center gap-4 font-mono text-xs tracking-wide text-muted uppercase">{copy.story.label}<span class="h-px flex-1 bg-line"></span></p>
        <h2 class="mt-5 text-3xl leading-tight font-semibold text-balance text-ink sm:text-4xl">{copy.story.title}</h2>
      </div>
      <div class="space-y-5 text-lg leading-relaxed text-pretty text-muted">
        {copy.story.paragraphs.map(paragraph => <p data-reveal>{paragraph}</p>)}
      </div>
    </div>
    <dl class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-4" data-reveal-group>
      {copy.stats.map((stat, index) => (
        <div class="rounded-[1.6rem] bg-card p-6 ring-1 ring-line" data-reveal-item>
          <Glyph icon={icons[index]} class="size-7 text-orange-600 dark:text-orange-400" />
          <dt class="sr-only">{stat.label}</dt>
          <dd class="mt-6 font-display text-4xl font-semibold text-ink tabular-nums">{stat.value}</dd>
          <dd class="mt-1 text-sm text-muted">{stat.label}</dd>
        </div>
      ))}
    </dl>
  </section>

  <VisionSection {...t.home.vision} cta={{ title: 'Talk to us', url: '/contact/' }} />

  {team.length > 0 && (
    <section class="relative z-[1] -mt-8 rounded-t-[2rem] bg-ground">
      <div class="mx-auto max-w-[85rem] px-4 py-20 sm:px-6 lg:px-8">
        <p class="font-mono text-xs tracking-wide text-muted uppercase">{copy.team.label}</p>
        <h2 class="mt-4 text-4xl font-semibold text-ink"><span class="block">{copy.team.claim}</span><span class="mark">{copy.team.payoff}</span></h2>
        <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {team.map(member => (
            <li class="team-card group relative aspect-[4/5] overflow-hidden rounded-[1.6rem] bg-card ring-1 ring-line" tabindex="0">
              <Image src={member.photo} alt={member.name} class="team-photo absolute inset-0 size-full object-cover" widths={[320, 640]} sizes="(min-width: 1024px) 25vw, 50vw" />
              <div class="team-front absolute inset-x-0 bottom-0 bg-card/90 p-4 backdrop-blur">
                <p class="font-mono text-xs tracking-wide text-ink uppercase">{member.name}</p>
                <p class="text-sm text-muted">{member.role}</p>
              </div>
              <div class="team-back absolute inset-0 flex flex-col justify-between bg-card p-6">
                <p class="text-pretty text-ink">{member.bio}</p>
                <div>
                  <p class="font-mono text-xs tracking-wide text-ink uppercase">{member.name}</p>
                  <p class="text-sm text-muted">{member.role}</p>
                  {member.linkedin && <a href={member.linkedin} class="mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-orange-700 dark:text-orange-300"><Glyph icon="linkedin-logo" class="size-4" />LinkedIn</a>}
                </div>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <div class="relative z-[1] -mt-8 rounded-t-[2rem] bg-ground pt-12">
    <FinalCta {...t.home.finalCta} />
  </div>
</MainLayout>

<style>
  .team-back { opacity: 0; transform: translateY(12px); transition: opacity 300ms ease, transform 400ms cubic-bezier(0.22, 1, 0.36, 1); }
  .team-card:hover .team-back,
  .team-card:focus-visible .team-back { opacity: 1; transform: none; }
</style>
