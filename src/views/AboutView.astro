---
import MainLayout from '@/layouts/MainLayout.astro';
import VisionSection from '@components/home/VisionSection.astro';
import SectionHead from '@components/home/SectionHead.astro';
import FinalCta from '@components/home/FinalCta.astro';
import Box from '@components/home/Box.astro';
import Glyph from '@components/ui/Glyph.astro';
import { getCopy } from '@/copy';
import { localePath, type MarketingLocale } from '@utils/locale';

/**
 * About: who we are in one paragraph, our story as a timeline (wallet,
 * hidden charges, our own chain, the trilemma, microservices), the numbers,
 * the founder's vision, mission / vision / goal / moat, where blockchain does
 * what a database cannot, and short answers (also published as FAQPage data).
 * The team section is on hold until real profiles arrive (data in
 * src/data_files/team.ts).
 */
interface Props {
  locale: MarketingLocale;
}

const { locale } = Astro.props;
const t = getCopy(locale);
const copy = t.about;
const statIcons = ['trend-up', 'briefcase', 'piggy-bank', 'sparkle'];
const href = (url: string) => localePath(locale, url);
---

<MainLayout title={copy.title} seoTitle={copy.seoTitle} description={copy.metaDescription} kind={{ type: 'AboutPage' }} faqs={copy.faq.items}>
  <section class="mx-auto max-w-[85rem] px-4 pt-14 pb-14 sm:px-6 lg:px-8 lg:pt-20">
    <p class="font-mono text-xs tracking-wide text-muted uppercase" data-reveal>{copy.label}</p>
    <h1 class="mt-4 max-w-5xl text-[2.6rem] leading-[1] font-semibold text-ink sm:text-6xl lg:text-[3.6rem] xl:text-[4rem]">
      <span class="block">{copy.claim}</span>
      <span class="mark">{copy.payoff}</span>
    </h1>
    <p class="mt-7 max-w-[46rem] text-lg leading-relaxed text-pretty text-ink/80 sm:text-xl" data-reveal>{copy.lead}</p>
  </section>

  <section class="mx-auto max-w-[85rem] px-4 pb-20 sm:px-6 lg:px-8" aria-labelledby="story-title">
    <div class="glass-card grid grid-cols-1 gap-10 rounded-[2rem] p-6 sm:p-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16" data-story>
      <div class="lg:sticky lg:top-28 lg:self-start">
        <p class="flex items-center gap-4 font-mono text-xs tracking-wide text-muted uppercase">{copy.story.label}<span class="h-px flex-1 bg-line"></span></p>
        <h2 id="story-title" class="mt-5 text-3xl leading-tight font-semibold text-balance text-ink sm:text-4xl">{copy.story.title}</h2>
        <p class="mt-4 text-lg leading-relaxed text-pretty text-muted">{copy.story.intro}</p>
        {/* The stage: on large screens it follows the chapter you are reading. */}
        <div class="story-stage mt-10 hidden lg:block" aria-hidden="true">
          <p class="font-mono text-xs tracking-wide text-muted uppercase">Chapter <span class="text-ink" data-story-num>01</span> / {String(copy.story.steps.length).padStart(2, '0')}</p>
          <div class="relative mt-5 h-40">
            {copy.story.steps.map((step, index) => (
              <div class="story-chapter absolute inset-0" data-chapter={index} data-on={index === 0 ? '' : undefined}>
                <span class="grid size-14 place-items-center rounded-2xl bg-ink text-ground"><Glyph ui={step.icon} class="size-7" /></span>
                <p class="mt-5 text-4xl leading-tight font-semibold text-ink xl:text-5xl">{step.label}</p>
              </div>
            ))}
          </div>
          <div class="mt-6 flex gap-1.5">
            {copy.story.steps.map((_, index) => <span class="story-pip h-1 flex-1 rounded-full bg-line" data-pip={index}></span>)}
          </div>
        </div>
        <p class="mt-8 border-l-2 border-orange-500 pl-4 text-lg leading-relaxed text-pretty text-ink">{copy.story.belief}</p>
      </div>
      <ol class="story-steps relative grid gap-10 lg:gap-24 lg:py-10">
        {copy.story.steps.map((step, index) => (
          <li class="story-step relative grid grid-cols-[2.25rem_minmax(0,1fr)] gap-4" data-story-step={index}>
            <span class="story-dot relative z-[1] grid size-9 place-items-center rounded-full bg-ink font-mono text-xs font-semibold text-ground">{String(index + 1).padStart(2, '0')}</span>
            <div class="pt-1">
              <p class="font-mono text-xs tracking-wide text-muted uppercase">{step.label}</p>
              <h3 class="mt-1 text-xl font-semibold text-balance text-ink sm:text-2xl">{step.title}</h3>
              <p class="mt-2 text-lg leading-relaxed text-pretty text-muted">{step.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
    <dl class="mt-3 grid grid-cols-2 gap-3 lg:grid-cols-4" data-reveal-group>
      {copy.stats.map((stat, index) => (
        <div class="glass-card rounded-[1.6rem] p-4 sm:p-6" data-reveal-item>
          <Glyph icon={statIcons[index]} class="size-6 text-ink sm:size-7" />
          <dt class="sr-only">{stat.label}</dt>
          <dd class="mt-4 font-display text-3xl font-semibold text-ink tabular-nums sm:mt-6 sm:text-4xl">{stat.value}</dd>
          <dd class="mt-1 text-sm text-muted">{stat.label}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="mx-auto max-w-[85rem] px-4 pb-20 sm:px-6 lg:px-8" aria-labelledby="now-title">
    <SectionHead label={copy.now.label} claim={copy.now.claim} payoff={copy.now.payoff} body={copy.now.body} id="now-title" />
    <ul class="mt-12 grid grid-cols-1 gap-3 md:grid-cols-2 lg:grid-cols-3" data-reveal-group>
      {copy.now.items.map((item, index) => {
        const lead = index === 0;
        return (
          <li class:list={[lead && 'lg:row-span-2']} data-reveal-item>
            <a href={href(item.url)} class:list={['now-card group flex h-full flex-col rounded-[1.8rem] p-6 sm:p-7', lead ? 'on-sheet bg-sheet text-white' : 'glass-card']}>
              <span class:list={['grid place-items-center rounded-2xl transition duration-300', lead ? 'size-14 bg-white/10 text-white' : 'size-12 bg-card text-ink ring-1 ring-line group-hover:bg-ink group-hover:text-ground group-hover:ring-ink']}><Glyph ui={item.icon} class={lead ? 'size-7' : 'size-6'} /></span>
              <p class:list={['mt-6 font-mono text-xs font-semibold tracking-wide uppercase', lead ? 'text-orange-400' : 'text-violet-600 dark:text-orange-400']}>{item.tag}</p>
              <h3 class:list={['mt-2 font-semibold text-balance', lead ? 'text-3xl text-white sm:text-4xl' : 'text-xl text-ink']}>{item.title}</h3>
              <p class:list={['mt-3 leading-relaxed text-pretty', lead ? 'text-lg text-white/75' : 'text-muted']}>{item.text}</p>
              <span class:list={['mt-auto inline-flex items-center gap-1.5 pt-6 text-sm font-semibold', lead ? 'text-orange-300' : 'text-orange-700 dark:text-orange-300']}>Learn more<Glyph icon="arrow-right" class="size-4 transition group-hover:translate-x-1" /></span>
            </a>
          </li>
        );
      })}
    </ul>
  </section>

  <Box tone="dark"><VisionSection {...t.home.vision} cta={{ title: 'Talk to us', url: '/contact/' }} /></Box>

  <section class="mx-auto max-w-[85rem] px-4 py-20 sm:px-6 lg:px-8 lg:py-28" aria-labelledby="pillars-title">
    <SectionHead label={copy.pillars.label} claim={copy.pillars.claim} payoff={copy.pillars.payoff} id="pillars-title" />
    <ul class="mt-12 grid grid-cols-1 gap-3 md:grid-cols-2 xl:grid-cols-4" data-reveal-group>
      {copy.pillars.items.map(item => {
        const moat = item.label === 'Moat';
        return (
          <li class:list={['flex flex-col rounded-[1.8rem] p-6 sm:p-7', moat ? 'on-sheet bg-sheet text-white' : 'glass-card']} data-reveal-item>
            <p class:list={['font-mono text-xs font-semibold tracking-wide uppercase', moat ? 'text-orange-400' : 'text-violet-600 dark:text-orange-400']}>{item.label}</p>
            <h3 class:list={['mt-5 text-2xl leading-tight font-semibold text-balance', moat ? 'text-white' : 'text-ink']}>{item.title}</h3>
            <p class:list={['mt-3 leading-relaxed text-pretty', moat ? 'text-white/75' : 'text-muted']}>{item.text}</p>
          </li>
        );
      })}
    </ul>
  </section>

  <Box><section class="mx-auto max-w-[85rem] px-4 py-20 sm:px-6 lg:px-8 lg:py-28" aria-labelledby="beyond-title">
    <SectionHead label={copy.beyond.label} claim={copy.beyond.claim} payoff={copy.beyond.payoff} body={copy.beyond.body} id="beyond-title" />
    <ul class="mt-12 grid grid-cols-1 gap-3 md:grid-cols-2 lg:grid-cols-3" data-reveal-group>
      {copy.beyond.items.map(item => (
        <li data-reveal-item>
          <a href={href(item.url)} class="beyond-card glass-card group flex h-full flex-col rounded-[1.8rem] p-6 sm:p-7">
            <span class="grid size-12 place-items-center rounded-2xl bg-card text-ink ring-1 ring-line transition duration-300 group-hover:bg-ink group-hover:text-ground group-hover:ring-ink"><Glyph ui={item.icon} class="size-6" /></span>
            <h3 class="mt-6 text-xl font-semibold text-balance text-ink">{item.title}</h3>
            <p class="mt-2 leading-relaxed text-pretty text-muted">{item.text}</p>
            <span class="mt-auto inline-flex items-center gap-1.5 pt-5 text-sm font-semibold text-orange-700 dark:text-orange-300">Learn more<Glyph icon="arrow-right" class="size-4 transition group-hover:translate-x-1" /></span>
          </a>
        </li>
      ))}
    </ul>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between" data-reveal>
      <p class="text-lg text-ink">{copy.beyond.note}</p>
      <a href={href(copy.beyond.more.url)} class="inline-flex items-center gap-2 font-semibold text-orange-700 underline-offset-4 hover:underline dark:text-orange-300">{copy.beyond.more.title}<Glyph icon="arrow-right" class="size-4" /></a>
    </div>
  </section></Box>

  <section class="mx-auto grid max-w-[85rem] grid-cols-1 gap-10 px-4 py-20 sm:px-6 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16 lg:px-8 lg:py-28" aria-labelledby="about-faq-title">
    <div>
      <p class="font-mono text-xs tracking-wide text-muted uppercase">{copy.faq.label}</p>
      <h2 id="about-faq-title" class="mt-4 text-4xl leading-[1.02] font-semibold text-ink sm:text-5xl"><span class="block">{copy.faq.claim}</span><span class="mark">{copy.faq.payoff}</span></h2>
    </div>
    <div class="divide-y divide-line border-y border-line">
      {copy.faq.items.map((item, index) => (
        <details class="group py-5" open={index === 0}>
          <summary class="flex cursor-pointer list-none items-start justify-between gap-6 text-lg font-semibold text-ink [&::-webkit-details-marker]:hidden">
            <span>{item.question}</span>
            <span class="mt-0.5 grid size-8 shrink-0 place-items-center rounded-full bg-card ring-1 ring-line transition duration-300 group-open:rotate-45"><Glyph icon="plus" class="size-4 text-ink" /></span>
          </summary>
          <p class="mt-3 max-w-[60ch] leading-relaxed text-pretty text-muted">{item.answer}</p>
        </details>
      ))}
    </div>
  </section>

  <FinalCta {...t.home.finalCta} />
</MainLayout>

<script>
  // As each chapter crosses the middle of the screen, the left stage shows
  // its number, icon and name, and the other chapters dim a little.
  document.querySelectorAll<HTMLElement>('[data-story]').forEach(story => {
    const steps = [...story.querySelectorAll<HTMLElement>('[data-story-step]')];
    const chapters = [...story.querySelectorAll<HTMLElement>('[data-chapter]')];
    const pips = [...story.querySelectorAll<HTMLElement>('[data-pip]')];
    const num = story.querySelector<HTMLElement>('[data-story-num]');
    let current = -1;
    const show = (index: number) => {
      if (index === current) return;
      current = index;
      chapters.forEach((el, i) => el.toggleAttribute('data-on', i === index));
      pips.forEach((el, i) => el.toggleAttribute('data-on', i <= index));
      steps.forEach((el, i) => el.toggleAttribute('data-on', i === index));
      if (num) num.textContent = String(index + 1).padStart(2, '0');
    };
    story.classList.add('story-live');
    show(0);
    const observer = new IntersectionObserver(entries => {
      for (const entry of entries) if (entry.isIntersecting) show(steps.indexOf(entry.target as HTMLElement));
    }, { rootMargin: '-45% 0px -45% 0px' });
    steps.forEach(step => observer.observe(step));
  });
</script>

<style>
  /* The stage: chapters cross-fade and rise into place. */
  .story-chapter { opacity: 0; transform: translateY(14px); transition: opacity 450ms ease, transform 600ms cubic-bezier(0.22, 1, 0.36, 1); }
  .story-chapter[data-on] { opacity: 1; transform: none; }
  .story-pip { transition: background-color 400ms ease; }
  .story-pip[data-on] { background: var(--accent-500); }
  /* Chapters you are not reading step back (large screens, with the script). */
  @media (min-width: 1024px) {
    .story-live .story-step { opacity: 0.35; transition: opacity 400ms ease; }
    .story-live .story-step[data-on] { opacity: 1; }
    .story-live .story-step[data-on] .story-dot { background: var(--accent-600); color: #fff; }
  }
  :global(.dark) .story-live .story-step[data-on] .story-dot { background: var(--accent-500); }
  @media (prefers-reduced-motion: reduce) {
    .story-chapter, .story-pip, .story-live .story-step { transition: none; }
  }
  /* The timeline rail behind the numbered dots. */
  .story-steps::before {
    content: '';
    position: absolute;
    left: calc(1.125rem - 1px);
    top: 0.5rem;
    bottom: 0.5rem;
    width: 2px;
    background: var(--line);
  }
  .now-card { transition: transform 300ms cubic-bezier(0.22, 1, 0.36, 1); }
  .now-card:hover { transform: translateY(-3px); }
  .now-card:focus-visible { outline: 3px solid var(--accent-500); outline-offset: 2px; }
  .beyond-card { transition: transform 300ms cubic-bezier(0.22, 1, 0.36, 1); }
  .beyond-card:hover { transform: translateY(-3px); }
  .beyond-card:focus-visible { outline: 3px solid var(--accent-500); outline-offset: 2px; }
  @media (prefers-reduced-motion: reduce) { .beyond-card { transition: none; } .beyond-card:hover { transform: none; } }
</style>
