---
import MainLayout from '@/layouts/MainLayout.astro';
import CardBlog from '@components/ui/cards/CardBlog.astro';
import CardBlogRecent from '@components/ui/cards/CardBlogRecent.astro';
import { entriesFor } from '@utils/content';
import { getCopy } from '@/copy';
import type { MarketingLocale } from '@utils/locale';

/**
 * Blog index in the original layout: a centred header, the newest post as a
 * large card, then every other post as cover cards in two columns.
 */
interface Props {
  locale: MarketingLocale;
}

const { locale } = Astro.props;
const copy = getCopy(locale).blogIndex;
const [mostRecentPost, ...otherPosts] = await entriesFor('blog', locale);
---

<MainLayout title={copy.title} seoTitle={copy.seoTitle} description={copy.metaDescription} ogImage="/og/blog.png" kind={{ type: 'CollectionPage' }}>
  <section class="mx-auto max-w-[85rem] px-4 pt-14 sm:px-6 lg:px-8 lg:pt-20">
    <div class="mx-auto max-w-3xl text-left sm:text-center">
      <p class="font-mono text-xs tracking-wide text-muted uppercase" data-reveal>Blog</p>
      <h1 class="mt-3 text-5xl leading-[1] font-semibold text-balance text-ink sm:text-6xl">{copy.heading}</h1>
      <p class="mt-5 text-lg text-pretty text-muted" data-reveal>{copy.subTitle}</p>
    </div>
  </section>

  {mostRecentPost ? (
    <>
      <section class="mx-auto max-w-[85rem] px-4 pt-12 sm:px-6 lg:px-8">
        <CardBlogRecent blogEntry={mostRecentPost} />
      </section>
      <section class="mx-auto max-w-[85rem] px-4 py-12 sm:px-6 lg:px-8 lg:pb-20">
        <div class="grid gap-5 lg:grid-cols-2">
          {otherPosts.map(blogEntry => <CardBlog blogEntry={blogEntry} />)}
        </div>
      </section>
    </>
  ) : (
    <p class="px-4 py-20 text-center text-muted">{copy.noPosts}</p>
  )}
</MainLayout>
